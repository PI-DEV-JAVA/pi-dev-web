{% extends 'front/_base.html.twig' %}

{% block title %}Formations — Talentos{% endblock %}

{% block content %}
<div class="fo-page-header">
    <div class="container">
        <h1>Formations 📚</h1>
        <p>Développez vos compétences avec nos cours</p>
    </div>
</div>

<section class="fo-section" style="padding-top:40px">
    <div class="container">
        {% if formations is empty %}
            <div class="fo-card text-center" style="padding:60px">
                <i class="bi bi-book" style="font-size:3rem;color:var(--fo-text-secondary)"></i>
                <p class="mt-3" style="color:var(--fo-text-secondary)">Aucune formation disponible.</p>
            </div>
        {% else %}
            <div class="row g-4">
                {% for f in formations %}
                    <div class="col-md-6 col-lg-4">
                        <a href="{{ path('app_course_detail', {id: f.id}) }}" class="text-decoration-none">
                            <div class="fo-card h-100" style="cursor:pointer">
                                <div style="width:100%;height:140px;border-radius:12px;margin-bottom:16px;background:linear-gradient(135deg,#eef2ff,#fef3c7);display:flex;align-items:center;justify-content:center">
                                    <i class="bi bi-book" style="font-size:2.5rem;color:var(--primary);opacity:0.6"></i>
                                </div>
                                <h5 style="font-weight:700;color:var(--fo-text);margin-bottom:8px">{{ f.titre }}</h5>
                                <div style="font-size:0.85rem;color:var(--fo-text-secondary)">
                                    <span class="me-3"><i class="bi bi-clock me-1"></i>{{ f.duree }}h</span>
                                    <span><i class="bi bi-bar-chart me-1"></i>{{ f.niveau ?: 'Tous niveaux' }}</span>
                                </div>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
