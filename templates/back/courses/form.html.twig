    <div class="modal-content" style="background:var(--bo-bg-card);border:1px solid var(--bo-border);border-radius:16px">
      <div class="modal-header" style="border-color:var(--bo-border);padding:20px 24px">
        <h5 class="modal-title" style="font-weight:700;font-size:1rem"><i class="bi bi-pencil-square me-2" style="color:var(--primary-light)"></i>Modifier le quiz</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form id="editQuizForm" method="post" action="">
        <div class="modal-body" style="padding:24px">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label" style="font-size:0.85rem;font-weight:600">Titre <span style="color:red">*</span></label>
              <input type="text" name="titre" id="eqTitre" class="form-control" required>
            </div>
            <div class="col-12">
              <label class="form-label" style="font-size:0.85rem;font-weight:600">Description</label>
              <textarea name="description" id="eqDesc" class="form-control" rows="2" style="resize:vertical"></textarea>
            </div>
            <div class="col-md-6">
              <label class="form-label" style="font-size:0.85rem;font-weight:600">Durée (minutes)</label>
              <input type="number" name="duree" id="eqDuree" class="form-control" min="1">
            </div>
            <div class="col-md-6">
              <label class="form-label" style="font-size:0.85rem;font-weight:600">Séance associée</label>
              <select name="seance_id" id="eqSeance" class="form-select">
                <option value="">— Aucune —</option>
                {% if seances is defined %}
                  {% for s in seances %}
                    <option value="{{ s.id }}">{{ s.titre }} ({{ s.dateDebut|date('d/m') }})</option>
                  {% endfor %}
                {% endif %}
              </select>
            </div>
          </div>
        </div>
        <div class="modal-footer" style="border-color:var(--bo-border);padding:16px 24px">
          <button type="button" class="bo-btn" data-bs-dismiss="modal">Annuler</button>
          <button type="submit" class="bo-btn bo-btn-primary"><i class="bi bi-check2 me-1"></i>Enregistrer</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
const fid = {{ formation.id }};

function openSeanceEdit(sid, titre, desc, type, debut, fin, adresse, video, duree) {
    document.getElementById('editSeanceForm').action = '/admin/courses/' + fid + '/seance/' + sid + '/edit';
    document.getElementById('eseTitre').value   = titre;
    document.getElementById('eseDesc').value    = desc;
    document.getElementById('eseType').value    = type;
    document.getElementById('eseDebut').value   = debut;
    document.getElementById('eseFin').value     = fin;
    document.getElementById('eseAdresse').value = adresse;
    document.getElementById('eseVideo').value   = video;
    document.getElementById('eseDuree').value   = duree || '';
    new bootstrap.Modal(document.getElementById('editSeanceModal')).show();
}

function openQuizEdit(qid, titre, desc, duree, seanceId) {
    document.getElementById('editQuizForm').action = '/admin/courses/' + fid + '/quiz/' + qid + '/edit';
    document.getElementById('eqTitre').value  = titre;
    document.getElementById('eqDesc').value   = desc;
    document.getElementById('eqDuree').value  = duree || '';
    const sel = document.getElementById('eqSeance');
    sel.value = seanceId ? String(seanceId) : '';
    new bootstrap.Modal(document.getElementById('editQuizModal')).show();
}
</script>
{% endif %}
{% endblock %}
