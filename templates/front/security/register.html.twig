{% extends 'base.html.twig' %}

{% block title %}Inscription — Talentos{% endblock %}

{% block base_stylesheets %}
<style>
    body { background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 50%, #f0f9ff 100%); min-height: 100vh; }
    .register-wrapper {
        min-height: 100vh; display: flex; align-items: center; justify-content: center;
        padding: 40px 20px; position: relative; overflow: hidden;
    }
    .register-wrapper::before {
        content: ''; position: absolute; width: 500px; height: 500px;
        background: radial-gradient(circle, rgba(79,70,229,0.06) 0%, transparent 70%);
        top: -150px; right: -100px; border-radius: 50%;
    }
    .register-card {
        background: white; border: 1px solid #e2e8f0; border-radius: 20px;
        padding: 48px; width: 100%; max-width: 480px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.06); position: relative; z-index: 1;
    }
    .register-logo { text-align: center; margin-bottom: 32px; }
    .register-logo h1 {
        font-size: 2rem; font-weight: 800;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    .register-logo p { color: #64748b; font-size: 0.9rem; margin-top: 4px; }
    .register-card .form-control, .register-card .form-select {
        border: 1.5px solid #e2e8f0; border-radius: 12px;
        padding: 14px 16px; font-size: 0.95rem; transition: all 0.2s;
    }
    .register-card .form-control:focus, .register-card .form-select:focus {
        border-color: var(--primary); box-shadow: 0 0 0 3px rgba(79,70,229,0.1);
    }
    .register-card label { color: #64748b; font-size: 0.85rem; font-weight: 500; margin-bottom: 6px; }

    /* Validation styles */
    .field-valid { border-color: #10b981 !important; }
    .field-valid:focus { box-shadow: 0 0 0 3px rgba(16,185,129,0.1) !important; }
    .field-invalid { border-color: #ef4444 !important; }
    .field-invalid:focus { box-shadow: 0 0 0 3px rgba(239,68,68,0.1) !important; }
    .field-msg { font-size: 0.78rem; margin-top: 4px; display: flex; align-items: center; gap: 4px; transition: all 0.2s; }
    .field-msg.error { color: #ef4444; }
    .field-msg.success { color: #10b981; }
    .required-star { color: #ef4444; font-weight: 700; }

    /* Password strength */
    .pw-strength { margin-top: 8px; }
    .pw-bar { height: 4px; border-radius: 4px; background: #e2e8f0; overflow: hidden; margin-bottom: 6px; }
    .pw-bar-fill { height: 100%; border-radius: 4px; transition: width 0.3s, background 0.3s; width: 0; }
    .pw-label { font-size: 0.78rem; font-weight: 600; transition: color 0.3s; }
    .pw-rules { margin-top: 6px; }
    .pw-rule { font-size: 0.75rem; display: flex; align-items: center; gap: 5px; line-height: 1.7; transition: color 0.2s; }
    .pw-rule.pass { color: #10b981; }
    .pw-rule.fail { color: #94a3b8; }
</style>
{% endblock %}

{% block body %}
<div class="register-wrapper">
    <div class="register-card">
        <div class="register-logo">
            <h1><i class="bi bi-briefcase-fill"></i> Talentos</h1>
            <p>Créez votre compte</p>
        </div>

        {% if error %}
            <div class="alert alert-danger" style="background:rgba(239,68,68,0.08);color:#dc2626;border:1px solid rgba(239,68,68,0.2);border-radius:12px;padding:12px;font-size:0.85rem">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>{{ error }}
            </div>
        {% endif %}

        <form method="post" id="registerForm" novalidate>
            {# Email #}
            <div class="mb-3">
                <label for="email"><i class="bi bi-envelope me-1"></i> Email <span class="required-star">*</span></label>
                <input type="email" class="form-control" id="regEmail" name="email" placeholder="votre@email.com" required>
                <div class="field-msg" id="emailMsg"></div>
            </div>

            {# Password + Confirm #}
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label for="regPassword"><i class="bi bi-lock me-1"></i> Mot de passe <span class="required-star">*</span></label>
                    <input type="password" class="form-control" id="regPassword" name="password" placeholder="••••••" required>
                </div>
                <div class="col-6">
                    <label for="regConfirm">Confirmer <span class="required-star">*</span></label>
                    <input type="password" class="form-control" id="regConfirm" name="confirm_password" placeholder="••••••" required>
                    <div class="field-msg" id="confirmMsg"></div>
                </div>
            </div>

            {# Password strength meter #}
            <div class="pw-strength" id="pwStrength" style="display:none">
                <div class="pw-bar"><div class="pw-bar-fill" id="pwBarFill"></div></div>
                <div class="pw-label" id="pwLabel"></div>
                <div class="pw-rules">
                    <div class="pw-rule fail" id="rule-len"><i class="bi bi-x-circle-fill"></i> Au moins 6 caractères</div>
                    <div class="pw-rule fail" id="rule-num"><i class="bi bi-x-circle-fill"></i> Au moins 1 chiffre</div>
                    <div class="pw-rule fail" id="rule-letter"><i class="bi bi-x-circle-fill"></i> Au moins 1 lettre</div>
                    <div class="pw-rule fail" id="rule-upper"><i class="bi bi-x-circle-fill"></i> Au moins 1 majuscule</div>
                </div>
            </div>

            {# Role #}
            <div class="mb-3" style="margin-top:16px">
                <label for="role"><i class="bi bi-person-badge me-1"></i> Rôle <span class="required-star">*</span></label>
                <select name="role" class="form-select" id="role">
                    <option value="CANDIDATE">Candidat</option>
                    <option value="HR">Recruteur</option>
                </select>
            </div>

            {# reCAPTCHA #}
            <div class="mb-3" style="display:flex;justify-content:center">
                <div class="g-recaptcha" data-sitekey="{{ recaptcha_site_key }}" data-theme="light"></div>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100" id="regSubmit" disabled style="opacity:0.5;transition:opacity 0.3s">
                <i class="bi bi-person-plus me-2"></i>Créer mon compte
            </button>
        </form>

        <script src="https://www.google.com/recaptcha/api.js" async defer></script>

        <div style="display:flex;align-items:center;gap:12px;margin:20px 0">
            <div style="flex:1;height:1px;background:#e2e8f0"></div>
            <span style="color:#94a3b8;font-size:0.8rem;font-weight:500">ou</span>
            <div style="flex:1;height:1px;background:#e2e8f0"></div>
        </div>

        <a href="{{ path('app_connect_google') }}" class="btn w-100" style="border:1.5px solid #e2e8f0;border-radius:12px;padding:12px;display:flex;align-items:center;justify-content:center;gap:10px;font-weight:600;font-size:0.9rem;color:#334155;text-decoration:none;transition:all 0.2s;background:white"
           onmouseover="this.style.borderColor='#4285f4';this.style.boxShadow='0 2px 8px rgba(66,133,244,0.15)'" onmouseout="this.style.borderColor='#e2e8f0';this.style.boxShadow='none'">
            <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#4285F4" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#34A853" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#EA4335" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
            S'inscrire avec Google
        </a>

        <div style="text-align:center;margin-top:20px;color:#64748b;font-size:0.9rem">
            Déjà un compte ? <a href="{{ path('app_login') }}" style="color:var(--primary);text-decoration:none;font-weight:600">Se connecter</a>
        </div>
    </div>
</div>

<script>
(function() {
    const email = document.getElementById('regEmail');
    const pw = document.getElementById('regPassword');
    const confirm = document.getElementById('regConfirm');
    const emailMsg = document.getElementById('emailMsg');
    const confirmMsg = document.getElementById('confirmMsg');
    const submitBtn = document.getElementById('regSubmit');
    const pwStrength = document.getElementById('pwStrength');
    const pwBarFill = document.getElementById('pwBarFill');
    const pwLabel = document.getElementById('pwLabel');

    const rules = {
        len: document.getElementById('rule-len'),
        num: document.getElementById('rule-num'),
        letter: document.getElementById('rule-letter'),
        upper: document.getElementById('rule-upper')
    };

    function setFieldState(input, valid) {
        input.classList.remove('field-valid', 'field-invalid');
        if (input.value.length > 0) {
            input.classList.add(valid ? 'field-valid' : 'field-invalid');
        }
    }

    function setMsg(el, text, type) {
        el.className = 'field-msg ' + type;
        el.innerHTML = type === 'error'
            ? '<i class="bi bi-x-circle-fill"></i> ' + text
            : '<i class="bi bi-check-circle-fill"></i> ' + text;
    }

    function clearMsg(el) { el.className = 'field-msg'; el.innerHTML = ''; }

    function setRule(el, pass) {
        el.className = 'pw-rule ' + (pass ? 'pass' : 'fail');
        el.querySelector('i').className = pass ? 'bi bi-check-circle-fill' : 'bi bi-x-circle-fill';
    }

    // Email validation
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    let emailValid = false;

    email.addEventListener('input', function() {
        if (this.value.length === 0) {
            setFieldState(this, false); clearMsg(emailMsg); emailValid = false;
        } else if (!emailRegex.test(this.value)) {
            setFieldState(this, false); setMsg(emailMsg, 'Format email invalide', 'error'); emailValid = false;
        } else {
            setFieldState(this, true); setMsg(emailMsg, 'Email valide', 'success'); emailValid = true;
        }
        checkForm();
    });

    // Password strength
    let pwValid = false;
    pw.addEventListener('input', function() {
        const v = this.value;
        pwStrength.style.display = v.length > 0 ? 'block' : 'none';

        const hasLen = v.length >= 6;
        const hasNum = /\d/.test(v);
        const hasLetter = /[a-zA-Z]/.test(v);
        const hasUpper = /[A-Z]/.test(v);

        setRule(rules.len, hasLen);
        setRule(rules.num, hasNum);
        setRule(rules.letter, hasLetter);
        setRule(rules.upper, hasUpper);

        const score = [hasLen, hasNum, hasLetter, hasUpper].filter(Boolean).length;
        pwValid = score === 4;

        if (score <= 1) {
            pwBarFill.style.width = '25%'; pwBarFill.style.background = '#ef4444';
            pwLabel.textContent = 'Faible'; pwLabel.style.color = '#ef4444';
        } else if (score <= 3) {
            pwBarFill.style.width = '60%'; pwBarFill.style.background = '#f59e0b';
            pwLabel.textContent = 'Moyen'; pwLabel.style.color = '#f59e0b';
        } else {
            pwBarFill.style.width = '100%'; pwBarFill.style.background = '#10b981';
            pwLabel.textContent = 'Fort'; pwLabel.style.color = '#10b981';
        }

        setFieldState(this, pwValid);
        validateConfirm();
        checkForm();
    });

    // Confirm password
    let confirmValid = false;
    function validateConfirm() {
        if (confirm.value.length === 0) {
            setFieldState(confirm, false); clearMsg(confirmMsg); confirmValid = false;
        } else if (confirm.value !== pw.value) {
            setFieldState(confirm, false); setMsg(confirmMsg, 'Les mots de passe ne correspondent pas', 'error'); confirmValid = false;
        } else {
            setFieldState(confirm, true); setMsg(confirmMsg, 'Correspond', 'success'); confirmValid = true;
        }
        checkForm();
    }
    confirm.addEventListener('input', validateConfirm);

    // Enable submit only when all valid
    function checkForm() {
        const allValid = emailValid && pwValid && confirmValid;
        submitBtn.disabled = !allValid;
        submitBtn.style.opacity = allValid ? '1' : '0.5';
    }
})();
</script>
{% endblock %}
