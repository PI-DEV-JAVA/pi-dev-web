{% extends 'back/_base.html.twig' %}
{% block page_title %}Mon Profil{% endblock %}

{% block content %}
<div class="row g-4">
    {# Left: Profile Card #}
    <div class="col-lg-4">
        <div class="bo-card" style="text-align:center;padding:32px 24px">
            <div style="width:90px;height:90px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--accent));display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:2.2rem;font-weight:800;color:white;box-shadow:0 4px 16px rgba(79,70,229,0.3)">
                {{ app.user.email|first|upper }}
            </div>
            <h5 style="font-weight:700;margin-bottom:4px">
                {% if profile.firstName or profile.lastName %}
                    {{ profile.firstName }} {{ profile.lastName }}
                {% else %}
                    {{ app.user.email|split('@')[0] }}
                {% endif %}
            </h5>
            {% if profile.professionalTitle %}
                <div style="color:var(--primary-light);font-size:0.85rem;font-weight:500;margin-bottom:8px">{{ profile.professionalTitle }}</div>
            {% endif %}
            <div style="font-size:0.8rem;color:var(--bo-text-secondary);margin-bottom:16px">{{ app.user.email }}</div>

            <div style="display:flex;justify-content:center;gap:16px;padding-top:16px;border-top:1px solid var(--bo-border)">
                <div style="text-align:center">
                    <div style="font-weight:800;font-size:1.1rem;color:var(--primary-light)">
                        <span style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:10px;background:rgba(79,70,229,0.1)">
                            <i class="bi bi-shield-check" style="font-size:0.9rem"></i>
                        </span>
                    </div>
                    <div style="font-size:0.7rem;color:var(--bo-text-secondary);margin-top:4px">{{ app.user.role }}</div>
                </div>
                <div style="text-align:center">
                    <div style="font-weight:800;font-size:1.1rem;color:var(--accent)">
                        <span style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:10px;background:rgba(16,185,129,0.1)">
                            <i class="bi bi-calendar-check" style="font-size:0.9rem"></i>
                        </span>
                    </div>
                    <div style="font-size:0.7rem;color:var(--bo-text-secondary);margin-top:4px">Depuis {{ app.user.createdAt|date('m/Y') }}</div>
                </div>
            </div>

            {% if profile.location %}
            <div style="margin-top:16px;padding-top:16px;border-top:1px solid var(--bo-border);font-size:0.82rem;color:var(--bo-text-secondary)">
                <i class="bi bi-geo-alt me-1"></i> {{ profile.location }}
            </div>
            {% endif %}
        </div>

        {# Account Info Card #}
        <div class="bo-card" style="margin-top:16px">
            <h6 style="font-weight:700;margin-bottom:16px"><i class="bi bi-shield-lock me-2" style="color:var(--primary-light)"></i>Compte</h6>
            <div style="font-size:0.82rem;margin-bottom:10px">
                <span style="color:var(--bo-text-secondary)">Email :</span>
                <span style="float:right;font-weight:600">{{ app.user.email }}</span>
            </div>
            <div style="font-size:0.82rem;margin-bottom:10px">
                <span style="color:var(--bo-text-secondary)">Rôle :</span>
                <span style="float:right"><span class="bo-badge bo-badge-primary">{{ app.user.role }}</span></span>
            </div>
            <div style="font-size:0.82rem;margin-bottom:10px">
                <span style="color:var(--bo-text-secondary)">Vérification :</span>
                <span style="float:right">
                    {% if app.user.emailVerified %}
                        <span style="color:#10b981"><i class="bi bi-check-circle-fill me-1"></i>Vérifié</span>
                    {% else %}
                        <span style="color:#f59e0b"><i class="bi bi-exclamation-circle-fill me-1"></i>Non vérifié</span>
                    {% endif %}
                </span>
            </div>
            <div style="font-size:0.82rem">
                <span style="color:var(--bo-text-secondary)">Fournisseur :</span>
                <span style="float:right;font-weight:600">{{ app.user.authProvider }}</span>
            </div>
        </div>
    </div>

    {# Right: Edit Form #}
    <div class="col-lg-8">
        <div class="bo-card">
            <h5 style="font-weight:700;margin-bottom:24px"><i class="bi bi-pencil-square me-2" style="color:var(--accent)"></i>Modifier le profil</h5>
            <form method="post" class="bo-form">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label>Prénom</label>
                        <input type="text" name="firstName" class="form-control" value="{{ profile.firstName }}" placeholder="Votre prénom">
                    </div>
                    <div class="col-md-6">
                        <label>Nom</label>
                        <input type="text" name="lastName" class="form-control" value="{{ profile.lastName }}" placeholder="Votre nom">
                    </div>
                    <div class="col-md-6">
                        <label>Titre professionnel</label>
                        <input type="text" name="professionalTitle" class="form-control" value="{{ profile.professionalTitle }}" placeholder="Ex: Responsable RH">
                    </div>
                    <div class="col-md-6">
                        <label>Téléphone</label>
                        <input type="text" name="phoneNumber" class="form-control" value="{{ profile.phoneNumber }}" placeholder="+216 XX XXX XXX">
                    </div>
                    <div class="col-md-6">
                        <label>Localisation</label>
                        <input type="text" name="location" class="form-control" value="{{ profile.location }}" placeholder="Tunis, Tunisie">
                    </div>
                    <div class="col-md-6">
                        <label>Années d'expérience</label>
                        <input type="number" name="yearsOfExperience" class="form-control" value="{{ profile.yearsOfExperience }}" placeholder="5" min="0">
                    </div>
                    <div class="col-12">
                        <label>Bio / Résumé</label>
                        <textarea name="summary" class="form-control" rows="4" placeholder="Parlez-nous de vous...">{{ profile.summary }}</textarea>
                    </div>
                </div>
                <div class="mt-4">
                    <button type="submit" class="bo-btn bo-btn-primary"><i class="bi bi-check-lg me-1"></i> Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
