{% extends 'base.html.twig' %}
{% from 'components/_sidebar.html.twig' import sidebar %}

{% block title %}{{ quiz.titre }} — Quiz{% endblock %}

{% block body %}
{{ sidebar(app.user) }}

<main class="app-main">
    <div class="mb-3">
        <a href="{{ path('app_course_detail', {id: quiz.formation.id}) }}" style="color:var(--primary-light);text-decoration:none;font-size:0.9rem">
            <i class="bi bi-arrow-left me-1"></i> Retour à la formation
        </a>
    </div>

    <div class="stat-card" style="max-width:750px;margin:0 auto">
        <div class="text-center mb-4">
            <h3 style="font-weight:700">{{ quiz.titre }}</h3>
            <p style="color:var(--text-secondary)">{{ questions|length }} question{{ questions|length > 1 ? 's' }}</p>
        </div>

        <form method="post" action="{{ path('app_quiz_submit', {id: quiz.id}) }}">
            {% for question in questions %}
                <div class="p-4 mb-3" style="background:var(--bg-input);border-radius:12px">
                    <h6 style="font-weight:600;margin-bottom:12px">
                        <span style="color:var(--primary-light);margin-right:8px">Q{{ loop.index }}.</span>
                        {{ question.texte }}
                    </h6>
                    <div class="d-flex flex-column gap-2">
                        {% for choix in question.loadedChoices %}
                            <label class="d-flex align-items-center gap-2 p-2 rounded-3" style="cursor:pointer;transition:background 0.2s"
                                   onmouseover="this.style.background='rgba(79,70,229,0.1)'" onmouseout="this.style.background='transparent'">
                                <input type="radio" name="q_{{ question.id }}" value="{{ choix.id }}" required
                                       class="form-check-input" style="margin:0">
                                <span style="font-size:0.9rem">{{ choix.texte }}</span>
                            </label>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}

            <div class="text-center mt-4">
                <button type="submit" class="btn btn-primary-custom" style="width:auto;padding:14px 40px">
                    <i class="bi bi-send me-2"></i>Soumettre
                </button>
            </div>
        </form>
    </div>
</main>
{% endblock %}
