{% extends 'front/_base.html.twig' %}
{% block title %}Mon Profil — Talentos{% endblock %}
{% block content %}
<div class="fo-page-header">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h1>Mon Profil</h1>
                <p>Consultez et gérez vos informations</p>
            </div>
            <div class="d-flex gap-2">
                <button type="button" onclick="document.getElementById('resetModal').style.display='flex'" class="btn" style="width:auto;padding:10px 24px;border-radius:12px;font-weight:600;font-size:0.85rem;border:1.5px solid rgba(239,68,68,0.3);color:#ef4444;background:rgba(239,68,68,0.05);transition:all 0.2s" onmouseover="this.style.background='rgba(239,68,68,0.1)'" onmouseout="this.style.background='rgba(239,68,68,0.05)'">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Réinitialiser
                </button>
                <a href="{{ path('app_profile_edit') }}" class="btn btn-primary-custom" style="width:auto;padding:10px 24px">
                    <i class="bi bi-pencil-square me-1"></i> Modifier
                </a>
            </div>
        </div>
    </div>
</div>
<section class="fo-section" style="padding-top:40px">
    <div class="container">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>{{ message }}</div>
        {% endfor %}
        <div class="row g-4">
            <div class="col-md-4">
                <div class="fo-card text-center" style="padding:32px">
                    {% if profile.profilePicturePath %}
                        <img src="{{ profile.profilePicturePath }}" alt="Avatar" style="width:120px;height:120px;border-radius:50%;object-fit:cover;margin-bottom:16px;border:3px solid var(--primary)">
                    {% else %}
                        <div style="width:120px;height:120px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--accent));display:flex;align-items:center;justify-content:center;font-size:3rem;font-weight:700;margin:0 auto 16px;color:white">
                            {{ profile.firstName|default(user.email)|first|upper }}
                        </div>
                    {% endif %}
                    <h4 style="font-weight:700;margin-bottom:4px">{{ profile.fullName ?: 'Non renseigné' }}</h4>
                    <p style="color:var(--primary);font-size:0.9rem;margin-bottom:4px">{{ profile.professionalTitle ?: '—' }}</p>
                    <p style="color:var(--fo-text-secondary);font-size:0.85rem"><i class="bi bi-geo-alt me-1"></i>{{ profile.location ?: 'Non renseigné' }}</p>
                    {% if profile.cvPath %}
                        <a href="{{ profile.cvPath }}" target="_blank" class="btn" style="border:1.5px solid var(--fo-border);border-radius:10px;padding:8px 16px;font-weight:600;font-size:0.85rem;margin-top:8px">
                            <i class="bi bi-file-earmark-pdf me-1"></i> Télécharger CV
                        </a>
                    {% endif %}
                </div>
            </div>
            <div class="col-md-8">
                <div class="fo-card" style="margin-bottom:16px">
                    <h5 style="font-weight:700;margin-bottom:16px"><i class="bi bi-person-vcard me-2" style="color:var(--primary)"></i>Informations personnelles</h5>
                    <div class="row g-3">
                        <div class="col-6">
                            <div style="color:var(--fo-text-secondary);font-size:0.8rem;text-transform:uppercase;margin-bottom:4px">Email</div>
                            <div style="font-weight:500">{{ user.email }}</div>
                        </div>
                        <div class="col-6">
                            <div style="color:var(--fo-text-secondary);font-size:0.8rem;text-transform:uppercase;margin-bottom:4px">Téléphone</div>
                            <div style="font-weight:500">{{ profile.phoneNumber ?: '—' }}</div>
                        </div>
                        <div class="col-6">
                            <div style="color:var(--fo-text-secondary);font-size:0.8rem;text-transform:uppercase;margin-bottom:4px">Date de naissance</div>
                            <div style="font-weight:500">{{ profile.birthDate ? profile.birthDate|date('d/m/Y') : '—' }}</div>
                        </div>
                        <div class="col-6">
                            <div style="color:var(--fo-text-secondary);font-size:0.8rem;text-transform:uppercase;margin-bottom:4px">Rôle</div>
                            <span class="fo-badge fo-badge-primary">{{ user.role }}</span>
                        </div>
                    </div>
                </div>
                <div class="fo-card" style="margin-bottom:16px">
                    <h5 style="font-weight:700;margin-bottom:16px"><i class="bi bi-briefcase me-2" style="color:var(--accent)"></i>Profil professionnel</h5>
                    <div class="row g-3">
                        <div class="col-6">
                            <div style="color:var(--fo-text-secondary);font-size:0.8rem;text-transform:uppercase;margin-bottom:4px">Expérience</div>
                            <div style="font-weight:500">{{ profile.yearsOfExperience is not null ? profile.yearsOfExperience ~ ' ans' : '—' }}</div>
                        </div>
                        <div class="col-6">
                            <div style="color:var(--fo-text-secondary);font-size:0.8rem;text-transform:uppercase;margin-bottom:4px">Membre depuis</div>
                            <div style="font-weight:500">{{ user.createdAt|date('d/m/Y') }}</div>
                        </div>
                    </div>
                </div>
                {% if profile.summary %}
                <div class="fo-card">
                    <h5 style="font-weight:700;margin-bottom:12px"><i class="bi bi-chat-quote me-2" style="color:var(--success)"></i>À propos</h5>
                    <p style="color:var(--fo-text-secondary);line-height:1.7">{{ profile.summary }}</p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>

{# Reset profile confirmation modal #}
<div id="resetModal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;z-index:9999;background:rgba(0,0,0,0.4);backdrop-filter:blur(4px);align-items:center;justify-content:center">
    <div style="background:white;border-radius:20px;padding:36px;max-width:420px;width:90%;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,0.15)">
        <div style="width:56px;height:56px;border-radius:14px;background:rgba(245,158,11,0.1);display:inline-flex;align-items:center;justify-content:center;margin-bottom:16px">
            <i class="bi bi-arrow-counterclockwise" style="font-size:1.5rem;color:#f59e0b"></i>
        </div>
        <h5 style="font-weight:700;margin-bottom:8px">Réinitialiser le profil ?</h5>
        <p style="color:#64748b;font-size:0.88rem;margin-bottom:20px">
            Toutes vos informations seront effacées sauf votre <strong style="color:var(--primary)">nom complet</strong>.
        </p>
        <div style="background:#f8fafc;border-radius:12px;padding:16px;margin-bottom:24px;text-align:left">
            <div style="font-size:0.8rem;color:#64748b;margin-bottom:8px;font-weight:600">Sera supprimé :</div>
            <div style="font-size:0.82rem;color:#ef4444;line-height:1.8">
                <i class="bi bi-x-circle me-1"></i> Photo de profil<br>
                <i class="bi bi-x-circle me-1"></i> CV<br>
                <i class="bi bi-x-circle me-1"></i> Titre, localisation, téléphone<br>
                <i class="bi bi-x-circle me-1"></i> Date de naissance, expérience<br>
                <i class="bi bi-x-circle me-1"></i> Résumé / À propos
            </div>
            <div style="font-size:0.8rem;color:#64748b;margin:12px 0 8px;font-weight:600">Sera conservé :</div>
            <div style="font-size:0.82rem;color:#10b981;line-height:1.8">
                <i class="bi bi-check-circle me-1"></i> Prénom & Nom
            </div>
        </div>
        <div class="d-flex gap-2 justify-content-center">
            <button onclick="document.getElementById('resetModal').style.display='none'" class="btn" style="padding:10px 24px;border-radius:12px;font-weight:600;font-size:0.85rem;border:1.5px solid #e2e8f0;color:#64748b;background:white">
                Annuler
            </button>
            <form method="post" action="{{ path('app_profile_reset') }}" style="display:inline">
                <button type="submit" class="btn" style="padding:10px 24px;border-radius:12px;font-weight:600;font-size:0.85rem;background:#ef4444;color:white;border:none">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Réinitialiser
                </button>
            </form>
        </div>
    </div>
</div>
<script>
document.getElementById('resetModal').addEventListener('click', function(e) {
    if (e.target === this) this.style.display = 'none';
});
</script>
{% endblock %}
