{% extends 'front/_base.html.twig' %}
{% block title %}Mes Activités — Talentos{% endblock %}
{% block content %}
<div class="fo-page-header">
    <div class="container">
        <h1>Mes Activités 📋</h1>
        <p>Activités et tâches qui vous ont été assignées</p>
    </div>
</div>
<section class="fo-section" style="padding-top:40px">
    <div class="container" style="max-width:800px">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mb-3"><i class="bi bi-check-circle-fill me-2"></i>{{ message }}</div>
        {% endfor %}

        {% if stats.total > 0 and stats.percentage < 50 %}
            <div class="alert alert-danger mb-4" style="background:rgba(239, 68, 68, 0.1);border-left:4px solid #ef4444;color:#b91c1c">
                <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Alerte de Performance :</strong> Votre taux de rentabilité / respect des délais est descendu à <strong>{{ stats.percentage }}%</strong>. Ce seuil critique (< 50%) vous expose à un risque de renvoi. Veuillez corriger le tir rapidement !
            </div>
        {% endif %}

        {# Summary stats #}
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="fo-card text-center" style="padding:20px; border-top: 4px solid var(--primary);">
                    <div style="font-size:1.8rem;font-weight:800;color:var(--primary)">{{ stats.total }}</div>
                    <div style="font-size:0.85rem;color:var(--fo-text-secondary)">Total activités</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="fo-card text-center" style="padding:20px; border-top: 4px solid var(--accent);">
                    <div style="font-size:1.8rem;font-weight:800;color:var(--accent)">
                        {{ stats.approved }}
                    </div>
                    <div style="font-size:0.85rem;color:var(--fo-text-secondary)">Validées (Efficaces)</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="fo-card text-center" style="padding:20px; border-top: 4px solid {% if stats.percentage >= 50 %}var(--success){% else %}#ef4444{% endif %};">
                    <div style="font-size:1.8rem;font-weight:800;color:{% if stats.percentage >= 50 %}var(--success){% else %}#ef4444{% endif %};">
                        {{ stats.percentage }}%
                    </div>
                    <div style="font-size:0.85rem;color:var(--fo-text-secondary)">Respect des délais</div>
                </div>
            </div>
        </div>

        {# Activities list #}
        <h6 style="font-weight:700;margin-bottom:16px">Activités récentes</h6>
        {% for a in activities %}
            <div class="fo-card mb-3 d-flex align-items-start gap-3" style="padding:20px; cursor:pointer; transition:transform 0.2s" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='none'" onclick="window.location.href='{{ path('app_activity_detail', {id: a.id}) }}'">
                <div style="width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;
                    {% if a.project %}background:rgba(79,70,229,0.08);color:var(--primary)
                    {% else %}background:rgba(6,182,212,0.08);color:var(--accent){% endif %}">
                    <i class="bi bi-{% if a.project %}kanban{% else %}clipboard-data{% endif %}" style="font-size:1.1rem"></i>
                </div>
                <div style="flex:1">
                    <div style="font-weight:600;font-size:0.95rem">{{ a.description }}</div>
                    <div style="margin-top:6px;display:flex;flex-wrap:wrap;gap:8px;align-items:center">
                        {% if a.project %}
                            <span class="fo-badge fo-badge-primary"><i class="bi bi-kanban me-1"></i>{{ a.project.name }}</span>
                        {% endif %}

                        {% if a.deadline %}
                            <span class="fo-badge {% if a.isOnTime() %}fo-badge-success{% else %}fo-badge-danger{% endif %} text-white" style="{% if not a.isOnTime() %}background:#ef4444;{% endif %}">
                                <i class="bi bi-alarm me-1"></i>{% if a.isOnTime() %}Dans les temps{% else %}En retard{% endif %}
                            </span>
                        {% endif %}
                        <span class="fo-badge {% if a.status == 'APPROVED' %}fo-badge-success{% elseif a.status == 'REJECTED' %}fo-badge-danger{% else %}fo-badge-warning{% endif %}">
                            {{ a.status }}
                        </span>
                        <span style="font-size:0.8rem;color:var(--fo-text-secondary);margin-left:auto;">
                            <i class="bi bi-calendar3 me-1"></i>{{ a.activityDate ? a.activityDate|date('d/m/Y') : '—' }}
                        </span>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="fo-card text-center" style="padding:60px">
                <i class="bi bi-clipboard-x" style="font-size:3rem;color:var(--fo-text-secondary);opacity:0.4"></i>
                <p class="mt-3" style="color:var(--fo-text-secondary);margin-bottom:4px">Aucune activité assignée</p>
                <small style="color:var(--fo-text-secondary)">Vos recruteurs vous assigneront des activités ici</small>
            </div>
        {% endfor %}
    </div>
</section>
{% endblock %}
