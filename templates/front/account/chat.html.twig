{% extends 'front/_base.html.twig' %}
{% block title %}Chat — {{ otherUser.email }}{% endblock %}
{% block content %}
<div class="fo-page-header">
    <div class="container">
        <a href="{{ path('app_my_circle') }}" style="color:var(--primary);text-decoration:none;font-size:0.9rem;font-weight:500"><i class="bi bi-arrow-left me-1"></i> Mon Cercle</a>
        <h1 class="mt-2">{{ otherUser.email }}</h1>
    </div>
</div>
<section class="fo-section" style="padding-top:40px">
    <div class="container" style="max-width:700px">
        <div class="fo-card" style="min-height:400px;display:flex;flex-direction:column">
            <div style="flex:1;overflow-y:auto;max-height:450px;margin-bottom:16px;padding:8px">
                {% for msg in messages %}
                    <div class="mb-3 d-flex {{ msg.sender == app.user ? 'justify-content-end' : '' }}">
                        <div style="max-width:70%;padding:12px 16px;border-radius:16px;
                            {{ msg.sender == app.user ? 'background:var(--primary);color:white;border-bottom-right-radius:4px' : 'background:var(--fo-bg-section);border-bottom-left-radius:4px' }}">
                            <div style="font-size:0.9rem">{{ msg.message }}</div>
                            <div style="font-size:0.7rem;opacity:0.7;margin-top:4px;text-align:right">{{ msg.createdAt ? msg.createdAt|date('H:i') : '' }}</div>
                        </div>
                    </div>
                {% else %}
                    <p class="text-center" style="color:var(--fo-text-secondary)">Aucun message. Commencez la conversation !</p>
                {% endfor %}
            </div>
            <form method="post" action="{{ path('app_chat_send', {id: sync.id}) }}" class="fo-form">
                <div class="d-flex gap-2">
                    <input type="text" name="message" class="form-control" placeholder="Écrire un message..." required autocomplete="off">
                    <button type="submit" class="btn btn-primary-custom" style="white-space:nowrap;padding:10px 20px"><i class="bi bi-send"></i></button>
                </div>
            </form>
        </div>
    </div>
</section>
{% endblock %}
