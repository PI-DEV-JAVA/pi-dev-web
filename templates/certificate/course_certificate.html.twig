<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<style>
  @page { margin: 0; size: A4 landscape; }
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'DejaVu Sans', Arial, sans-serif;
    background: #ffffff;
    width: 297mm;
    height: 210mm;
    overflow: hidden;
  }

  /* ── Main two-column table ── */
  .cert-table {
    width: 100%;
    height: 210mm;
    border-collapse: collapse;
  }

  /* ── LEFT PANEL ── */
  .left-panel {
    width: 65%;
    vertical-align: top;
    padding: 36px 50px 28px 52px;
    border-right: 3px solid #1a3a6e;
    position: relative;
  }

  /* thin red accent line at top left */
  .red-bar {
    display: block;
    width: 44px;
    height: 5px;
    background: #c8102e;
    margin-bottom: 10px;
  }

  .logo-row { margin-bottom: 4px; }
  .logo-name {
    font-size: 22px;
    font-weight: 900;
    color: #1a3a6e;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .logo-name span { color: #c8102e; }
  .logo-sub {
    font-size: 9px;
    color: #1a3a6e;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-top: 1px;
    display: block;
  }

  .cert-date {
    font-size: 9px;
    color: #64748b;
    margin-top: 18px;
    margin-bottom: 12px;
  }

  .recipient {
    font-size: 30px;
    font-weight: 700;
    color: #1a3a6e;
    letter-spacing: -0.5px;
    line-height: 1.1;
    margin-bottom: 10px;
    font-style: italic;
  }

  .completed-text {
    font-size: 11px;
    color: #475569;
    margin-bottom: 6px;
  }

  .course-name {
    font-size: 19px;
    font-weight: 900;
    color: #0f172a;
    margin-bottom: 8px;
    line-height: 1.2;
  }

  .course-desc {
    font-size: 10px;
    color: #64748b;
    line-height: 1.6;
    margin-bottom: 18px;
    max-width: 340px;
  }

  /* Stats using table for Dompdf */
  .stats-table { border-collapse: collapse; margin-bottom: 20px; }
  .stats-table td { padding: 0 14px 0 0; vertical-align: top; }
  .stat-num { font-size: 20px; font-weight: 900; color: #1a3a6e; line-height: 1; }
  .stat-num.green { color: #10b981; }
  .stat-num.red   { color: #c8102e; }
  .stat-label { font-size: 8px; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-top: 2px; }
  .stat-sep { width: 1px; background: #e2e8f0; height: 32px; margin-right: 14px; vertical-align: middle; }

  /* ── Footer row using table ── */
  .footer-table { width: 100%; border-collapse: collapse; border-top: 1.5px solid #e2e8f0; padding-top: 14px; }
  .footer-table td { vertical-align: bottom; padding-top: 10px; }

  .sig-block { text-align: left; min-width: 130px; }
  .sig-line { width: 110px; height: 1px; background: #cbd5e1; margin-bottom: 4px; }
  .sig-name { font-size: 11px; font-weight: 700; color: #0f172a; font-style: italic; }
  .sig-title { font-size: 8px; color: #64748b; margin-top: 2px; }

  .qr-cell { text-align: right; }
  .qr-label { font-size: 7px; color: #94a3b8; margin-top: 3px; letter-spacing: 0.5px; text-align: center; }

  /* ── RIGHT PANEL ── */
  .right-panel {
    width: 35%;
    vertical-align: middle;
    text-align: center;
    background: #f8fafc;
    padding: 36px 30px;
    position: relative;
  }

  /* Ribbon banner */
  .ribbon-wrap { position: relative; display: inline-block; margin-bottom: 24px; }
  .ribbon-title { font-size: 9px; letter-spacing: 4px; color: #64748b; text-transform: uppercase; margin-bottom: 6px; }
  .ribbon-main { font-size: 22px; font-weight: 900; color: #1a3a6e; letter-spacing: 2px; text-transform: uppercase; line-height: 1.2; }
  .ribbon-main span { color: #c8102e; display: block; }

  .divider-short { width: 50px; height: 2px; background: #1a3a6e; margin: 10px auto; }

  /* Circular seal */
  .seal-outer {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    border: 5px solid #1a3a6e;
    margin: 0 auto 8px;
    position: relative;
    background: #fff;
  }
  .seal-inner {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    border: 2px solid #c8102e;
    margin: 5px auto 0;
    display: table;
  }
  .seal-inner-td { display: table-cell; vertical-align: middle; text-align: center; }
  .seal-icon { font-size: 32px; display: block; }
  .seal-text { font-size: 7px; font-weight: 900; letter-spacing: 2px; color: #1a3a6e; text-transform: uppercase; display: block; margin-top: 2px; }

  .platform-name { font-size: 16px; font-weight: 900; color: #1a3a6e; letter-spacing: 3px; margin-bottom: 4px; }
  .platform-tagline { font-size: 8px; color: #94a3b8; letter-spacing: 1px; }

  .verify-note { font-size: 8px; color: #64748b; line-height: 1.5; margin-top: 14px; }
  .verify-url { font-size: 7px; color: #1a3a6e; font-weight: 700; word-break: break-all; margin-top: 2px; }

  /* Mention badge */
  .mention-badge {
    display: inline-block;
    padding: 4px 14px;
    border-radius: 20px;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-top: 8px;
  }
  .mention-felicitations { background: #fef3c7; color: #92400e; border: 1px solid #fbbf24; }
  .mention-tres-bien { background: #ecfdf5; color: #065f46; border: 1px solid #6ee7b7; }
  .mention-bien { background: #eff6ff; color: #1e40af; border: 1px solid #93c5fd; }

  /* Bottom legal strip */
  .legal-strip {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    background: #1a3a6e;
    color: rgba(255,255,255,0.7);
    font-size: 6px;
    padding: 5px 52px;
    letter-spacing: 0.5px;
    text-align: center;
  }
</style>
</head>
<body>

<table class="cert-table">
  <tr>

    {# ═══════════════ LEFT PANEL ═══════════════ #}
    <td class="left-panel">

      <span class="red-bar"></span>

      {# Logo #}
      <div class="logo-row">
        <span class="logo-name">⚡ <span>Talentos</span></span>
        <span class="logo-sub">Plateforme de Formation Professionnelle</span>
      </div>

      {# Date #}
      <div class="cert-date">{{ date|date('d/m/Y') }}</div>

      {# Recipient #}
      <div class="recipient">
        {% if user.profile is defined and user.profile and user.profile.firstName is defined and user.profile.firstName %}
          {{ user.profile.firstName }} {{ user.profile.lastName ?? '' }}
        {% else %}
          {{ user.email }}
        {% endif %}
      </div>

      <div class="completed-text">a complété avec succès la formation certifiante :</div>

      <div class="course-name">{{ formation.titre }}</div>

      <div class="course-desc">
        Formation validée par la plateforme Talentos.
        {% if formation.duree %}Durée : {{ formation.duree }} heures.{% endif %}
        {% if formation.niveau %}Niveau : {{ formation.niveau }}.{% endif %}
      </div>

      {# Mention badge #}
      {% if avgPercent >= 90 %}
        <div class="mention-badge mention-felicitations">★ Avec Félicitations du Jury</div>
      {% elseif avgPercent >= 80 %}
        <div class="mention-badge mention-tres-bien">Mention Très Bien</div>
      {% elseif avgPercent >= 70 %}
        <div class="mention-badge mention-bien">Mention Bien</div>
      {% endif %}

      {# Stats as table #}
      <table class="stats-table">
        <tr>
          <td>
            <div class="stat-num green">{{ avgScore }}<span style="font-size:12px;color:#64748b">/20</span></div>
            <div class="stat-label">Note moyenne</div>
          </td>
          <td><div class="stat-sep"></div></td>
          <td>
            <div class="stat-num red">{{ avgPercent }}<span style="font-size:12px">%</span></div>
            <div class="stat-label">Réussite</div>
          </td>
          <td><div class="stat-sep"></div></td>
          <td>
            <div class="stat-num">{{ attempts|length }}</div>
            <div class="stat-label">Quiz validés</div>
          </td>
          {% if formation.duree %}
          <td><div class="stat-sep"></div></td>
          <td>
            <div class="stat-num" style="color:#f59e0b">{{ formation.duree }}<span style="font-size:12px">h</span></div>
            <div class="stat-label">Durée</div>
          </td>
          {% endif %}
        </tr>
      </table>

      {# Footer: signature + QR #}
      <table class="footer-table">
        <tr>
          <td class="sig-block">
            <div class="sig-line"></div>
            <div class="sig-name">Equipe Talentos</div>
            <div class="sig-title">Responsable Pédagogique — Talentos Platform</div>
          </td>
          {% if qrSvg is defined and qrSvg %}
          <td class="qr-cell">
            {{ qrSvg|raw }}
            <div class="qr-label">Scanner pour vérifier</div>
          </td>
          {% endif %}
        </tr>
      </table>

    </td>

    {# ═══════════════ RIGHT PANEL ═══════════════ #}
    <td class="right-panel">

      <div class="ribbon-title">Attestation officielle</div>
      <div class="ribbon-main">
        CERTIFICAT
        <span>DE RÉUSSITE</span>
      </div>
      <div class="divider-short"></div>

      {# Circular seal #}
      <div class="seal-outer">
        <div class="seal-inner">
          <div class="seal-inner-td">
            <span class="seal-icon">🏅</span>
            <span class="seal-text">Certifié</span>
          </div>
        </div>
      </div>

      <div class="platform-name">TALENTOS</div>
      <div class="platform-tagline">Formation Professionnelle en Ligne</div>

      <div class="verify-note">
        Vérifiable en ligne via le QR code<br>ou à l'adresse ci-dessous
      </div>
      {% if verifyUrl is defined %}
      <div class="verify-url">{{ verifyUrl }}</div>
      {% endif %}

    </td>

  </tr>
</table>

{# Legal strip #}
<div class="legal-strip">
  Ce certificat atteste que le titulaire a accompli et validé l'intégralité de la formation indiquée sur la plateforme Talentos — Tous droits réservés © {{ date|date('Y') }} Talentos Platform
</div>

</body>
</html>
