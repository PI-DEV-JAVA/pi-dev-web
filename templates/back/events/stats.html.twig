{% extends 'back/_base.html.twig' %}
{% block page_title %}Statistiques événements{% endblock %}
{% block content %}
<style>
    .chart-card { background: var(--bo-bg-card); border: 1.5px solid var(--bo-border); border-radius: 14px; padding: 24px; }
    .chart-title { font-weight: 700; font-size: 0.9rem; margin-bottom: 16px; color: var(--bo-text); }
    .stats-table { width: 100%; border-collapse: separate; border-spacing: 0; }
    .stats-table th { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--bo-text-secondary); font-weight: 600; padding: 10px 14px; border-bottom: 1px solid var(--bo-border); text-align: left; }
    .stats-table td { padding: 12px 14px; border-bottom: 1px solid rgba(71,85,105,0.15); font-size: 0.85rem; }
    .stats-table tr:hover td { background: rgba(79,70,229,0.03); }
</style>

<div class="d-flex align-items-center justify-content-between mb-4">
    <h5 style="font-weight:700;margin:0"><i class="bi bi-graph-up me-2"></i>Statistiques de satisfaction</h5>
</div>

<div class="row g-4 mb-4">
    {# Chart 1: Avg rating per event (horizontal bars) #}
    <div class="col-md-6">
        <div class="chart-card">
            <div class="chart-title"><i class="bi bi-star-fill me-1" style="color:#fbbf24"></i>Note moyenne par événement</div>
            <canvas id="ratingsChart" height="250"></canvas>
        </div>
    </div>

    {# Chart 2: Recommendation rate per event (vertical bars) #}
    <div class="col-md-6">
        <div class="chart-card">
            <div class="chart-title"><i class="bi bi-hand-thumbs-up-fill me-1" style="color:#34d399"></i>Taux de recommandation</div>
            <canvas id="recommendChart" height="250"></canvas>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    {# Chart 3: Event type distribution (doughnut) #}
    <div class="col-md-4">
        <div class="chart-card" style="text-align:center">
            <div class="chart-title"><i class="bi bi-pie-chart-fill me-1" style="color:var(--primary-light)"></i>Répartition par type</div>
            <canvas id="typeChart" height="220"></canvas>
        </div>
    </div>

    {# Summary table #}
    <div class="col-md-8">
        <div class="chart-card">
            <div class="chart-title"><i class="bi bi-table me-1"></i>Tableau récapitulatif</div>
            <div style="overflow-x:auto">
                <table class="stats-table">
                    <thead>
                        <tr>
                            <th>Événement</th>
                            <th>Type</th>
                            <th>Participants</th>
                            <th>Avis</th>
                            <th>Note moy.</th>
                            <th>Recommandations</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for s in stats %}
                        <tr>
                            <td style="font-weight:600">{{ s.title }}</td>
                            <td><span class="bo-badge bo-badge-primary" style="font-size:0.7rem">{{ s.eventType }}</span></td>
                            <td>{{ s.participantCount }}</td>
                            <td>{{ s.feedbackCount }}</td>
                            <td>
                                {% if s.avgRating %}
                                    <span style="color:{{ s.avgRating >= 4 ? '#34d399' : (s.avgRating >= 3 ? '#fbbf24' : '#f87171') }};font-weight:700">
                                        {{ s.avgRating|number_format(1) }}/5
                                    </span>
                                {% else %}
                                    <span style="color:var(--bo-text-secondary)">—</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if s.feedbackCount > 0 %}
                                    {{ ((s.recommends / s.feedbackCount) * 100)|number_format(0) }}%
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                        </tr>
                        {% else %}
                        <tr><td colspan="6" class="text-center" style="padding:30px;color:var(--bo-text-secondary)">Aucune donnée disponible.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
Chart.defaults.color = '#94a3b8';
Chart.defaults.borderColor = 'rgba(71,85,105,0.2)';

// Data
var labels = [{% for s in stats %}'{{ s.title|slice(0,20) }}'{% if not loop.last %},{% endif %}{% endfor %}];
var avgRatings = [{% for s in stats %}{{ s.avgRating ? s.avgRating|number_format(2) : 0 }}{% if not loop.last %},{% endif %}{% endfor %}];
var recommRates = [{% for s in stats %}{{ s.feedbackCount > 0 ? ((s.recommends / s.feedbackCount) * 100)|number_format(0) : 0 }}{% if not loop.last %},{% endif %}{% endfor %}];

// 1. Avg ratings (horizontal bars)
new Chart(document.getElementById('ratingsChart'), {
    type: 'bar',
    data: {
        labels: labels,
        datasets: [{
            label: 'Note moyenne',
            data: avgRatings,
            backgroundColor: avgRatings.map(v => v >= 4 ? 'rgba(16,185,129,0.6)' : v >= 3 ? 'rgba(245,158,11,0.6)' : 'rgba(239,68,68,0.6)'),
            borderRadius: 6,
            barThickness: 20,
        }]
    },
    options: {
        indexAxis: 'y',
        plugins: { legend: { display: false } },
        scales: { x: { min: 0, max: 5, grid: { color: 'rgba(71,85,105,0.1)' } } }
    }
});

// 2. Recommendation rates (vertical bars)
new Chart(document.getElementById('recommendChart'), {
    type: 'bar',
    data: {
        labels: labels,
        datasets: [{
            label: 'Recommandation %',
            data: recommRates,
            backgroundColor: 'rgba(79,70,229,0.5)',
            borderColor: 'rgba(79,70,229,0.8)',
            borderWidth: 1,
            borderRadius: 6,
        }]
    },
    options: {
        plugins: { legend: { display: false } },
        scales: { y: { min: 0, max: 100, grid: { color: 'rgba(71,85,105,0.1)' } } }
    }
});

// 3. Type distribution (doughnut)
var typeLabels = [{% for t in typeDistrib %}'{{ t.type }}'{% if not loop.last %},{% endif %}{% endfor %}];
var typeCounts = [{% for t in typeDistrib %}{{ t.cnt }}{% if not loop.last %},{% endif %}{% endfor %}];
var typeColors = ['#4f46e5', '#06b6d4', '#f59e0b', '#10b981', '#ef4444'];

new Chart(document.getElementById('typeChart'), {
    type: 'doughnut',
    data: {
        labels: typeLabels,
        datasets: [{
            data: typeCounts,
            backgroundColor: typeColors.slice(0, typeLabels.length),
            borderWidth: 0,
            hoverOffset: 8,
        }]
    },
    options: {
        cutout: '65%',
        plugins: {
            legend: { position: 'bottom', labels: { padding: 16, usePointStyle: true, pointStyle: 'circle' } }
        }
    }
});
</script>
{% endblock %}
