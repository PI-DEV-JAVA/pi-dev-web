{% extends 'back/_base.html.twig' %}
{% block page_title %}{{ project ? 'Modifier le projet' : 'Nouveau projet' }}{% endblock %}
{% block content %}
<div class="mb-3"><a href="{{ path('admin_projects') }}" style="color:var(--primary-light);text-decoration:none;font-size:0.9rem"><i class="bi bi-arrow-left me-1"></i> Retour</a></div>

<div class="row g-4">
    <div class="{{ project ? 'col-lg-7' : 'col-12' }}">
        <div class="bo-card bo-form" style="max-width:700px">
            <h6 style="font-weight:700;margin-bottom:20px">{{ project ? 'Informations du projet' : 'Nouveau projet' }}</h6>
            <form method="post">
                <div class="row g-3">
                    <div class="col-12"><label>Nom *</label><input type="text" name="name" class="form-control" value="{{ project ? project.name : '' }}" required></div>
                    <div class="col-12"><label>Description</label><textarea name="description" class="form-control" rows="3">{{ project ? project.description : '' }}</textarea></div>
                    <div class="col-md-4"><label>Statut</label>
                        <select name="status" class="form-select">
                            <option value="PLANNED" {{ project and project.status == 'PLANNED' ? 'selected' }}>Planifié</option>
                            <option value="IN_PROGRESS" {{ project and project.status == 'IN_PROGRESS' ? 'selected' }}>En cours</option>
                            <option value="DONE" {{ project and project.status == 'DONE' ? 'selected' }}>Terminé</option>
                            <option value="ON_HOLD" {{ project and project.status == 'ON_HOLD' ? 'selected' }}>En attente</option>
                        </select>
                    </div>
                    <div class="col-md-4"><label>Date début</label><input type="date" name="startDate" class="form-control" value="{{ project and project.startDate ? project.startDate|date('Y-m-d') : '' }}"></div>
                    <div class="col-md-4"><label>Date fin</label><input type="date" name="endDate" class="form-control" value="{{ project and project.endDate ? project.endDate|date('Y-m-d') : '' }}"></div>
                    <div class="col-md-6"><label>Budget (DT)</label><input type="number" step="0.01" name="budget" class="form-control" value="{{ project ? project.budget : '' }}"></div>
                </div>
                <div class="mt-4"><button type="submit" class="bo-btn bo-btn-primary"><i class="bi bi-check-lg me-1"></i> {{ project ? 'Enregistrer' : 'Créer' }}</button></div>
            </form>
        </div>

        {# ═══ TIMER WIDGET (visible on edit only) ═══ #}
        {% if project %}
        <div class="bo-card mt-4" id="project-timer-card">
            <h6 style="font-weight:700;margin-bottom:16px">
                <i class="bi bi-stopwatch me-2" style="color:var(--accent)"></i>Chronomètre du projet
            </h6>
            <div id="timer-widget" style="display:flex;align-items:center;gap:16px;padding:16px 20px;border-radius:12px;background:rgba(255,255,255,0.03);border:1px solid var(--bo-border)">
                <div id="timer-pulse" style="width:12px;height:12px;border-radius:50%;background:#10b981;box-shadow:0 0 8px #10b981;animation:pulse 1.5s infinite;flex-shrink:0"></div>
                <div id="timer-display" style="font-family:'JetBrains Mono',monospace;font-size:1.8rem;font-weight:700;letter-spacing:2px;color:var(--bo-text-primary)">00:00:00</div>
                <div style="flex:1;text-align:right">
                    <div id="timer-status" style="font-size:0.8rem;color:#10b981"><i class="bi bi-record-circle me-1"></i>En cours</div>
                    <div id="timer-saved" style="font-size:0.7rem;color:var(--bo-text-secondary);margin-top:2px"></div>
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button class="bo-btn bo-btn-primary" id="btn-pause" style="padding:6px 16px;font-size:0.85rem" onclick="togglePause()">
                    <i class="bi bi-pause-fill me-1"></i><span id="btn-pause-label">Pause</span>
                </button>
                <button class="bo-btn" id="btn-reset" style="padding:6px 16px;font-size:0.85rem;background:rgba(239,68,68,0.15);color:#ef4444;border:1px solid rgba(239,68,68,0.3)" onclick="resetTimer()">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Réinitialiser
                </button>
            </div>
        </div>
        {% endif %}
    </div>

    {% if project and activities is defined %}
    <div class="col-lg-5">
        <div class="bo-card" style="margin-bottom:16px">
            <h6 style="font-weight:700;margin-bottom:16px"><i class="bi bi-activity me-2" style="color:var(--accent)"></i>Activités ({{ activities|length }})</h6>

            <form method="post" action="{{ path('admin_project_activity_new', {id: project.id}) }}" class="bo-form mb-3">
                <div class="mb-2"><input type="text" name="description" class="form-control" placeholder="Description de l'activité..." required></div>
                <div class="row g-2 mb-2">
                    <div class="col-4"><input type="date" name="activityDate" class="form-control" title="Date" value="{{ 'now'|date('Y-m-d') }}" required></div>
                    <div class="col-4"><input type="date" name="deadline" class="form-control" title="Deadline (Optionnel)"></div>
                    <div class="col-4"><input type="number" step="0.5" name="hoursWorked" class="form-control" placeholder="Heures"></div>
                </div>
                <button type="submit" class="bo-btn bo-btn-primary" style="width:100%;padding:8px"><i class="bi bi-plus me-1"></i>Ajouter</button>
            </form>

            {% for a in activities %}
                <div class="d-flex align-items-start gap-3 py-2" style="border-bottom:1px solid var(--bo-border)">
                    <div style="width:32px;height:32px;border-radius:8px;background:rgba(6,182,212,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                        <i class="bi bi-activity" style="color:var(--accent);font-size:0.85rem"></i>
                    </div>
                    <div style="flex:1">
                        <div style="font-weight:600;font-size:0.85rem">{{ a.description }}</div>
                        <div style="font-size:0.75rem;color:var(--bo-text-secondary)">
                            {{ a.activityDate ? a.activityDate|date('d/m/Y') : '' }}
                            {% if a.hoursWorked %} · {{ a.hoursWorked }}h{% endif %}
                        </div>
                    </div>
                </div>
            {% else %}
                <p style="color:var(--bo-text-secondary);font-size:0.85rem;text-align:center;padding:16px 0">Aucune activité.</p>
            {% endfor %}
        </div>
    </div>
    {% endif %}
</div>

{% if project %}
<style>
@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
}
#timer-widget.paused #timer-pulse {
    background: #f59e0b !important;
    box-shadow: 0 0 8px #f59e0b !important;
    animation: none !important;
}
#timer-widget.paused #timer-status {
    color: #f59e0b !important;
}
</style>

<script>
(function() {
    var PROJECT_ID = {{ project.id }};
    var SAVE_URL = '/admin/projects/' + PROJECT_ID + '/timer-save';
    var IDLE_LIMIT = 30 * 60 * 1000; // 30 minutes
    var AUTOSAVE_INTERVAL = 60 * 1000; // 60 seconds

    var totalSeconds = {{ project.timeSpent }};
    var isRunning = true;
    var isPaused = false;
    var lastMouseMove = Date.now();

    var displayEl = document.getElementById('timer-display');
    var statusEl = document.getElementById('timer-status');
    var savedEl = document.getElementById('timer-saved');
    var widgetEl = document.getElementById('timer-widget');
    var btnLabel = document.getElementById('btn-pause-label');

    function formatTime(secs) {
        var h = Math.floor(secs / 3600);
        var m = Math.floor((secs % 3600) / 60);
        var s = secs % 60;
        return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
    }

    function updateDisplay() {
        displayEl.textContent = formatTime(totalSeconds);
    }

    function tick() {
        if (isPaused) return;

        // Check idle
        if (Date.now() - lastMouseMove > IDLE_LIMIT) {
            if (isRunning) {
                isRunning = false;
                widgetEl.classList.add('paused');
                statusEl.innerHTML = '<i class="bi bi-pause-circle me-1"></i>Inactif — Bougez la souris';
                saveToServer();
            }
            return;
        }

        if (isRunning) {
            totalSeconds++;
            updateDisplay();
        }
    }

    function saveToServer() {
        fetch(SAVE_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ seconds: totalSeconds })
        }).then(function(r) { return r.json(); }).then(function(data) {
            if (data.success) {
                var now = new Date();
                savedEl.textContent = 'Dernière sauvegarde: ' + now.toLocaleTimeString('fr-FR');
            }
        }).catch(function() {});
    }

    function saveBeacon() {
        if (navigator.sendBeacon) {
            var blob = new Blob([JSON.stringify({ seconds: totalSeconds })], { type: 'application/json' });
            navigator.sendBeacon(SAVE_URL, blob);
        } else {
            var xhr = new XMLHttpRequest();
            xhr.open('POST', SAVE_URL, false);
            xhr.setRequestHeader('Content-Type', 'application/json');
            xhr.send(JSON.stringify({ seconds: totalSeconds }));
        }
    }

    // Mouse / keyboard activity detection
    document.addEventListener('mousemove', function() {
        lastMouseMove = Date.now();
        if (!isRunning && !isPaused) {
            isRunning = true;
            widgetEl.classList.remove('paused');
            statusEl.innerHTML = '<i class="bi bi-record-circle me-1"></i>En cours';
        }
    });
    document.addEventListener('keydown', function() {
        lastMouseMove = Date.now();
        if (!isRunning && !isPaused) {
            isRunning = true;
            widgetEl.classList.remove('paused');
            statusEl.innerHTML = '<i class="bi bi-record-circle me-1"></i>En cours';
        }
    });

    // Pause / Resume
    window.togglePause = function() {
        isPaused = !isPaused;
        if (isPaused) {
            isRunning = false;
            widgetEl.classList.add('paused');
            statusEl.innerHTML = '<i class="bi bi-pause-circle me-1"></i>En pause';
            btnLabel.textContent = 'Reprendre';
            document.querySelector('#btn-pause i').className = 'bi bi-play-fill me-1';
            saveToServer();
        } else {
            isRunning = true;
            widgetEl.classList.remove('paused');
            statusEl.innerHTML = '<i class="bi bi-record-circle me-1"></i>En cours';
            btnLabel.textContent = 'Pause';
            document.querySelector('#btn-pause i').className = 'bi bi-pause-fill me-1';
            lastMouseMove = Date.now();
        }
    };

    // Reset
    window.resetTimer = function() {
        if (confirm('Réinitialiser le chronomètre à 0 ?')) {
            totalSeconds = 0;
            updateDisplay();
            saveToServer();
        }
    };

    // Start
    updateDisplay();
    setInterval(tick, 1000);
    setInterval(saveToServer, AUTOSAVE_INTERVAL);

    // Save on page exit
    window.addEventListener('beforeunload', function() { saveBeacon(); });
    document.addEventListener('visibilitychange', function() {
        if (document.visibilityState === 'hidden') saveBeacon();
    });

    savedEl.textContent = 'Sauvegarde auto toutes les 60s';
})();
</script>
{% endif %}
{% endblock %}
