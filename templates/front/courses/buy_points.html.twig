{% extends 'front/_base.html.twig' %}
{% block title %}Acheter des points — Talentos{% endblock %}

{% block content %}
<div class="fo-page-header">
    <div class="container">
        <a href="{{ path('app_courses') }}" style="color:var(--primary);text-decoration:none;font-size:0.9rem;font-weight:500">
            <i class="bi bi-arrow-left me-1"></i> Retour aux formations
        </a>
        <h1 class="mt-2"><i class="bi bi-coin me-2" style="color:#f59e0b"></i>Acheter des points</h1>
        <p>Utilisez vos points pour accéder aux formations payantes de Talentos</p>
    </div>
</div>

<section class="fo-section" style="padding-top:40px">
    <div class="container" style="max-width:900px">

        {% for message in app.flashes('success') %}
            <div class="alert alert-success mb-3"><i class="bi bi-check-circle-fill me-2"></i>{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('danger') %}
            <div class="alert alert-danger mb-3"><i class="bi bi-exclamation-triangle-fill me-2"></i>{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('info') %}
            <div class="alert alert-info mb-3"><i class="bi bi-info-circle-fill me-2"></i>{{ message }}</div>
        {% endfor %}

        {# ── Current Balance ── #}
        <div style="text-align:center;margin-bottom:40px">
            <div style="display:inline-flex;align-items:center;gap:12px;background:linear-gradient(135deg,rgba(79,70,229,0.06),rgba(139,92,246,0.06));border:1.5px solid rgba(79,70,229,0.15);border-radius:16px;padding:16px 32px">
                <div style="width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg,#f59e0b,#f97316);display:flex;align-items:center;justify-content:center">
                    <i class="bi bi-coin" style="font-size:1.4rem;color:white"></i>
                </div>
                <div style="text-align:left">
                    <div style="font-size:0.75rem;color:var(--fo-text-secondary);text-transform:uppercase;font-weight:600;letter-spacing:0.5px">Solde actuel</div>
                    <div style="font-size:1.8rem;font-weight:800;line-height:1;color:var(--fo-text)">{{ app.user.pointsBalance }} <span style="font-size:0.9rem;font-weight:600;color:var(--fo-text-secondary)">pts</span></div>
                </div>
            </div>
        </div>

        {# ── Pricing Cards ── #}
        <div class="row g-4 justify-content-center mb-5">
            {% for points, pack in packs %}
            <div class="col-md-4">
                <div style="position:relative;background:white;border:{{ pack.popular ? '2px solid var(--primary)' : '1.5px solid var(--fo-border)' }};border-radius:20px;padding:32px 24px;text-align:center;transition:all 0.3s;{{ pack.popular ? 'box-shadow:0 8px 40px rgba(79,70,229,0.15);transform:scale(1.04)' : '' }}" onmouseover="this.style.transform='translateY(-6px) {{ pack.popular ? 'scale(1.04)' : '' }}';this.style.boxShadow='0 20px 50px rgba(0,0,0,0.12)'" onmouseout="this.style.transform='{{ pack.popular ? 'scale(1.04)' : 'none' }}';this.style.boxShadow='{{ pack.popular ? '0 8px 40px rgba(79,70,229,0.15)' : 'var(--fo-card-shadow)' }}'">

                    {% if pack.popular %}
                    <div style="position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,var(--primary),#7c3aed);color:white;padding:4px 18px;border-radius:20px;font-size:0.72rem;font-weight:700;letter-spacing:0.5px;text-transform:uppercase">
                        ⭐ Populaire
                    </div>
                    {% endif %}

                    {% if pack.save %}
                    <div style="position:absolute;top:16px;right:16px;background:rgba(16,185,129,0.1);color:#10b981;padding:3px 10px;border-radius:8px;font-size:0.7rem;font-weight:700">
                        -{{ pack.save }}
                    </div>
                    {% endif %}

                    <div style="font-size:2.5rem;margin-bottom:8px">{{ pack.icon }}</div>

                    <div style="font-size:2rem;font-weight:800;color:{{ pack.color }};margin-bottom:4px">{{ points }}</div>
                    <div style="font-size:0.85rem;color:var(--fo-text-secondary);margin-bottom:20px">points</div>

                    <div style="font-size:2.2rem;font-weight:800;color:var(--fo-text);margin-bottom:4px">{{ pack.priceLabel }}</div>
                    <div style="font-size:0.78rem;color:var(--fo-text-secondary);margin-bottom:24px">
                        {{ (pack.price / points * 100)|round(1) }} centimes / point
                    </div>

                    <form method="POST" action="{{ path('app_points_checkout') }}">
                        <input type="hidden" name="points" value="{{ points }}">
                        <button type="submit" style="width:100%;padding:14px;border:none;border-radius:12px;font-weight:700;font-size:0.95rem;cursor:pointer;transition:all 0.2s;{{ pack.popular ? 'background:linear-gradient(135deg,' ~ pack.color ~ ',#7c3aed);color:white;box-shadow:0 4px 16px rgba(79,70,229,0.3)' : 'background:var(--fo-bg-section);color:var(--fo-text);border:1.5px solid var(--fo-border)' }}" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='none'">
                            <i class="bi bi-credit-card me-2"></i>Acheter
                        </button>
                    </form>
                </div>
            </div>
            {% endfor %}
        </div>

        {# ── How It Works ── #}
        <div style="background:var(--fo-bg-section);border-radius:20px;padding:32px;margin-bottom:32px">
            <h5 style="font-weight:800;margin-bottom:20px;text-align:center"><i class="bi bi-lightbulb me-2" style="color:#f59e0b"></i>Comment ça marche ?</h5>
            <div class="row g-4">
                <div class="col-md-4 text-center">
                    <div style="width:56px;height:56px;border-radius:14px;background:linear-gradient(135deg,#4f46e5,#7c3aed);display:inline-flex;align-items:center;justify-content:center;margin-bottom:12px">
                        <i class="bi bi-cart-check" style="font-size:1.3rem;color:white"></i>
                    </div>
                    <h6 style="font-weight:700;font-size:0.9rem">1. Achetez un pack</h6>
                    <p style="font-size:0.82rem;color:var(--fo-text-secondary);margin:0">Choisissez un pack et payez en toute sécurité via Stripe</p>
                </div>
                <div class="col-md-4 text-center">
                    <div style="width:56px;height:56px;border-radius:14px;background:linear-gradient(135deg,#06b6d4,#0ea5e9);display:inline-flex;align-items:center;justify-content:center;margin-bottom:12px">
                        <i class="bi bi-book" style="font-size:1.3rem;color:white"></i>
                    </div>
                    <h6 style="font-weight:700;font-size:0.9rem">2. Inscrivez-vous</h6>
                    <p style="font-size:0.82rem;color:var(--fo-text-secondary);margin:0">Utilisez vos points pour accéder aux formations payantes</p>
                </div>
                <div class="col-md-4 text-center">
                    <div style="width:56px;height:56px;border-radius:14px;background:linear-gradient(135deg,#10b981,#059669);display:inline-flex;align-items:center;justify-content:center;margin-bottom:12px">
                        <i class="bi bi-trophy" style="font-size:1.3rem;color:white"></i>
                    </div>
                    <h6 style="font-weight:700;font-size:0.9rem">3. Gagnez des points</h6>
                    <p style="font-size:0.82rem;color:var(--fo-text-secondary);margin:0">Score > 15/20 au quiz = vous gagnez des points bonus !</p>
                </div>
            </div>
        </div>

        {# ── Secure badge ── #}
        <div style="text-align:center;color:var(--fo-text-secondary);font-size:0.8rem">
            <i class="bi bi-shield-lock me-1"></i> Paiement sécurisé par
            <span style="font-weight:700;color:#635bff">Stripe</span>
            — Vos données bancaires ne sont jamais stockées sur nos serveurs
        </div>
    </div>
</section>
{% endblock %}
