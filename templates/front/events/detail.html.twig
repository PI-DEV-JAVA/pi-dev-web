{% extends 'front/_base.html.twig' %}

{% block title %}{{ event.title }} — Talentos{% endblock %}

{% block content %}
<div class="fo-page-header">
    <div class="container">
        <a href="{{ path('app_events') }}" style="color:var(--primary);text-decoration:none;font-size:0.9rem;font-weight:500">
            <i class="bi bi-arrow-left me-1"></i> Retour aux évènements
        </a>
        <h1 class="mt-2">{{ event.title }}</h1>
        <div class="d-flex gap-2 mt-2">
            <span class="fo-badge fo-badge-{{ event.eventType == 'CONFERENCE' ? 'primary' : (event.eventType == 'WORKSHOP' ? 'warning' : 'accent') }}">{{ event.eventType }}</span>
            {% if event.status %}<span class="fo-badge fo-badge-success">{{ event.status }}</span>{% endif %}
        </div>
    </div>
</div>

<section class="fo-section" style="padding-top:40px">
    <div class="container">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mb-3"><i class="bi bi-check-circle-fill me-2"></i>{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('info') %}
            <div class="alert alert-info mb-3"><i class="bi bi-info-circle-fill me-2"></i>{{ message }}</div>
        {% endfor %}

        <div class="row g-4">
            <div class="col-lg-8">
                {% if event.coverImage %}
                    <img src="{{ event.coverImage }}" alt="{{ event.title }}" style="width:100%;height:300px;object-fit:cover;border-radius:16px;margin-bottom:24px">
                {% endif %}

                <div class="fo-card" style="margin-bottom:20px">
                    <h5 style="font-weight:700;margin-bottom:16px">Description</h5>
                    <div style="color:var(--fo-text-secondary);line-height:1.8;white-space:pre-line">{{ event.description|default('Aucune description.') }}</div>
                </div>

                {# Comments #}
                <div class="fo-card">
                    <h5 style="font-weight:700;margin-bottom:16px">Commentaires ({{ comments|length }})</h5>
                    {% if app.user %}
                        <form method="post" action="{{ path('app_event_comment', {id: event.id}) }}" class="fo-form mb-4">
                            <div class="d-flex gap-2">
                                <input type="text" name="content" class="form-control" placeholder="Ajouter un commentaire..." required>
                                <button type="submit" class="btn btn-primary-custom" style="white-space:nowrap"><i class="bi bi-send"></i></button>
                            </div>
                        </form>
                    {% endif %}
                    {% for comment in comments %}
                        <div class="mb-3 p-3" style="background:var(--fo-bg-section);border-radius:12px">
                            <div class="d-flex justify-content-between mb-1">
                                <strong style="font-size:0.85rem">{{ comment.user ? comment.user.email : 'Anonyme' }}</strong>
                                <small style="color:var(--fo-text-secondary)">{{ comment.createdAt ? comment.createdAt|date('d/m/Y H:i') : '' }}</small>
                            </div>
                            <p style="margin:0;font-size:0.9rem;color:var(--fo-text-secondary)">{{ comment.content }}</p>
                        </div>
                    {% else %}
                        <p style="color:var(--fo-text-secondary);font-size:0.9rem">Aucun commentaire pour le moment.</p>
                    {% endfor %}
                </div>
            </div>

            <div class="col-lg-4">
                <div class="fo-card" style="position:sticky;top:100px;margin-bottom:16px">
                    <h5 style="font-weight:700;margin-bottom:20px">Détails</h5>
                    <div class="mb-3">
                        <div style="color:var(--fo-text-secondary);font-size:0.8rem;text-transform:uppercase;margin-bottom:4px">Date</div>
                        <div style="font-weight:600">{{ event.eventDate ? event.eventDate|date('d/m/Y à H:i') : '—' }}</div>
                    </div>
                    {% if event.location %}
                    <div class="mb-3">
                        <div style="color:var(--fo-text-secondary);font-size:0.8rem;text-transform:uppercase;margin-bottom:4px">Lieu</div>
                        <div style="font-weight:600">{{ event.location }}</div>
                    </div>
                    {% endif %}
                    <div class="mb-3">
                        <div style="color:var(--fo-text-secondary);font-size:0.8rem;text-transform:uppercase;margin-bottom:4px">Capacité</div>
                        <div style="font-weight:600">{{ event.maxCapacity ?: 'Illimitée' }}</div>
                    </div>
                    <div class="mb-4">
                        <div style="color:var(--fo-text-secondary);font-size:0.8rem;text-transform:uppercase;margin-bottom:4px">Likes</div>
                        <div style="font-weight:600">{{ likesCount }} <i class="bi bi-heart-fill" style="color:var(--danger)"></i></div>
                    </div>

                    {% if app.user %}
                        <div class="d-grid gap-2">
                            <a href="{{ path('app_event_participate', {id: event.id}) }}" class="btn {{ participation ? 'btn-outline-secondary' : 'btn-primary-custom' }}">
                                <i class="bi bi-{{ participation ? 'x-circle' : 'check-circle' }} me-1"></i>
                                {{ participation ? 'Annuler ma participation' : 'Participer' }}
                            </a>
                            <a href="{{ path('app_event_like', {id: event.id}) }}" class="btn" style="border:1.5px solid var(--fo-border);border-radius:12px;padding:12px;font-weight:600;color:{{ liked ? '#ef4444' : 'var(--fo-text-secondary)' }}">
                                <i class="bi bi-{{ liked ? 'heart-fill' : 'heart' }} me-1"></i>
                                {{ liked ? 'Aimé' : 'Aimer' }}
                            </a>
                        </div>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="btn btn-primary-custom w-100">Connectez-vous pour participer</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
