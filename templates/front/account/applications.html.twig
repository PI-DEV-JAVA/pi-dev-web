{% extends 'front/_base.html.twig' %}

{% block title %}Mes candidatures — Talentos{% endblock %}

{% block content %}
<div class="fo-page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1>Mes candidatures</h1>
                <p>Suivez l'état de vos candidatures en temps réel</p>
            </div>
            <a href="{{ path('app_offers') }}" class="btn btn-primary-custom" style="padding:10px 24px;border-radius:12px;font-weight:600;font-size:0.85rem"><i class="bi bi-search me-1"></i>Explorer les offres</a>
        </div>
    </div>
</div>

<section class="fo-section" style="padding-top:32px">
    <div class="container">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mb-3"><i class="bi bi-check-circle-fill me-2"></i>{{ message }}</div>
        {% endfor %}

        {% if applications is empty %}
            <div class="fo-card text-center" style="padding:60px">
                <div style="width:64px;height:64px;border-radius:50%;background:rgba(79,70,229,0.06);display:inline-flex;align-items:center;justify-content:center;margin-bottom:16px">
                    <i class="bi bi-file-earmark-x" style="font-size:1.5rem;color:var(--primary);opacity:0.5"></i>
                </div>
                <h6 style="font-weight:700">Aucune candidature</h6>
                <p style="color:var(--fo-text-secondary);font-size:0.85rem;margin-bottom:16px">Commencez par explorer les offres disponibles</p>
                <a href="{{ path('app_offers') }}" class="btn btn-primary-custom" style="display:inline-block;width:auto;padding:10px 28px">Voir les offres</a>
            </div>
        {% else %}
            {# Stats summary #}
            <div class="fo-card d-flex flex-wrap gap-4 mb-4" style="padding:16px 24px">
                <div class="d-flex align-items-center gap-2">
                    <div style="width:8px;height:8px;border-radius:50%;background:var(--primary)"></div>
                    <span style="font-size:0.82rem;color:var(--fo-text-secondary)">Total: <strong style="color:var(--fo-text)">{{ applications|length }}</strong></span>
                </div>
                {% set accepted = applications|filter(a => a.status == 'Acceptée')|length %}
                {% set pending = applications|filter(a => a.status == 'En attente' or a.status == 'Soumise')|length %}
                {% set interview = applications|filter(a => a.status == 'Entretien')|length %}
                {% set rejected = applications|filter(a => a.status == 'Refusée')|length %}
                {% if accepted > 0 %}<div class="d-flex align-items-center gap-2"><div style="width:8px;height:8px;border-radius:50%;background:#10b981"></div><span style="font-size:0.82rem;color:var(--fo-text-secondary)">Acceptées: <strong style="color:#10b981">{{ accepted }}</strong></span></div>{% endif %}
                {% if interview > 0 %}<div class="d-flex align-items-center gap-2"><div style="width:8px;height:8px;border-radius:50%;background:#06b6d4"></div><span style="font-size:0.82rem;color:var(--fo-text-secondary)">Entretien: <strong style="color:#06b6d4">{{ interview }}</strong></span></div>{% endif %}
                {% if pending > 0 %}<div class="d-flex align-items-center gap-2"><div style="width:8px;height:8px;border-radius:50%;background:#f59e0b"></div><span style="font-size:0.82rem;color:var(--fo-text-secondary)">En cours: <strong style="color:#f59e0b">{{ pending }}</strong></span></div>{% endif %}
                {% if rejected > 0 %}<div class="d-flex align-items-center gap-2"><div style="width:8px;height:8px;border-radius:50%;background:#ef4444"></div><span style="font-size:0.82rem;color:var(--fo-text-secondary)">Refusées: <strong style="color:#ef4444">{{ rejected }}</strong></span></div>{% endif %}
            </div>

            <div class="row g-3">
                {% for app_item in applications %}
                    {% set statusColor = app_item.status == 'Acceptée' ? '#10b981' : (app_item.status == 'Refusée' ? '#ef4444' : (app_item.status == 'Entretien' ? '#06b6d4' : '#f59e0b')) %}
                    {% set statusIcon = app_item.status == 'Acceptée' ? 'check-circle-fill' : (app_item.status == 'Refusée' ? 'x-circle-fill' : (app_item.status == 'Entretien' ? 'camera-video-fill' : 'hourglass-split')) %}
                    <div class="col-md-6">
                        <div class="fo-card" style="border-left:3px solid {{ statusColor }};transition:transform 0.2s" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform=''">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2" style="flex:1;min-width:0">
                                    <div style="width:36px;height:36px;border-radius:10px;background:{{ statusColor }}10;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                        <i class="bi bi-{{ statusIcon }}" style="color:{{ statusColor }};font-size:0.9rem"></i>
                                    </div>
                                    <h6 style="font-weight:700;margin:0;font-size:0.92rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ app_item.offer ? app_item.offer.title : 'Offre supprimée' }}</h6>
                                </div>
                                <span class="fo-badge" style="background:{{ statusColor }}15;color:{{ statusColor }};border:1px solid {{ statusColor }}30;flex-shrink:0;margin-left:8px">
                                    {{ app_item.status }}
                                </span>
                            </div>
                            <div style="color:var(--fo-text-secondary);font-size:0.8rem;display:flex;gap:12px;flex-wrap:wrap;margin-bottom:8px">
                                <span><i class="bi bi-calendar3 me-1"></i>{{ app_item.applicationDate ? app_item.applicationDate|date('d/m/Y') : '—' }}</span>
                                {% if app_item.offer and app_item.offer.contractType %}<span><i class="bi bi-file-text me-1"></i>{{ app_item.offer.contractType }}</span>{% endif %}
                                {% if app_item.offer and app_item.offer.location %}<span><i class="bi bi-geo-alt me-1"></i>{{ app_item.offer.location }}</span>{% endif %}
                            </div>
                            {% if app_item.offer %}
                                <a href="{{ path('app_offer_detail', {id: app_item.offer.id}) }}" style="color:var(--primary);font-size:0.8rem;font-weight:600;text-decoration:none">
                                    Voir l'offre <i class="bi bi-arrow-right"></i>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
