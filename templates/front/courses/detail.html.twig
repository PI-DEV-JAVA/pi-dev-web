{% extends 'front/_base.html.twig' %}

{% block title %}{{ formation.titre }} — Talentos{% endblock %}

{% block content %}
<style>
    .seance-card { background: var(--fo-bg-section, #f8fafc); border-radius: 12px; margin-bottom: 10px; overflow: hidden; border: 1.5px solid transparent; transition: all 0.3s; cursor: pointer; }
    .seance-card:hover { border-color: rgba(79,70,229,0.2); }
    .seance-card.expanded { border-color: rgba(79,70,229,0.3); background: white; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
    .seance-header { padding: 16px; display: flex; align-items: center; gap: 14px; }
    .seance-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1.1rem; }
    .seance-icon.online { background: rgba(79,70,229,0.1); color: var(--primary, #4f46e5); }
    .seance-icon.onsite { background: rgba(245,158,11,0.1); color: #f59e0b; }
    .seance-detail { display: none; padding: 0 16px 16px; animation: slideDown 0.3s ease; }
    .seance-card.expanded .seance-detail { display: block; }
    @keyframes slideDown { from { opacity: 0; max-height: 0; } to { opacity: 1; max-height: 600px; } }
    .seance-meta { display: flex; flex-wrap: wrap; gap: 16px; padding: 12px 14px; background: var(--fo-bg-section, #f1f5f9); border-radius: 10px; margin-bottom: 12px; }
    .seance-meta-item { font-size: 0.8rem; color: #64748b; display: flex; align-items: center; gap: 4px; }
    .seance-type-badge { font-size: 0.7rem; padding: 3px 10px; border-radius: 20px; font-weight: 600; }
    .badge-online { background: rgba(79,70,229,0.1); color: var(--primary, #4f46e5); }
    .badge-onsite { background: rgba(245,158,11,0.1); color: #f59e0b; }
    .chevron-indicator { transition: transform 0.3s; color: #94a3b8; font-size: 0.8rem; }
    .seance-card.expanded .chevron-indicator { transform: rotate(180deg); color: var(--primary, #4f46e5); }
    .video-container { position: relative; padding-bottom: 56.25%; height: 0; border-radius: 10px; overflow: hidden; margin-top: 8px; }
    .video-container iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
</style>

<div class="fo-page-header">
    <div class="container">
        <a href="{{ path('app_courses') }}" style="color:var(--primary);text-decoration:none;font-size:0.9rem;font-weight:500">
            <i class="bi bi-arrow-left me-1"></i> Retour aux formations
        </a>
        <h1 class="mt-2">{{ formation.titre }}</h1>
        <div class="d-flex gap-3 mt-2 flex-wrap">
            <span class="fo-badge fo-badge-primary"><i class="bi bi-clock me-1"></i>{{ formation.duree }}h</span>
            <span class="fo-badge fo-badge-accent">{{ formation.niveau ?: 'Tous niveaux' }}</span>
        </div>
    </div>
</div>

<section class="fo-section" style="padding-top:40px">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="fo-card" style="margin-bottom:20px">
                    <h5 style="font-weight:700;margin-bottom:16px">Description</h5>
                    <div style="color:var(--fo-text-secondary);line-height:1.8;white-space:pre-line">{{ formation.description|default('Aucune description.') }}</div>
                </div>

                {% if seances|length > 0 %}
                <div class="fo-card" style="margin-bottom:20px">
                    <h5 style="font-weight:700;margin-bottom:16px">
                        <i class="bi bi-collection-play me-2" style="color:var(--primary)"></i>Séances ({{ seances|length }})
                    </h5>
                    {% for s in seances %}
                        <div class="seance-card" onclick="toggleSeance(this)">
                            <div class="seance-header">
                                <div class="seance-icon {{ s.type == 'EN_LIGNE' ? 'online' : 'onsite' }}">
                                    <i class="bi {{ s.type == 'EN_LIGNE' ? 'bi-camera-video-fill' : 'bi-building' }}"></i>
                                </div>
                                <div style="flex:1;min-width:0">
                                    <div style="font-weight:600;font-size:0.95rem">{{ s.titre }}</div>
                                    <div style="font-size:0.8rem;color:#64748b;margin-top:2px">
                                        {{ s.dateDebut|date('d/m/Y') }} · {{ s.dateDebut|date('H:i') }} → {{ s.dateFin|date('H:i') }}
                                    </div>
                                </div>
                                <span class="seance-type-badge {{ s.type == 'EN_LIGNE' ? 'badge-online' : 'badge-onsite' }}">
                                    {{ s.type == 'EN_LIGNE' ? '🖥 En ligne' : '📍 Présentiel' }}
                                </span>
                                <i class="bi bi-chevron-down chevron-indicator"></i>
                            </div>

                            <div class="seance-detail">
                                <div class="seance-meta">
                                    <div class="seance-meta-item"><i class="bi bi-calendar3"></i> {{ s.dateDebut|date('l d F Y') }}</div>
                                    <div class="seance-meta-item"><i class="bi bi-clock"></i> {{ s.dateDebut|date('H:i') }} — {{ s.dateFin|date('H:i') }}</div>
                                    {% if s.dureeMinutes %}<div class="seance-meta-item"><i class="bi bi-hourglass-split"></i> {{ s.dureeMinutes }} minutes</div>{% endif %}
                                    {% if s.adresse %}<div class="seance-meta-item"><i class="bi bi-geo-alt"></i> {{ s.adresse }}</div>{% endif %}
                                </div>

                                {% if s.type == 'EN_LIGNE' and s.videoPath %}
                                    <div style="margin-top:8px">
                                        <div style="font-weight:600;font-size:0.85rem;margin-bottom:8px;color:var(--primary)">
                                            <i class="bi bi-play-circle-fill me-1"></i> Vidéo de la séance
                                        </div>
                                        <div class="video-container" data-video-url="{{ s.videoPath }}">
                                            {# Filled by JS to extract YouTube embed #}
                                        </div>
                                    </div>
                                {% elseif s.type == 'EN_LIGNE' and not s.videoPath %}
                                    <div style="text-align:center;padding:24px;background:var(--fo-bg-section, #f1f5f9);border-radius:10px;margin-top:8px">
                                        <i class="bi bi-camera-video" style="font-size:1.5rem;color:#94a3b8;display:block;margin-bottom:6px"></i>
                                        <span style="font-size:0.85rem;color:#94a3b8">La vidéo sera disponible prochainement</span>
                                    </div>
                                {% elseif s.type == 'PRESENTIEL' and s.adresse %}
                                    <div style="padding:12px;background:var(--fo-bg-section, #f1f5f9);border-radius:10px;margin-top:8px">
                                        <div style="font-weight:600;font-size:0.85rem;margin-bottom:4px;color:#f59e0b">
                                            <i class="bi bi-pin-map-fill me-1"></i> Lieu de la séance
                                        </div>
                                        <div style="font-size:0.9rem;color:#334155">{{ s.adresse }}</div>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
                {% endif %}

                {% if quizzes|length > 0 %}
                <div class="fo-card">
                    <h5 style="font-weight:700;margin-bottom:16px">Quiz disponibles</h5>
                    {% for quiz in quizzes %}
                        <a href="{{ path('app_quiz', {id: quiz.id}) }}" class="d-flex align-items-center gap-3 p-3 mb-2 text-decoration-none" style="background:var(--fo-bg-section);border-radius:10px;transition:all 0.2s">
                            <div style="width:36px;height:36px;border-radius:8px;background:rgba(245,158,11,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                <i class="bi bi-lightbulb" style="color:var(--warning)"></i>
                            </div>
                            <div style="flex:1">
                                <div style="font-weight:600;font-size:0.9rem;color:var(--fo-text)">{{ quiz.titre }}</div>
                            </div>
                            <span class="fo-badge fo-badge-warning">Passer le quiz</span>
                        </a>
                    {% endfor %}
                </div>
                {% endif %}
            </div>

            <div class="col-lg-4">
                <div class="fo-card" style="position:sticky;top:100px">
                    <h5 style="font-weight:700;margin-bottom:20px">Informations</h5>
                    <div class="mb-3">
                        <div style="color:var(--fo-text-secondary);font-size:0.8rem;text-transform:uppercase;margin-bottom:4px">Durée</div>
                        <div style="font-weight:600">{{ formation.duree }} heures</div>
                    </div>
                    <div class="mb-3">
                        <div style="color:var(--fo-text-secondary);font-size:0.8rem;text-transform:uppercase;margin-bottom:4px">Niveau</div>
                        <div style="font-weight:600">{{ formation.niveau ?: 'Tous niveaux' }}</div>
                    </div>
                    {% if formation.dateDebut %}
                    <div class="mb-3">
                        <div style="color:var(--fo-text-secondary);font-size:0.8rem;text-transform:uppercase;margin-bottom:4px">Date de début</div>
                        <div style="font-weight:600">{{ formation.dateDebut|date('d/m/Y') }}</div>
                    </div>
                    {% endif %}
                    <div class="mb-3">
                        <div style="color:var(--fo-text-secondary);font-size:0.8rem;text-transform:uppercase;margin-bottom:4px">Séances</div>
                        <div style="font-weight:600">{{ seances|length }}</div>
                    </div>
                    <div>
                        <div style="color:var(--fo-text-secondary);font-size:0.8rem;text-transform:uppercase;margin-bottom:4px">Quiz</div>
                        <div style="font-weight:600">{{ quizzes|length }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
function toggleSeance(card) { card.classList.toggle('expanded'); }

// Auto-embed YouTube videos
function getYouTubeId(url) {
    var m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([a-zA-Z0-9_-]{11})/);
    return m ? m[1] : null;
}

document.querySelectorAll('.video-container[data-video-url]').forEach(function(container) {
    var url = container.getAttribute('data-video-url');
    var ytId = getYouTubeId(url);
    if (ytId) {
        container.innerHTML = '<iframe src="https://www.youtube.com/embed/' + ytId + '" frameborder="0" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>';
    } else {
        container.innerHTML = '<a href="' + url + '" target="_blank" style="display:flex;align-items:center;justify-content:center;padding:30px;background:var(--fo-bg-section, #f1f5f9);border-radius:10px;text-decoration:none;color:var(--primary);font-weight:600"><i class="bi bi-box-arrow-up-right me-2"></i>Ouvrir la vidéo</a>';
        container.style.paddingBottom = '0';
        container.style.height = 'auto';
    }
});
</script>
{% endblock %}
