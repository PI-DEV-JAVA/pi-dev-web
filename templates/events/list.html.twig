{% extends 'base.html.twig' %}
{% from 'components/_sidebar.html.twig' import sidebar %}

{% block title %}Évènements — Talentos{% endblock %}

{% block body %}
{{ sidebar(app.user) }}

<main class="app-main">
    <div class="page-header">
        <h2>Évènements 🎫</h2>
        <p>Rejoignez des meetups, conférences et workshops</p>
    </div>

    {# Filters #}
    <div class="stat-card" style="margin-bottom:24px;padding:16px 20px">
        <form method="get" class="d-flex gap-3 align-items-end flex-wrap">
            <div style="width:160px">
                <label class="form-label" style="color:var(--text-secondary);font-size:0.8rem">Type</label>
                <select name="type" class="form-select" style="background:var(--bg-input);border-color:var(--border);color:var(--text-primary);border-radius:10px;font-size:0.9rem">
                    <option value="">Tous</option>
                    <option value="MEETUP" {{ typeFilter == 'MEETUP' ? 'selected' }}>Meetup</option>
                    <option value="CONFERENCE" {{ typeFilter == 'CONFERENCE' ? 'selected' }}>Conférence</option>
                    <option value="WORKSHOP" {{ typeFilter == 'WORKSHOP' ? 'selected' }}>Workshop</option>
                    <option value="WEBINAR" {{ typeFilter == 'WEBINAR' ? 'selected' }}>Webinaire</option>
                </select>
            </div>
            <div style="width:160px">
                <label class="form-label" style="color:var(--text-secondary);font-size:0.8rem">Statut</label>
                <select name="status" class="form-select" style="background:var(--bg-input);border-color:var(--border);color:var(--text-primary);border-radius:10px;font-size:0.9rem">
                    <option value="">Tous</option>
                    <option value="UPCOMING" {{ statusFilter == 'UPCOMING' ? 'selected' }}>À venir</option>
                    <option value="ONGOING" {{ statusFilter == 'ONGOING' ? 'selected' }}>En cours</option>
                    <option value="COMPLETED" {{ statusFilter == 'COMPLETED' ? 'selected' }}>Terminé</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary-custom" style="width:auto;padding:8px 18px;height:42px;border-radius:10px">
                Filtrer
            </button>
        </form>
    </div>

    {% if events is empty %}
        <div class="stat-card text-center" style="padding:60px">
            <i class="bi bi-calendar-x" style="font-size:3rem;color:var(--text-secondary)"></i>
            <p class="mt-3" style="color:var(--text-secondary)">Aucun évènement trouvé.</p>
        </div>
    {% else %}
        <div class="row g-4">
            {% for event in events %}
                <div class="col-md-6 col-lg-4">
                    <a href="{{ path('app_event_detail', {id: event.id}) }}" class="text-decoration-none">
                        <div class="stat-card h-100" style="cursor:pointer">
                            {% if event.coverImage %}
                                <img src="{{ event.coverImage }}" alt="{{ event.title }}"
                                     style="width:100%;height:140px;object-fit:cover;border-radius:12px;margin-bottom:12px">
                            {% else %}
                                <div style="width:100%;height:140px;border-radius:12px;margin-bottom:12px;
                                            background:linear-gradient(135deg,rgba(245,158,11,0.2),rgba(239,68,68,0.15));
                                            display:flex;align-items:center;justify-content:center">
                                    <i class="bi bi-calendar-event" style="font-size:2.5rem;color:var(--warning)"></i>
                                </div>
                            {% endif %}

                            <div class="d-flex align-items-center gap-2 mb-2">
                                {% if event.eventType %}
                                    <span class="badge" style="background:rgba(245,158,11,0.15);color:var(--warning);padding:3px 8px;border-radius:5px;font-size:0.7rem">
                                        {{ event.eventType }}
                                    </span>
                                {% endif %}
                                {% if event.status %}
                                    <span class="badge" style="background:{{ event.status == 'UPCOMING' ? 'rgba(6,182,212,0.15)' : (event.status == 'ONGOING' ? 'rgba(16,185,129,0.15)' : 'rgba(148,163,184,0.15)') }};
                                                               color:{{ event.status == 'UPCOMING' ? 'var(--accent)' : (event.status == 'ONGOING' ? 'var(--success)' : 'var(--text-secondary)') }};
                                                               padding:3px 8px;border-radius:5px;font-size:0.7rem">
                                        {{ event.status }}
                                    </span>
                                {% endif %}
                            </div>

                            <h6 style="font-weight:600;color:var(--text-primary);margin-bottom:8px">{{ event.title }}</h6>

                            <div style="font-size:0.8rem;color:var(--text-secondary)">
                                <div class="mb-1"><i class="bi bi-calendar3 me-1"></i>{{ event.eventDate ? event.eventDate|date('d/m/Y H:i') : '—' }}</div>
                                {% if event.location %}
                                    <div><i class="bi bi-geo-alt me-1"></i>{{ event.location }}</div>
                                {% endif %}
                            </div>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</main>
{% endblock %}
