{% extends 'front/_base.html.twig' %}

{% block title %}Formations — Talentos{% endblock %}

{% block content %}
<div class="fo-page-header">
    <div class="container">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:16px">
            <div>
                <h1>Formations 📚</h1>
                <p>Développez vos compétences avec nos cours</p>
            </div>
            {% if app.user and app.user.role == 'CANDIDATE' %}
                <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
                    <a href="{{ path('app_analytics') }}"
                       style="display:inline-flex;align-items:center;gap:8px;background:rgba(99,102,241,0.2);backdrop-filter:blur(8px);color:#fff;padding:10px 18px;border-radius:12px;text-decoration:none;font-weight:700;font-size:0.88rem;border:1px solid rgba(255,255,255,0.2);transition:all 0.2s;white-space:nowrap"
                       onmouseover="this.style.background='rgba(99,102,241,0.35)'" onmouseout="this.style.background='rgba(99,102,241,0.2)'">
                        <i class="bi bi-graph-up-arrow"></i> Mes analytiques
                    </a>
                    <a href="{{ path('app_my_formations') }}"
                       style="display:inline-flex;align-items:center;gap:8px;background:rgba(16,185,129,0.2);backdrop-filter:blur(8px);color:#fff;padding:10px 18px;border-radius:12px;text-decoration:none;font-weight:700;font-size:0.88rem;border:1px solid rgba(255,255,255,0.2);transition:all 0.2s;white-space:nowrap"
                       onmouseover="this.style.background='rgba(16,185,129,0.35)'" onmouseout="this.style.background='rgba(16,185,129,0.2)'">
                        <i class="bi bi-bookmark-heart-fill"></i> Mes formations
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<section class="fo-section" style="padding-top:40px">
    <div class="container">
        {% if formations is empty %}
            <div class="fo-card text-center" style="padding:60px">
                <i class="bi bi-book" style="font-size:3rem;color:var(--fo-text-secondary)"></i>
                <p class="mt-3" style="color:var(--fo-text-secondary)">Aucune formation disponible.</p>
            </div>
        {% else %}
            <div class="row g-4">
                {% for f in formations %}
                    {% set enrollStatus = enrollments[f.id] ?? null %}
                    <div class="col-md-6 col-lg-4">
                        <a href="{{ path('app_course_detail', {id: f.id}) }}" class="text-decoration-none">
                            <div class="fo-card h-100" style="cursor:pointer;position:relative">
                                {# Enrollment status badge #}
                                {% if enrollStatus %}
                                    <div style="position:absolute;top:12px;right:12px;z-index:1">
                                        {% if enrollStatus == 'APPROVED' %}
                                            <span style="background:#10b981;color:#fff;padding:3px 10px;border-radius:20px;font-size:0.7rem;font-weight:700"><i class="bi bi-check-circle-fill me-1"></i>Inscrit</span>
                                        {% elseif enrollStatus == 'PENDING' %}
                                            <span style="background:#f59e0b;color:#fff;padding:3px 10px;border-radius:20px;font-size:0.7rem;font-weight:700"><i class="bi bi-hourglass-split me-1"></i>En attente</span>
                                        {% else %}
                                            <span style="background:#ef4444;color:#fff;padding:3px 10px;border-radius:20px;font-size:0.7rem;font-weight:700"><i class="bi bi-x-circle-fill me-1"></i>Refusé</span>
                                        {% endif %}
                                    </div>
                                {% endif %}
                                <div style="width:100%;height:140px;border-radius:12px;margin-bottom:16px;background:linear-gradient(135deg,#eef2ff,#fef3c7);display:flex;align-items:center;justify-content:center">
                                    <i class="bi bi-book" style="font-size:2.5rem;color:var(--primary);opacity:0.6"></i>
                                </div>
                                <h5 style="font-weight:700;color:var(--fo-text);margin-bottom:8px">{{ f.titre }}</h5>
                                <div style="font-size:0.85rem;color:var(--fo-text-secondary)">
                                    <span class="me-3"><i class="bi bi-clock me-1"></i>{{ f.duree }}h</span>
                                    <span><i class="bi bi-bar-chart me-1"></i>{{ f.niveau ?: 'Tous niveaux' }}</span>
                                </div>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
