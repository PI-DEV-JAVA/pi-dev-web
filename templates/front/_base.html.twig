        <div class="fo-footer-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>© 2026 Talentos. Tous droits réservés.</span>
            <div class="d-flex gap-3">
                <a href="#" style="margin:0">Confidentialité</a>
                <a href="#" style="margin:0">Conditions</a>
            </div>
        </div>
    </div>
</footer>

{# ── Navbar Scroll Effect ── #}
{% block javascripts %}
<script>
    const nav = document.getElementById('foNavbar');
    window.addEventListener('scroll', () => {
        nav.classList.toggle('scrolled', window.scrollY > 30);
    });
    if (window.scrollY > 30) nav.classList.add('scrolled');

    // ── Notification Panel ──
    const notifBellBtn = document.getElementById('notifBellBtn');
    const notifPanel = document.getElementById('notifPanel');
    const notifOverlay = document.getElementById('notifOverlay');
    const notifPanelBody = document.getElementById('notifPanelBody');
    let notifLoaded = false;

    function toggleNotifPanel() {
        const isOpen = notifPanel?.classList.toggle('open');
        notifOverlay?.classList.toggle('open', isOpen);
        if (isOpen && !notifLoaded) loadNotifications();
    }
    notifBellBtn?.addEventListener('click', toggleNotifPanel);
    notifOverlay?.addEventListener('click', () => {
        notifPanel?.classList.remove('open');
        notifOverlay?.classList.remove('open');
    });

    const notifTypeConfig = {
        OFFER_DECISION: { icon: 'briefcase', bg: 'rgba(16,185,129,0.1)', color: '#10b981' },
        REPLY: { icon: 'chat-dots', bg: 'rgba(6,182,212,0.1)', color: '#06b6d4' },
        INTERVIEW: { icon: 'camera-video', bg: 'rgba(245,158,11,0.1)', color: '#f59e0b' },
        ACTIVITY: { icon: 'clipboard-data', bg: 'rgba(99,102,241,0.1)', color: '#818cf8' },
        EVENT: { icon: 'calendar-event', bg: 'rgba(236,72,153,0.1)', color: '#ec4899' },
        GENERAL: { icon: 'bell', bg: 'rgba(79,70,229,0.1)', color: '#4f46e5' }
    };

    function loadNotifications() {
        fetch('/notifications?_format=panel')
            .then(r => r.text())
            .then(html => {
                // Parse the full page to extract notification data
                // We'll use the count endpoint and build UI from it
                notifLoaded = true;
            }).catch(() => {});
        // Use a simpler approach: fetch from a JSON endpoint
        fetch('/notifications/list')
            .then(r => r.json())
            .then(items => {
                if (!notifPanelBody) return;
                if (items.length === 0) {
                    notifPanelBody.innerHTML = '<div style="padding:40px 20px;text-align:center;color:#94a3b8"><i class="bi bi-bell-slash" style="font-size:2rem;opacity:0.4"></i><p style="margin:12px 0 0;font-size:0.85rem">Aucune notification</p></div>';
                    return;
                }
                notifPanelBody.innerHTML = items.slice(0, 8).map(n => {
                    const cfg = notifTypeConfig[n.type] || notifTypeConfig.GENERAL;
                    const timeAgo = formatTimeAgo(n.createdAt);
                    return `<a href="/notifications/${n.id}/read" class="notif-item ${n.isRead ? '' : 'unread'}">
                        <div class="notif-icon" style="background:${cfg.bg};color:${cfg.color}"><i class="bi bi-${cfg.icon}"></i></div>
                        <div style="flex:1;min-width:0">
                            <div style="font-weight:${n.isRead ? 500 : 700};font-size:0.85rem;line-height:1.3">${n.title}</div>
                            ${n.message ? `<div style="font-size:0.8rem;color:#94a3b8;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${n.message}</div>` : ''}
                            <div style="font-size:0.72rem;color:#94a3b8;margin-top:4px">${timeAgo}</div>
                        </div>
                    </a>`;
                }).join('');
                notifLoaded = true;
            }).catch(() => {
                if (notifPanelBody) notifPanelBody.innerHTML = '<div style="padding:30px;text-align:center;color:#94a3b8;font-size:0.85rem">Impossible de charger</div>';
            });
    }

    function formatTimeAgo(dateStr) {
        const d = new Date(dateStr);
        const now = new Date();
        const diff = Math.floor((now - d) / 1000);
        if (diff < 60) return "À l'instant";
        if (diff < 3600) return Math.floor(diff/60) + ' min';
        if (diff < 86400) return Math.floor(diff/3600) + ' h';
        if (diff < 604800) return Math.floor(diff/86400) + ' j';
        return d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
    }

    // Badge polling
    function updateNotifBadge() {
        fetch('/notifications/count')
            .then(r => r.json())
            .then(data => {
                const badge = document.getElementById('notifBadge');
                if (badge) {
                    if (data.count > 0) {
                        badge.textContent = data.count > 9 ? '9+' : data.count;
                        badge.style.display = 'flex';
                    } else {
                        badge.style.display = 'none';
                    }
                }
            }).catch(() => {});
    }
    updateNotifBadge();
    setInterval(() => { updateNotifBadge(); notifLoaded = false; }, 30000);

    // ── Chat Widget ──
    const chatFab = document.getElementById('chatFab');
    const chatWidget = document.getElementById('chatWidget');
    const chatToggleNav = document.getElementById('chatToggleNav');
    function toggleChat() {
        chatWidget?.classList.toggle('open');
    }
    chatFab?.addEventListener('click', toggleChat);
    chatToggleNav?.addEventListener('click', toggleChat);
</script>
{% endblock %}
{% endblock %}
