{% extends 'front/_base.html.twig' %}

{% block title %}Formations — Talentos{% endblock %}

{% block content %}
<style>
    .courses-grid .fo-card { cursor: pointer; }
    .courses-grid .fo-card:hover { transform: translateY(-6px); }
    .course-img { width:100%; height:180px; object-fit:cover; border-radius:12px 12px 0 0; margin:-24px -24px 16px; width:calc(100% + 48px); }
    .course-img-placeholder { width:calc(100% + 48px); height:180px; margin:-24px -24px 16px; border-radius:12px 12px 0 0;
        background:linear-gradient(135deg,rgba(79,70,229,0.12),rgba(6,182,212,0.08));
        display:flex;align-items:center;justify-content:center; }
    .price-badge { display:inline-flex;align-items:center;gap:4px;padding:4px 12px;border-radius:50px;font-size:0.75rem;font-weight:700;letter-spacing:0.3px; }
    .price-free { background:rgba(16,185,129,0.12);color:#059669; }
    .price-paid { background:rgba(245,158,11,0.12);color:#d97706; }
    .enroll-badge { display:inline-block;padding:5px 14px;border-radius:50px;font-size:0.75rem;font-weight:600; }
    .filter-bar { background:white;border:1px solid var(--fo-border);border-radius:14px;padding:18px 24px;margin-bottom:32px;box-shadow:var(--fo-card-shadow); }
    .filter-select { border:1.5px solid var(--fo-border);border-radius:10px;padding:8px 14px;font-size:0.85rem;
                     color:var(--fo-text);background:white;cursor:pointer;transition:border-color 0.2s; }
    .filter-select:focus { outline:none;border-color:var(--primary); }
    .balance-pill { display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,rgba(79,70,229,0.08),rgba(6,182,212,0.06));
                    border:1px solid rgba(79,70,229,0.2);border-radius:50px;padding:8px 18px; }
</style>

{# ── Page Header ── #}
<div class="fo-page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h1>Nos Formations </h1>
                <p>Développez vos compétences avec nos programmes certifiants</p>
            </div>
            {% if app.user and app.user.role == 'CANDIDATE' %}
            <div class="d-flex align-items-center gap-3 mt-2">
                <div class="balance-pill">
                    <i class="bi bi-coin" style="color:#f59e0b;font-size:1.1rem"></i>
                    <div>
                        <div style="font-size:0.68rem;color:var(--fo-text-secondary);text-transform:uppercase;letter-spacing:1px">Mon solde</div>
                        <div style="font-weight:800;color:var(--fo-text);font-size:0.95rem">{{ pointsBalance }} pts</div>
                    </div>
                </div>
                <a href="{{ path('app_points_buy') }}"
                   style="display:inline-flex;align-items:center;gap:6px;background:linear-gradient(135deg,#f59e0b,#d97706);
                          color:white;border-radius:10px;padding:9px 18px;font-size:0.85rem;font-weight:700;text-decoration:none;
                          transition:opacity 0.2s;box-shadow:0 4px 12px rgba(245,158,11,0.3)"
                   onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">
                    <i class="bi bi-plus-circle"></i>Acheter des points
                </a>
            </div>
            {% endif %}
        </div>
    </div>
</div>

<section class="fo-section" style="padding-top:40px">
    <div class="container">

        {# ── Flash Messages ── #}
        {% for msg in app.flashes('success') %}
            <div style="background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.25);border-radius:12px;padding:12px 18px;margin-bottom:16px;color:#047857;font-size:0.88rem">
                <i class="bi bi-check-circle-fill me-2"></i>{{ msg }}
            </div>
        {% endfor %}
        {% for msg in app.flashes('danger') %}
            <div style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.25);border-radius:12px;padding:12px 18px;margin-bottom:16px;color:#dc2626;font-size:0.88rem">
                <i class="bi bi-exclamation-circle-fill me-2"></i>{{ msg }}
            </div>
        {% endfor %}

        {# ── Filter Bar ── #}
        <div class="filter-bar d-flex flex-wrap align-items-center gap-3">
            <form method="GET" class="d-flex flex-wrap align-items-center gap-3 flex-grow-1">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-sort-down" style="color:var(--fo-text-secondary);font-size:1rem"></i>
                    <select name="sort" class="filter-select" onchange="this.form.submit()">
                        <option value="date"        {{ sort == 'date'        ? 'selected' : '' }}>Récents en premier</option>
                        <option value="name"        {{ sort == 'name'        ? 'selected' : '' }}>Nom A → Z</option>
                        <option value="price"       {{ sort == 'price'       ? 'selected' : '' }}>Gratuit d'abord</option>
                    </select>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-funnel" style="color:var(--fo-text-secondary);font-size:1rem"></i>
                    <select name="type" class="filter-select" onchange="this.form.submit()">
                        <option value=""     {{ type == ''     ? 'selected' : '' }}>Toutes les formations</option>
                        <option value="free" {{ type == 'free' ? 'selected' : '' }}>🎁 Gratuites uniquement</option>
                        <option value="paid" {{ type == 'paid' ? 'selected' : '' }}>🪙 Payantes uniquement</option>
                    </select>
                </div>
            </form>
            <span style="font-size:0.82rem;color:var(--fo-text-secondary);white-space:nowrap">
                <strong>{{ formations|length }}</strong> formation(s) trouvée(s)
            </span>
        </div>

        {% if formations is empty %}
            <div style="text-align:center;padding:80px 24px;background:white;border:1px solid var(--fo-border);border-radius:16px">
                <i class="bi bi-mortarboard" style="font-size:3.5rem;color:#cbd5e1;display:block;margin-bottom:16px"></i>
                <h5 style="font-weight:700;color:var(--fo-text)">Aucune formation trouvée</h5>
                <p style="color:var(--fo-text-secondary)">Essayez de modifier vos filtres.</p>
            </div>
        {% else %}
            <div class="row g-4 courses-grid">
                {% for f in formations %}
                    <div class="col-md-6 col-lg-4">
                        <a href="{{ path('app_course_detail', {id: f.id}) }}" class="text-decoration-none d-block h-100">
                            <div class="fo-card h-100" style="padding-top:0;overflow:hidden;border-radius:16px">

                                {# Cover image or placeholder #}
                                {% if f.image %}
                                    <div style="position:relative">
                                        <img src="{{ asset('uploads/formations/' ~ f.image) }}"
                                             alt="{{ f.titre }}"
                                             class="course-img">
                                        <div style="position:absolute;top:12px;right:12px">
                                            {% if f.isPaid %}
                                                <span style="background:rgba(217,119,6,0.92);color:white;padding:4px 12px;border-radius:20px;font-size:0.72rem;font-weight:700;backdrop-filter:blur(4px)">
                                                    🪙 {{ f.pricePoints }} pts
                                                </span>
                                            {% else %}
                                                <span style="background:rgba(5,150,105,0.92);color:white;padding:4px 12px;border-radius:20px;font-size:0.72rem;font-weight:700;backdrop-filter:blur(4px)">
                                                    🎁 Gratuit
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="course-img-placeholder" style="position:relative">
                                        <i class="bi bi-book-fill" style="font-size:3rem;color:rgba(79,70,229,0.3)"></i>
                                        <div style="position:absolute;top:12px;right:12px">
                                            {% if f.isPaid %}
                                                <span style="background:rgba(217,119,6,0.92);color:white;padding:4px 12px;border-radius:20px;font-size:0.72rem;font-weight:700">
                                                    🪙 {{ f.pricePoints }} pts
                                                </span>
                                            {% else %}
                                                <span style="background:rgba(5,150,105,0.92);color:white;padding:4px 12px;border-radius:20px;font-size:0.72rem;font-weight:700">
                                                    🎁 Gratuit
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endif %}

                                <div style="padding:20px">
                                    <h5 style="font-weight:700;color:var(--fo-text);margin-bottom:8px;line-height:1.3">{{ f.titre }}</h5>
                                    <p style="color:var(--fo-text-secondary);font-size:0.85rem;line-height:1.6;margin-bottom:14px;
                                               display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
                                        {{ f.description|default('Aucune description.')|striptags|slice(0,110) }}
                                    </p>

                                    <div class="d-flex gap-2 flex-wrap mb-3">
                                        {% if f.niveau %}
                                            <span class="fo-badge fo-badge-primary">{{ f.niveau }}</span>
                                        {% endif %}
                                        {% if f.duree %}
                                            <span class="fo-badge fo-badge-accent"><i class="bi bi-clock me-1"></i>{{ f.duree }}h</span>
                                        {% endif %}
                                        <span class="fo-badge" style="background:rgba(148,163,184,0.1);color:#64748b">
                                            <i class="bi bi-people me-1"></i>{{ enrollmentCounts[f.id] ?? 0 }} inscrits
                                        </span>
                                    </div>

                                    {# Enrollment status badge for candidate #}
                                    {% if app.user and app.user.role == 'CANDIDATE' and enrollments[f.id] is defined %}
                                        {% set st = enrollments[f.id] %}
                                        <div style="display:inline-flex;align-items:center;gap:6px;font-size:0.8rem;font-weight:600;
                                                    padding:6px 14px;border-radius:50px;
                                                    background:{{ st == 'APPROVED' ? 'rgba(16,185,129,0.1)' : (st == 'REJECTED' ? 'rgba(239,68,68,0.1)' : 'rgba(245,158,11,0.1)') }};
                                                    color:{{ st == 'APPROVED' ? '#059669' : (st == 'REJECTED' ? '#dc2626' : '#d97706') }}">
                                            <i class="bi bi-{{ st == 'APPROVED' ? 'check-circle-fill' : (st == 'REJECTED' ? 'x-circle-fill' : 'hourglass-split') }}"></i>
                                            {{ st == 'APPROVED' ? 'Inscrit(e)' : (st == 'REJECTED' ? 'Refusé(e)' : 'En attente') }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
