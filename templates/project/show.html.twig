{# templates/project/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ project.name }} | Talentos{% endblock %}

{% block body %}
<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap">
    <div>
        <a href="{{ path('app_project_index') }}" class="text-decoration-none text-secondary mb-2 d-inline-block">
            <i class="bi bi-arrow-left"></i> Back to projects
        </a>
        <h1 class="display-5 fw-bold mt-2">{{ project.name }}</h1>
    </div>
    <div class="mt-3 mt-sm-0">
        <a href="{{ path('app_project_edit', {'id': project.id}) }}" class="btn btn-outline-primary rounded-pill me-2">
            <i class="bi bi-pencil-square"></i> Edit
        </a>
        <button class="btn btn-outline-danger rounded-pill" data-bs-toggle="modal" data-bs-target="#deleteModal">
            <i class="bi bi-trash"></i> Delete
        </button>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card-modern p-4">
            <h4 class="fw-bold mb-3"><i class="bi bi-info-circle me-2"></i> Description</h4>
            <p class="text-secondary">{{ project.description|default('No description provided for this project.') }}</p>
            
            <hr class="my-4">
            
            <div class="row">
                <div class="col-md-6">
                    <h5 class="fw-semibold mb-3"><i class="bi bi-calendar-range"></i> Timeline</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Start Date:</span>
                        <span class="fw-semibold">{{ project.startDate ? project.startDate|date('F j, Y') : 'Not set' }}</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">End Date:</span>
                        <span class="fw-semibold">{{ project.endDate ? project.endDate|date('F j, Y') : 'Not set' }}</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <h5 class="fw-semibold mb-3"><i class="bi bi-graph-up"></i> Financial</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Budget:</span>
                        <span class="fw-semibold text-success">{{ project.budget ? '$' ~ project.budget|number_format(2) : 'Not set' }}</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Status:</span>
                        {% set statusColors = {
                            'active': 'success',
                            'in_progress': 'primary',
                            'pending': 'warning',
                            'completed': 'info',
                            'on_hold': 'danger'
                        } %}
                        {% set statusColor = statusColors[project.status|lower]|default('secondary') %}
                        <span class="badge bg-{{ statusColor }}">{{ project.status|title }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <div class="card-modern p-4">
            <div class="text-center mb-3">
                <i class="bi bi-activity display-4 text-primary"></i>
                <h5 class="mt-2 fw-bold">Project Activities</h5>
                <p class="small text-muted">{{ project.activities|length }} total time entries</p>
            </div>
            
            {% if project.activities|length > 0 %}
                <div class="list-group list-group-flush">
                    {% for activity in project.activities|slice(0, 3) %}
                        <div class="list-group-item bg-transparent px-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="fw-semibold">{{ activity.activityDate ? activity.activityDate|date('M d, Y') : '—' }}</small>
                                    <br>
                                    <small class="text-muted">{{ activity.hoursWorked }} hours</small>
                                </div>
                                <a href="{{ path('app_activity_show', {'id': activity.id}) }}" class="btn btn-sm btn-link">View</a>
                            </div>
                        </div>
                    {% endfor %}
                    {% if project.activities|length > 3 %}
                        <div class="text-center mt-2">
                            <small class="text-muted">+{{ project.activities|length - 3 }} more activities</small>
                        </div>
                    {% endif %}
                </div>
            {% else %}
                <p class="text-muted text-center small">No activities yet</p>
            {% endif %}
            
            <div class="mt-3">
                <a href="{{ path('app_activity_new') }}?project_id={{ project.id }}" class="btn btn-sm btn-primary rounded-pill w-100">
                    <i class="bi bi-plus-circle"></i> Add Activity
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Delete project</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete "<strong>{{ project.name }}</strong>"? This will also remove all associated activities ({{ project.activities|length }} activities).</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <form method="post" action="{{ path('app_project_delete', {'id': project.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
                    <button class="btn btn-danger rounded-pill px-4">Permanently Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}