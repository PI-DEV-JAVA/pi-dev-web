{% extends 'front/_base.html.twig' %}
{% block title %}Entretiens — Talentos{% endblock %}
{% block content %}
<div class="fo-page-header">
    <div class="container">
        <h1>Mes entretiens 🎥</h1>
        <p>Vos entretiens planifiés</p>
    </div>
</div>
<section class="fo-section" style="padding-top:40px">
    <div class="container">
        
        <!-- Toggle Tabs -->
        <ul class="nav nav-pills mb-4" style="gap:10px">
            <li class="nav-item">
                <button class="nav-link active" onclick="switchView('list')" id="btn-list-view" style="border-radius:24px"><i class="bi bi-list-ul me-2"></i>Liste</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" onclick="switchView('calendar')" id="btn-cal-view" style="border-radius:24px; background:#f1f3f4; color:#333"><i class="bi bi-calendar3 me-2"></i>Calendrier</button>
            </li>
        </ul>

        <div id="view-list">
            <!-- Filter Form -->
            <div class="fo-card mb-4" style="padding:20px">
                <form method="get" action="{{ path('app_interviews') }}" class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label style="font-size:0.85rem;color:var(--fo-text-secondary);margin-bottom:6px">Rechercher</label>
                        <input type="text" name="q" class="fo-input form-control" value="{{ search ?? '' }}" placeholder="Offre ou statut...">
                    </div>
                    <div class="col-md-4">
                        <label style="font-size:0.85rem;color:var(--fo-text-secondary);margin-bottom:6px">Trier par date</label>
                        <select name="sort" class="fo-input form-select">
                            <option value="date_desc" {% if (sort ?? '') == 'date_desc' %}selected{% endif %}>Récent en premier</option>
                            <option value="date_asc" {% if (sort ?? '') == 'date_asc' %}selected{% endif %}>Ancien en premier</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="fo-btn fo-btn-primary w-100">Filtrer</button>
                    </div>
                </form>
            </div>

            {% set upcoming_meets = [] %}
            {% set now_time = 'now'|date('U') %}
            {% for interview in interviews %}
                {% for meet in interview.meets %}
                    {% if meet.meetDate and meet.meetDate|date('U') > now_time %}
                        {% set upcoming_meets = upcoming_meets|merge([meet]) %}
                    {% endif %}
                {% endfor %}
            {% endfor %}

            <!-- Upcoming Widget -->
            {% if upcoming_meets|length > 0 %}
            <h4 class="mb-3" style="font-weight:700">Meets à venir</h4>
            <div class="row g-3 mb-5">
                {% for meet in upcoming_meets %}
                <div class="col-md-4">
                    <div class="fo-card text-center" style="border: 2px solid var(--primary); padding:24px">
                        <div class="mb-2"><span class="fo-badge fo-badge-primary">Bientôt</span></div>
                        <h6 style="font-weight:700" class="mb-1">{{ meet.title }}</h6>
                        <p style="font-size:0.85rem; color:var(--fo-text-secondary)" class="mb-3">
                            {{ meet.interview.application.offer.title }}<br>
                            {{ meet.meetDate|date('d/m/Y à H:i') }}
                        </p>
                        <a href="{{ path('app_meet_room', {'roomId': meet.roomId}) }}" class="fo-btn fo-btn-primary w-100" target="_blank">Rejoindre la visio</a>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% endif %}

            <!-- All Interviews List -->
            <h4 class="mb-3" style="font-weight:700">Historique des entretiens</h4>
            {% if interviews is empty %}
                <div class="fo-card text-center" style="padding:60px">
                    <i class="bi bi-camera-video" style="font-size:3rem;color:var(--fo-text-secondary)"></i>
                    <p class="mt-3" style="color:var(--fo-text-secondary)">Aucun entretien trouvé.</p>
                </div>
            {% else %}
                <div class="row g-4">
                    {% for interview in interviews %}
                        <div class="col-12">
                            <div class="fo-card">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 style="font-weight:700;margin:0">{{ interview.application.offer.title }}</h5>
                                    <span class="fo-badge fo-badge-{{ interview.status == 'COMPLETED' ? 'success' : (interview.status == 'CANCELLED' ? 'warning' : 'primary') }}">{{ interview.status }}</span>
                                </div>
                                <div class="table-responsive mt-3">
                                    <table class="table align-middle" style="color:var(--fo-text);margin:0;font-size:0.9rem">
                                        <thead>
                                            <tr><th>Session</th><th>Date</th><th class="text-end">Statut</th></tr>
                                        </thead>
                                        <tbody>
                                            {% for meet in interview.meets %}
                                                {% set isPast = meet.meetDate and meet.meetDate|date('U') < now_time %}
                                                <tr>
                                                    <td>{{ meet.title }}</td>
                                                    <td>{{ meet.meetDate|date('d/m/Y H:i') }}</td>
                                                    <td class="text-end">
                                                        {% if isPast %}
                                                            <span class="text-muted">Passé</span>
                                                        {% else %}
                                                            <a href="{{ path('app_meet_room', {'roomId': meet.roomId}) }}" class="fo-btn fo-btn-primary" style="padding:4px 10px;font-size:0.75rem" target="_blank">Rejoindre</a>
                                                        {% endif %}
                                                    </td>
                                                </tr>
                                            {% else %}
                                                <tr><td colspan="3" class="text-muted text-center py-2">Aucun meet planifié.</td></tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div id="view-calendar" style="display:none; margin-top:20px;">
            <div class="fo-card" style="padding: 24px">
                <div id="calendar"></div>
            </div>
        </div>
    </div>
</section>

<!-- FullCalendar Integration -->
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
<script>
    let calendar;
    
    document.addEventListener('DOMContentLoaded', function() {
        const calendarEl = document.getElementById('calendar');
        calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            locale: 'fr',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek'
            },
            events: "{{ path('api_meets_candidate') }}",
            eventClick: function(info) {
                if (info.event.url) {
                    window.open(info.event.url, '_blank');
                    info.jsEvent.preventDefault();
                }
            }
        });
    });

    function switchView(view) {
        let btnList = document.getElementById('btn-list-view');
        let btnCal = document.getElementById('btn-cal-view');
        
        if (view === 'calendar') {
            document.getElementById('view-list').style.display = 'none';
            document.getElementById('view-calendar').style.display = 'block';
            calendar.render();
            btnCal.classList.add('active');
            btnCal.style.background = 'var(--primary)';
            btnCal.style.color = '#fff';
            btnList.classList.remove('active');
            btnList.style.background = '#f1f3f4';
            btnList.style.color = '#333';
        } else {
            document.getElementById('view-list').style.display = 'block';
            document.getElementById('view-calendar').style.display = 'none';
            btnList.classList.add('active');
            btnList.style.background = 'var(--primary)';
            btnList.style.color = '#fff';
            btnCal.classList.remove('active');
            btnCal.style.background = '#f1f3f4';
            btnCal.style.color = '#333';
        }
    }
</script>
{% endblock %}
