{# templates/project/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Projects | Talentos{% endblock %}

{% block body %}
<div class="page-header d-flex flex-wrap justify-content-between align-items-center">
    <div>
        <h1 class="display-6 fw-bold mb-0"><i class="bi bi-kanban text-primary me-2"></i> Projects</h1>
        <p class="text-muted mt-1">Manage all your active projects, budgets, and timelines</p>
    </div>
    <a href="{{ path('app_project_new') }}" class="btn btn-primary mt-3 mt-sm-0">
        <i class="bi bi-plus-circle"></i> New Project
    </a>
</div>

<div class="row g-4">
    {% for project in projects %}
        <div class="col-md-6 col-xl-4">
            <div class="card-modern h-100 p-3 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        {% set statusColors = {
                            'active': 'success',
                            'in_progress': 'primary',
                            'pending': 'warning',
                            'completed': 'info',
                            'on_hold': 'danger'
                        } %}
                        {% set statusColor = statusColors[project.status|lower]|default('secondary') %}
                        <span class="badge bg-{{ statusColor }} bg-opacity-10 text-{{ statusColor }} px-3 py-1 rounded-pill fw-semibold">
                            <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> {{ project.status|title }}
                        </span>
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-link text-dark p-0" data-bs-toggle="dropdown">
                            <i class="bi bi-three-dots-vertical fs-5"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm rounded-3">
                            <li><a class="dropdown-item" href="{{ path('app_project_show', {'id': project.id}) }}"><i class="bi bi-eye"></i> View</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_project_edit', {'id': project.id}) }}"><i class="bi bi-pencil"></i> Edit</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#" data-bs-toggle="modal" data-bs-target="#deleteModal{{ project.id }}"><i class="bi bi-trash3"></i> Delete</a></li>
                        </ul>
                    </div>
                </div>
                <h3 class="h5 fw-bold mb-2">{{ project.name }}</h3>
                <p class="text-secondary small mb-3">{{ project.description|default('No description provided')|slice(0, 80) }}{{ project.description|length > 80 ? '…' : '' }}</p>
                
                <div class="mb-3">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span><i class="bi bi-calendar"></i> Start</span>
                        <span><i class="bi bi-calendar-check"></i> End</span>
                    </div>
                    <div class="d-flex justify-content-between small fw-semibold">
                        <span>{{ project.startDate ? project.startDate|date('M d, Y') : '—' }}</span>
                        <span>{{ project.endDate ? project.endDate|date('M d, Y') : '—' }}</span>
                    </div>
                </div>
                
                <div class="mt-auto d-flex justify-content-between align-items-center pt-2">
                    <div>
                        {% if project.budget %}
                            <small class="text-success fw-semibold"><i class="bi bi-currency-dollar"></i> {{ project.budget|number_format(2) }}</small>
                        {% else %}
                            <small class="text-muted">Budget: —</small>
                        {% endif %}
                    </div>
                    <a href="{{ path('app_project_show', {'id': project.id}) }}" class="btn btn-sm btn-outline-primary rounded-pill">Details <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>

        <!-- Delete Modal for each project -->
        <div class="modal fade" id="deleteModal{{ project.id }}" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold">Confirm deletion</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete <strong>{{ project.name }}</strong>? This will also remove all associated activities ({{ project.activities|length }} activities).</p>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <form method="post" action="{{ path('app_project_delete', {'id': project.id}) }}" style="display:inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
                            <button class="btn btn-danger rounded-pill px-4">Delete Project</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12 text-center py-5">
            <div class="card-modern p-5">
                <i class="bi bi-inbox display-1 text-secondary"></i>
                <h3 class="mt-3">No projects yet</h3>
                <p class="text-muted">Get started by creating your first project.</p>
                <a href="{{ path('app_project_new') }}" class="btn btn-primary mt-2 rounded-pill">Create project</a>
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}