{% extends 'back/_base.html.twig' %}
{% block page_title %}Profil — {% if targetUser.profile and targetUser.profile.firstName %}{{ targetUser.profile.firstName }} {{ targetUser.profile.lastName }}{% else %}{{ targetUser.email|split('@')[0] }}{% endif %}{% endblock %}

{% block content %}
<style>
    .up-header {
        background: linear-gradient(135deg, rgba(79,70,229,0.15), rgba(6,182,212,0.08));
        border-radius: 16px; border: 1.5px solid var(--bo-border);
        padding: 28px; display: flex; gap: 24px; align-items: center;
        margin-bottom: 20px;
    }
    .up-avatar {
        width: 80px; height: 80px; border-radius: 16px;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        display: flex; align-items: center; justify-content: center;
        font-weight: 800; font-size: 2rem; color: white; flex-shrink: 0;
        overflow: hidden; border: 3px solid rgba(79,70,229,0.3);
    }
    .up-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .up-name { font-weight: 800; font-size: 1.3rem; color: var(--bo-text); }
    .up-title { font-size: 0.88rem; color: var(--primary-light); font-weight: 600; margin-top: 2px; }
    .up-meta { font-size: 0.8rem; color: var(--bo-text-secondary); margin-top: 4px; display: flex; gap: 16px; flex-wrap: wrap; }
    .up-meta i { margin-right: 4px; }
    .up-actions { margin-left: auto; display: flex; gap: 10px; flex-shrink: 0; }
    .up-btn {
        padding: 10px 20px; border-radius: 10px; font-weight: 600; font-size: 0.85rem;
        border: none; cursor: pointer; text-decoration: none; display: inline-flex;
        align-items: center; gap: 8px; transition: all 0.2s;
    }
    .up-btn.primary { background: linear-gradient(135deg, var(--primary), #6366f1); color: white; }
    .up-btn.primary:hover { transform: translateY(-1px); box-shadow: 0 4px 14px rgba(79,70,229,0.4); color: white; }
    .up-btn.outline { background: transparent; border: 1.5px solid var(--bo-border); color: var(--bo-text-secondary); }
    .up-btn.outline:hover { border-color: var(--primary-light); color: var(--primary-light); }

    .up-section { margin-bottom: 20px; }
    .up-section-title {
        font-weight: 700; font-size: 0.85rem; color: var(--bo-text-secondary);
        text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px;
        padding-bottom: 8px; border-bottom: 1px solid var(--bo-border);
    }
    .up-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
    .up-field {
        background: var(--bo-bg-input); border-radius: 10px; padding: 14px;
        border: 1px solid var(--bo-border);
    }
    .up-field-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--bo-text-secondary); margin-bottom: 4px; font-weight: 600; }
    .up-field-value { font-size: 0.9rem; font-weight: 600; color: var(--bo-text); }

    .up-app-card {
        background: var(--bo-bg-input); border-radius: 10px; padding: 14px 16px;
        border: 1px solid var(--bo-border); display: flex; align-items: center;
        gap: 14px; margin-bottom: 8px;
    }
    .up-app-title { font-weight: 600; font-size: 0.88rem; color: var(--bo-text); }
    .up-app-sub { font-size: 0.78rem; color: var(--bo-text-secondary); margin-top: 2px; }
    .up-status {
        padding: 4px 12px; border-radius: 20px; font-size: 0.72rem; font-weight: 600;
    }
    .up-status.accepted { background: rgba(16,185,129,0.15); color: #34d399; }
    .up-status.rejected { background: rgba(239,68,68,0.15); color: #f87171; }
    .up-status.interview { background: rgba(79,70,229,0.15); color: var(--primary-light); }
    .up-status.pending { background: rgba(245,158,11,0.15); color: #fbbf24; }
</style>

<div class="mb-3">
    <a href="javascript:history.back()" style="color:var(--primary-light);text-decoration:none;font-size:0.85rem">
        <i class="bi bi-arrow-left me-1"></i> Retour
    </a>
</div>

{# ── Profile Header ── #}
<div class="up-header">
    <div class="up-avatar">
        {% if targetUser.profile and targetUser.profile.profilePicturePath %}
            <img src="{{ targetUser.profile.profilePicturePath }}" alt="">
        {% else %}
            {{ targetUser.email|first|upper }}
        {% endif %}
    </div>
    <div>
        <div class="up-name">
            {% if targetUser.profile and targetUser.profile.firstName %}
                {{ targetUser.profile.firstName }} {{ targetUser.profile.lastName }}
            {% else %}
                {{ targetUser.email|split('@')[0] }}
            {% endif %}
        </div>
        {% if targetUser.profile and targetUser.profile.professionalTitle %}
            <div class="up-title">{{ targetUser.profile.professionalTitle }}</div>
        {% endif %}
        <div class="up-meta">
            <span><i class="bi bi-envelope"></i>{{ targetUser.email }}</span>
            {% if targetUser.profile and targetUser.profile.location %}
                <span><i class="bi bi-geo-alt"></i>{{ targetUser.profile.location }}</span>
            {% endif %}
            {% if targetUser.profile and targetUser.profile.phoneNumber %}
                <span><i class="bi bi-phone"></i>{{ targetUser.profile.phoneNumber }}</span>
            {% endif %}
            <span><i class="bi bi-shield-check"></i>{{ targetUser.role }}</span>
            <span><i class="bi bi-calendar3"></i>Inscrit le {{ targetUser.createdAt ? targetUser.createdAt|date('d/m/Y') : '—' }}</span>
        </div>
    </div>
    <div class="up-actions">
        <a href="{{ path('admin_message_candidate', {id: targetUser.id}) }}" class="up-btn primary">
            <i class="bi bi-chat-dots-fill"></i> Message
        </a>
    </div>
</div>

{# ── Profile Details ── #}
{% if targetUser.profile %}
<div class="up-section">
    <div class="up-section-title"><i class="bi bi-person-vcard me-1"></i> Informations du profil</div>
    <div class="up-grid">
        <div class="up-field">
            <div class="up-field-label"><i class="bi bi-person me-1"></i>Nom complet</div>
            <div class="up-field-value">{{ targetUser.profile.firstName ?? '—' }} {{ targetUser.profile.lastName ?? '' }}</div>
        </div>
        <div class="up-field">
            <div class="up-field-label"><i class="bi bi-briefcase me-1"></i>Titre professionnel</div>
            <div class="up-field-value">{{ targetUser.profile.professionalTitle ?? '—' }}</div>
        </div>
        <div class="up-field">
            <div class="up-field-label"><i class="bi bi-geo-alt me-1"></i>Localisation</div>
            <div class="up-field-value">{{ targetUser.profile.location ?? '—' }}</div>
        </div>
        <div class="up-field">
            <div class="up-field-label"><i class="bi bi-phone me-1"></i>Téléphone</div>
            <div class="up-field-value">{{ targetUser.profile.phoneNumber ?? '—' }}</div>
        </div>
        <div class="up-field">
            <div class="up-field-label"><i class="bi bi-hourglass me-1"></i>Expérience</div>
            <div class="up-field-value">{{ targetUser.profile.yearsOfExperience ? targetUser.profile.yearsOfExperience ~ ' ans' : '—' }}</div>
        </div>
    </div>
</div>

{% endif %}

{# ── Applications ── #}
<div class="up-section">
    <div class="up-section-title"><i class="bi bi-file-earmark-text me-1"></i> Candidatures ({{ applications|length }})</div>
    {% if applications|length > 0 %}
        {% for app in applications %}
            <div class="up-app-card">
                <div style="flex:1;min-width:0">
                    <div class="up-app-title">{{ app.offer ? app.offer.title : 'Offre supprimée' }}</div>
                    <div class="up-app-sub">
                        {{ app.applicationDate ? app.applicationDate|date('d/m/Y') : '—' }}
                        {% if app.offer and app.offer.location %} · {{ app.offer.location }}{% endif %}
                        {% if app.score > 0 %} · Score: {{ app.score }}%{% endif %}
                    </div>
                </div>
                <span class="up-status {{ app.status == 'Acceptée' ? 'accepted' : (app.status == 'Refusée' ? 'rejected' : (app.status == 'Entretien' ? 'interview' : 'pending')) }}">
                    {{ app.status }}
                </span>
                {% if app.cvFilePath %}
                    <a href="{{ app.cvFilePath }}" target="_blank" style="color:var(--primary-light);font-size:0.8rem;text-decoration:none;font-weight:600">
                        <i class="bi bi-file-pdf"></i> CV
                    </a>
                {% endif %}
            </div>
        {% endfor %}
    {% else %}
        <div style="text-align:center;padding:30px;color:var(--bo-text-secondary);font-size:0.85rem">
            Aucune candidature trouvée
        </div>
    {% endif %}
</div>
{% endblock %}
