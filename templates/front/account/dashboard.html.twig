{% extends 'front/_base.html.twig' %}
{% block title %}Mon espace — Talentos{% endblock %}
{% block content %}
<div class="fo-page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                {# ── Profile Completion Ring ── #}
                {% set pct = app.user.profile ? app.user.profile.completionPercent : 0 %}
                <div style="position:relative;width:64px;height:64px;flex-shrink:0">
                    <svg width="64" height="64" viewBox="0 0 64 64">
                        <circle cx="32" cy="32" r="28" fill="none" stroke="#e2e8f0" stroke-width="4"/>
                        <circle cx="32" cy="32" r="28" fill="none"
                                stroke="{{ pct >= 100 ? '#10b981' : (pct >= 60 ? '#4f46e5' : '#f59e0b') }}"
                                stroke-width="4" stroke-linecap="round"
                                stroke-dasharray="{{ (pct / 100 * 175.9)|round(1) }} 175.9"
                                transform="rotate(-90 32 32)"
                                style="transition:stroke-dasharray 1s ease"/>
                    </svg>
                    <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:0.7rem;font-weight:800;color:{{ pct >= 100 ? '#10b981' : 'var(--fo-text)' }}">
                        {% if pct >= 100 %}<i class="bi bi-check-lg" style="font-size:1.2rem"></i>{% else %}{{ pct }}%{% endif %}
                    </div>
                </div>
                <div>
                    <h1 style="margin-bottom:2px">Bonjour {{ app.user.profile and app.user.profile.firstName ? app.user.profile.firstName : app.user.email|split('@')[0] }} 👋</h1>
                    <p style="margin:0">
                        {% if pct < 100 %}
                            <a href="{{ path('app_profile_edit') }}" style="color:var(--primary);font-weight:600;text-decoration:none;font-size:0.88rem">
                                <i class="bi bi-pencil me-1"></i>Complétez votre profil ({{ pct }}%)
                            </a>
                        {% else %}
                            Bienvenue dans votre espace personnel
                        {% endif %}
                    </p>
                </div>
            </div>
            <a href="{{ path('app_profile') }}" class="btn btn-primary-custom" style="padding:10px 24px;border-radius:12px;font-weight:600"><i class="bi bi-pencil me-1"></i>Modifier le profil</a>
        </div>
    </div>
</div>

<section class="fo-section" style="padding-top:32px;padding-bottom:32px">
    <div class="container">

        {# ── Analytics Cards Row ── #}
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="fo-card" style="padding:20px;border-left:3px solid var(--primary)">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width:42px;height:42px;border-radius:10px;background:rgba(79,70,229,0.08);display:flex;align-items:center;justify-content:center"><i class="bi bi-file-text" style="font-size:1.1rem;color:var(--primary)"></i></div>
                        <div>
                            <div style="font-size:1.6rem;font-weight:800;color:var(--primary);line-height:1">{{ appCount }}</div>
                            <div style="font-size:0.75rem;color:var(--fo-text-secondary);font-weight:600">Candidatures</div>
                        </div>
                    </div>
                    {% if appCount > 0 %}
                    <div style="display:flex;gap:6px;margin-top:10px;flex-wrap:wrap">
                        <span style="font-size:0.65rem;padding:2px 7px;border-radius:6px;background:rgba(16,185,129,0.1);color:#10b981;font-weight:600">{{ acceptedApps }} acceptées</span>
                        <span style="font-size:0.65rem;padding:2px 7px;border-radius:6px;background:rgba(245,158,11,0.1);color:#f59e0b;font-weight:600">{{ pendingApps }} en cours</span>
                    </div>
                    {% endif %}
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="fo-card" style="padding:20px;border-left:3px solid #06b6d4">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width:42px;height:42px;border-radius:10px;background:rgba(6,182,212,0.08);display:flex;align-items:center;justify-content:center"><i class="bi bi-eye" style="font-size:1.1rem;color:#06b6d4"></i></div>
                        <div>
                            <div style="font-size:1.6rem;font-weight:800;color:#06b6d4;line-height:1">{{ profileViews }}</div>
                            <div style="font-size:0.75rem;color:var(--fo-text-secondary);font-weight:600">Vues du profil</div>
                        </div>
                    </div>
                    <div style="font-size:0.65rem;color:var(--fo-text-secondary);margin-top:10px"><i class="bi bi-calendar3 me-1"></i>30 derniers jours</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="fo-card" style="padding:20px;border-left:3px solid #f59e0b">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width:42px;height:42px;border-radius:10px;background:rgba(245,158,11,0.08);display:flex;align-items:center;justify-content:center"><i class="bi bi-coin" style="font-size:1.1rem;color:#f59e0b"></i></div>
                        <div>
                            <div style="font-size:1.6rem;font-weight:800;color:#f59e0b;line-height:1">{{ app.user.pointsBalance }}</div>
                            <div style="font-size:0.75rem;color:var(--fo-text-secondary);font-weight:600">Points</div>
                        </div>
                    </div>
                    <a href="{{ path('app_points_buy') }}" style="font-size:0.65rem;color:var(--primary);font-weight:700;text-decoration:none;display:block;margin-top:10px">+ Acheter des points</a>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="fo-card" style="padding:20px;border-left:3px solid #10b981">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width:42px;height:42px;border-radius:10px;background:rgba(16,185,129,0.08);display:flex;align-items:center;justify-content:center"><i class="bi bi-mortarboard" style="font-size:1.1rem;color:#10b981"></i></div>
                        <div>
                            <div style="font-size:1.6rem;font-weight:800;color:#10b981;line-height:1">{{ enrolledCourses }}</div>
                            <div style="font-size:0.75rem;color:var(--fo-text-secondary);font-weight:600">Formations</div>
                        </div>
                    </div>
                    <div style="display:flex;gap:6px;margin-top:10px;flex-wrap:wrap">
                        <span style="font-size:0.65rem;padding:2px 7px;border-radius:6px;background:rgba(79,70,229,0.1);color:var(--primary);font-weight:600">{{ quizzesPassed }} quiz</span>
                        <span style="font-size:0.65rem;padding:2px 7px;border-radius:6px;background:rgba(6,182,212,0.1);color:#06b6d4;font-weight:600">{{ interviewCount }} entretiens</span>
                    </div>
                </div>
            </div>
        </div>

        {# ── Quick Actions ── #}
        <div class="row g-3 mb-4">
            <div class="col-md-4 col-6">
                <a href="{{ path('app_my_applications') }}" class="fo-card d-flex align-items-center gap-3 text-decoration-none" style="padding:16px">
                    <div style="width:44px;height:44px;border-radius:12px;background:rgba(79,70,229,0.08);display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:var(--primary);flex-shrink:0"><i class="bi bi-file-text"></i></div>
                    <div><div style="font-weight:700;color:var(--fo-text);font-size:0.9rem">Candidatures</div><div style="color:var(--fo-text-secondary);font-size:0.75rem">Suivre mes candidatures</div></div>
                </a>
            </div>
            <div class="col-md-4 col-6">
                <a href="{{ path('app_interviews') }}" class="fo-card d-flex align-items-center gap-3 text-decoration-none" style="padding:16px">
                    <div style="width:44px;height:44px;border-radius:12px;background:rgba(16,185,129,0.08);display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:var(--success);flex-shrink:0"><i class="bi bi-camera-video"></i></div>
                    <div><div style="font-weight:700;color:var(--fo-text);font-size:0.9rem">Entretiens</div><div style="color:var(--fo-text-secondary);font-size:0.75rem">Sessions planifiées</div></div>
                </a>
            </div>
            <div class="col-md-4 col-6">
                <a href="{{ path('app_courses') }}" class="fo-card d-flex align-items-center gap-3 text-decoration-none" style="padding:16px">
                    <div style="width:44px;height:44px;border-radius:12px;background:rgba(245,158,11,0.08);display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:var(--warning);flex-shrink:0"><i class="bi bi-book"></i></div>
                    <div><div style="font-weight:700;color:var(--fo-text);font-size:0.9rem">Formations</div><div style="color:var(--fo-text-secondary);font-size:0.75rem">Cours & certifications</div></div>
                </a>
            </div>
        </div>

        {# ── Two-Column: Activities + Who Viewed ── #}
        <div class="row g-4">
            {# Activities Column #}
            <div class="col-lg-7">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 style="font-weight:800;margin:0"><i class="bi bi-clipboard-data me-2" style="color:var(--accent)"></i>Mes Activités</h6>
                    <a href="{{ path('app_activities') }}" style="font-size:0.8rem;color:var(--primary);font-weight:600;text-decoration:none">Voir tout →</a>
                </div>
                {% for a in activities %}
                    <div class="fo-card mb-2 d-flex align-items-start gap-3" style="padding:16px">
                        <div style="width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;
                            {% if a.project %}background:rgba(79,70,229,0.08);color:var(--primary)
                            {% else %}background:rgba(6,182,212,0.08);color:var(--accent){% endif %}">
                            <i class="bi bi-{% if a.project %}kanban{% else %}activity{% endif %}"></i>
                        </div>
                        <div style="flex:1;min-width:0">
                            <div style="font-weight:600;font-size:0.88rem">{{ a.description|slice(0,80) }}</div>
                            <div style="margin-top:4px;display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                                {% if a.project %}<span style="font-size:0.72rem;background:rgba(79,70,229,0.08);color:var(--primary);padding:2px 8px;border-radius:6px;font-weight:600">{{ a.project.name }}</span>{% endif %}
                                {% if a.hoursWorked %}<span style="font-size:0.72rem;color:var(--fo-text-secondary)"><i class="bi bi-clock me-1"></i>{{ a.hoursWorked }}h</span>{% endif %}
                                <span style="font-size:0.72rem;color:var(--fo-text-secondary)">{{ a.activityDate ? a.activityDate|date('d/m/Y') : '' }}</span>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="fo-card text-center" style="padding:40px">
                        <i class="bi bi-clipboard-x" style="font-size:2rem;color:var(--fo-text-secondary);opacity:0.3"></i>
                        <p style="color:var(--fo-text-secondary);font-size:0.85rem;margin:12px 0 0">Aucune activité assignée pour le moment</p>
                    </div>
                {% endfor %}
            </div>

            {# Who Viewed My Profile + Notifications #}
            <div class="col-lg-5">
                {# Who Viewed My Profile #}
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 style="font-weight:800;margin:0"><i class="bi bi-eye me-2" style="color:#06b6d4"></i>Qui a vu mon profil</h6>
                    <span style="font-size:0.75rem;color:var(--fo-text-secondary)">{{ profileViews }} vues ce mois</span>
                </div>
                {% if recentViewers|length > 0 %}
                    {% for rv in recentViewers %}
                    <div class="fo-card mb-2 d-flex align-items-center gap-3" style="padding:12px 16px">
                        {% if rv.user.profile and rv.user.profile.profilePicturePath %}
                            <img src="{{ rv.user.profile.profilePicturePath }}" style="width:36px;height:36px;border-radius:50%;object-fit:cover;flex-shrink:0" alt="">
                        {% else %}
                            <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--accent));display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:0.8rem;flex-shrink:0">
                                {{ rv.user.email|first|upper }}
                            </div>
                        {% endif %}
                        <div style="flex:1;min-width:0">
                            <div style="font-weight:600;font-size:0.85rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                {% if rv.user.profile and rv.user.profile.firstName %}{{ rv.user.profile.fullName }}{% else %}{{ rv.user.email|split('@')[0] }}{% endif %}
                            </div>
                            {% if rv.user.profile and rv.user.profile.professionalTitle %}
                                <div style="font-size:0.72rem;color:var(--fo-text-secondary)">{{ rv.user.profile.professionalTitle }}</div>
                            {% endif %}
                        </div>
                        <div style="font-size:0.65rem;color:var(--fo-text-secondary);white-space:nowrap">{{ rv.viewedAt|date('d/m') }}</div>
                    </div>
                    {% endfor %}
                {% else %}
                    <div class="fo-card text-center" style="padding:30px">
                        <i class="bi bi-eye-slash" style="font-size:1.5rem;color:var(--fo-text-secondary);opacity:0.3"></i>
                        <p style="color:var(--fo-text-secondary);font-size:0.82rem;margin:10px 0 0">Aucune visite récente</p>
                    </div>
                {% endif %}

                {# Notifications #}
                <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
                    <h6 style="font-weight:800;margin:0"><i class="bi bi-bell me-2" style="color:var(--warning)"></i>Notifications</h6>
                    <a href="{{ path('app_notifications') }}" style="font-size:0.8rem;color:var(--primary);font-weight:600;text-decoration:none">Voir tout →</a>
                </div>
                {% for n in notifications %}
                    <a href="{{ path('app_notification_read', {id: n.id}) }}" class="fo-card mb-2 d-flex align-items-start gap-3 text-decoration-none" style="padding:14px;{{ not n.read ? 'border-left:3px solid var(--primary);background:rgba(79,70,229,0.02)' : '' }}">
                        <div style="width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;
                            {% if n.type == 'OFFER_DECISION' %}background:rgba(16,185,129,0.1);color:var(--success)
                            {% elseif n.type == 'REPLY' %}background:rgba(6,182,212,0.1);color:var(--accent)
                            {% elseif n.type == 'ACTIVITY' %}background:rgba(99,102,241,0.1);color:#818cf8
                            {% else %}background:rgba(79,70,229,0.1);color:var(--primary){% endif %}">
                            <i class="bi bi-{% if n.type == 'OFFER_DECISION' %}briefcase{% elseif n.type == 'REPLY' %}chat-dots{% elseif n.type == 'ACTIVITY' %}clipboard-data{% else %}bell{% endif %}" style="font-size:0.85rem"></i>
                        </div>
                        <div style="flex:1;min-width:0">
                            <div style="font-weight:{{ not n.read ? '700' : '500' }};font-size:0.82rem;color:var(--fo-text)">{{ n.title }}</div>
                            {% if n.message %}<div style="font-size:0.75rem;color:var(--fo-text-secondary);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ n.message|slice(0,60) }}</div>{% endif %}
                            <div style="font-size:0.7rem;color:var(--fo-text-secondary);margin-top:3px">{{ n.createdAt|date('d/m H:i') }}</div>
                        </div>
                    </a>
                {% else %}
                    <div class="fo-card text-center" style="padding:40px">
                        <i class="bi bi-bell-slash" style="font-size:2rem;color:var(--fo-text-secondary);opacity:0.3"></i>
                        <p style="color:var(--fo-text-secondary);font-size:0.85rem;margin:12px 0 0">Aucune notification</p>
                    </div>
                {% endfor %}
            </div>
        </div>

        {# ── Recent Applications ── #}
        {% if applications|length > 0 %}
        <div class="mt-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 style="font-weight:800;margin:0"><i class="bi bi-file-text me-2" style="color:var(--primary)"></i>Dernières Candidatures</h6>
                <a href="{{ path('app_my_applications') }}" style="font-size:0.8rem;color:var(--primary);font-weight:600;text-decoration:none">Voir tout →</a>
            </div>
            <div class="fo-card" style="overflow:hidden">
                <table style="width:100%;border-collapse:collapse">
                    {% for app in applications %}
                    <tr style="border-bottom:1px solid var(--fo-border)">
                        <td style="padding:14px 16px;font-weight:600;font-size:0.88rem">{{ app.offer ? app.offer.title : '—' }}</td>
                        <td style="padding:14px 16px;color:var(--fo-text-secondary);font-size:0.82rem">{{ app.applicationDate ? app.applicationDate|date('d/m/Y') : '' }}</td>
                        <td style="padding:14px 16px;text-align:right">
                            <span class="fo-badge fo-badge-{{ app.status == 'Acceptée' ? 'success' : (app.status == 'Refusée' ? 'warning' : (app.status == 'Entretien' ? 'accent' : 'primary')) }}">{{ app.status }}</span>
                        </td>
                    </tr>
                    {% endfor %}
                </table>
            </div>
        </div>
        {% endif %}

        {# ── Skills Section ── #}
        {% if app.user.profile and app.user.profile.skills|length > 0 %}
        <div class="mt-4">
            <h6 style="font-weight:800;margin-bottom:12px"><i class="bi bi-award me-2" style="color:#7c3aed"></i>Mes Compétences</h6>
            <div class="fo-card" style="padding:20px">
                <div style="display:flex;flex-wrap:wrap;gap:8px">
                    {% for skill in app.user.profile.skills %}
                    <span style="padding:6px 14px;border-radius:20px;font-size:0.8rem;font-weight:600;background:linear-gradient(135deg,rgba(79,70,229,0.08),rgba(124,58,237,0.08));color:var(--primary);border:1px solid rgba(79,70,229,0.15)">{{ skill }}</span>
                    {% endfor %}
                </div>
                <a href="{{ path('app_profile_edit') }}" style="display:inline-block;margin-top:12px;font-size:0.78rem;color:var(--primary);font-weight:600;text-decoration:none"><i class="bi bi-pencil me-1"></i>Modifier mes compétences</a>
            </div>
        </div>
        {% endif %}
    </div>
</section>
{% endblock %}
