{% extends 'back/_base.html.twig' %}
{% block page_title %}Activités{% endblock %}
{% block content %}
<div class="row g-4">
    <div class="col-lg-5">
        <div class="bo-card">
            <h6 style="font-weight:700;margin-bottom:16px"><i class="bi bi-plus-circle me-2" style="color:var(--accent)"></i>Assigner une activité</h6>
            <form method="post" action="{{ path('admin_activity_new') }}" class="bo-form">
                <div class="mb-3">
                    <label>Candidat *</label>
                    <select name="candidateId" class="form-select" required>
                        <option value="">— Choisir un candidat —</option>
                        {% for c in candidates %}
                            <option value="{{ c.id }}">{{ c.email }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="mb-3">
                    <label>Projet (optionnel)</label>
                    <select name="projectId" class="form-select">
                        <option value="">— Sans projet —</option>
                        {% for p in projects %}
                            <option value="{{ p.id }}">{{ p.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="mb-3">
                    <label>Description *</label>
                    <textarea name="description" class="form-control" rows="3" required placeholder="Décrire l'activité..."></textarea>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label>Date</label>
                        <input type="date" name="activityDate" class="form-control" value="{{ 'now'|date('Y-m-d') }}">
                    </div>
                    <div class="col-6">
                        <label>Heures</label>
                        <input type="number" step="0.5" name="hoursWorked" class="form-control" placeholder="Ex: 4">
                    </div>
                </div>
                <button type="submit" class="bo-btn bo-btn-primary w-100"><i class="bi bi-check-lg me-1"></i>Assigner</button>
            </form>
        </div>
    </div>
    <div class="col-lg-7">
        <h6 style="font-weight:700;margin-bottom:16px">Activités assignées ({{ activities|length }})</h6>
        {% for a in activities %}
            <div class="bo-card mb-2 d-flex align-items-start gap-3">
                <div style="width:36px;height:36px;border-radius:10px;background:rgba(6,182,212,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                    <i class="bi bi-activity" style="color:var(--accent)"></i>
                </div>
                <div style="flex:1">
                    <div style="font-weight:600;font-size:0.9rem">{{ a.description }}</div>
                    <div style="font-size:0.8rem;color:var(--bo-text-secondary);margin-top:2px">
                        <i class="bi bi-person me-1"></i>{{ a.employee ? a.employee.email : '—' }}
                        {% if a.project %} · <i class="bi bi-kanban me-1"></i>{{ a.project.name }}{% endif %}
                        {% if a.hoursWorked %} · {{ a.hoursWorked }}h{% endif %}
                        · {{ a.activityDate ? a.activityDate|date('d/m/Y') : '—' }}
                    </div>
                </div>
            </div>
        {% else %}
            <div class="bo-card text-center" style="padding:40px">
                <i class="bi bi-clipboard-data" style="font-size:2.5rem;color:var(--bo-text-secondary);opacity:0.5"></i>
                <p class="mt-3" style="color:var(--bo-text-secondary)">Aucune activité assignée.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
