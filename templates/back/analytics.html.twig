{% extends 'back/_base.html.twig' %}
{% block page_title %}Analytiques des formations{% endblock %}

{% block content %}
<div class="d-flex align-items-center justify-content-between" style="margin-bottom:24px;flex-wrap:wrap;gap:12px">
    <h5 style="font-weight:700;margin:0"><i class="bi bi-graph-up-arrow me-2" style="color:var(--accent)"></i>Analytiques des formations</h5>
    <a href="{{ path('admin_courses') }}" class="bo-btn" style="font-size:0.85rem"><i class="bi bi-arrow-left me-1"></i>Retour</a>
</div>

{# ── KPI row ── #}
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="bo-card" style="text-align:center;padding:20px">
            <div style="font-size:2rem;font-weight:900;color:var(--primary-light)">{{ totalEnrollments }}</div>
            <div style="font-size:0.75rem;color:var(--bo-text-secondary);text-transform:uppercase;letter-spacing:.5px;font-weight:600;margin-top:4px">Candidatures totales</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="bo-card" style="text-align:center;padding:20px">
            <div style="font-size:2rem;font-weight:900;color:#10b981">{{ totalApproved }}</div>
            <div style="font-size:0.75rem;color:var(--bo-text-secondary);text-transform:uppercase;letter-spacing:.5px;font-weight:600;margin-top:4px">Inscriptions approuvées</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="bo-card" style="text-align:center;padding:20px">
            <div style="font-size:2rem;font-weight:900;color:var(--accent)">{{ totalAttempts }}</div>
            <div style="font-size:0.75rem;color:var(--bo-text-secondary);text-transform:uppercase;letter-spacing:.5px;font-weight:600;margin-top:4px">Tentatives de quiz</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="bo-card" style="text-align:center;padding:20px">
            <div style="font-size:2rem;font-weight:900;color:#f59e0b">{{ globalAvgScore }}/20</div>
            <div style="font-size:0.75rem;color:var(--bo-text-secondary);text-transform:uppercase;letter-spacing:.5px;font-weight:600;margin-top:4px">Score moyen global</div>
        </div>
    </div>
</div>

{# ── Charts ── #}
<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="bo-card">
            <div style="font-weight:700;font-size:0.95rem;margin-bottom:16px"><i class="bi bi-people-fill me-2" style="color:var(--primary-light)"></i>Inscriptions approuvées par formation</div>
            <div style="position:relative;height:200px">
                <canvas id="chartEnroll"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="bo-card">
            <div style="font-weight:700;font-size:0.95rem;margin-bottom:16px"><i class="bi bi-bar-chart-fill me-2" style="color:var(--accent)"></i>Score moyen par formation</div>
            <div style="position:relative;height:200px">
                <canvas id="chartScores"></canvas>
            </div>
        </div>
    </div>
</div>

{# ── Table ── #}
<div class="bo-card" style="overflow-x:auto">
    <div style="font-weight:700;font-size:0.95rem;margin-bottom:16px"><i class="bi bi-table me-2" style="color:var(--primary-light)"></i>Détail par formation</div>
    <table class="bo-table">
        <thead>
            <tr>
                <th>Formation</th>
                <th>Total</th>
                <th>Approuvés</th>
                <th>En attente</th>
                <th>Refusés</th>
                <th>Quiz tentés</th>
                <th>Score moyen</th>
                <th>Taux réussite</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for s in stats %}
            <tr>
                <td style="font-weight:600">{{ s.formation.titre }}</td>
                <td><span class="bo-badge bo-badge-primary">{{ s.total }}</span></td>
                <td><span style="background:rgba(16,185,129,0.12);color:#065f46;padding:2px 10px;border-radius:20px;font-size:0.75rem;font-weight:700">{{ s.approved }}</span></td>
                <td><span style="background:rgba(245,158,11,0.12);color:#92400e;padding:2px 10px;border-radius:20px;font-size:0.75rem;font-weight:700">{{ s.pending }}</span></td>
                <td><span style="background:rgba(239,68,68,0.1);color:#991b1b;padding:2px 10px;border-radius:20px;font-size:0.75rem;font-weight:700">{{ s.rejected }}</span></td>
                <td>{{ s.attempts }}</td>
                <td>
                    {% if s.avgScore is not null %}
                        <span style="font-weight:800;color:{{ s.avgScore >= 10 ? '#10b981' : '#ef4444' }}">{{ s.avgScore }}/20</span>
                    {% else %}<span style="color:var(--bo-text-secondary)">—</span>{% endif %}
                </td>
                <td>
                    {% if s.successRate is not null %}
                        <div style="display:flex;align-items:center;gap:8px">
                            <div style="flex:1;height:6px;border-radius:3px;background:rgba(255,255,255,0.1);overflow:hidden">
                                <div style="height:100%;border-radius:3px;background:{{ s.successRate >= 50 ? '#10b981' : '#f59e0b' }};width:{{ s.successRate }}%"></div>
                            </div>
                            <span style="font-size:0.78rem;font-weight:700;color:{{ s.successRate >= 50 ? '#10b981' : '#f59e0b' }}">{{ s.successRate }}%</span>
                        </div>
                    {% else %}<span style="color:var(--bo-text-secondary)">—</span>{% endif %}
                </td>
                <td>
                    <div class="d-flex gap-1">
                        <a href="{{ path('admin_course_edit', {id: s.formation.id}) }}" class="bo-action-btn" title="Gérer"><i class="bi bi-pencil"></i></a>
                        <a href="{{ path('admin_course_enrollments', {id: s.formation.id}) }}" class="bo-action-btn" title="Candidats" style="background:rgba(99,102,241,0.12);color:#6366f1"><i class="bi bi-people-fill"></i></a>
                    </div>
                </td>
            </tr>
            {% else %}
            <tr><td colspan="9" style="text-align:center;padding:40px;color:var(--bo-text-secondary)">Aucune formation.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
const labels = {{ chartLabels|json_encode|raw }};
Chart.defaults.color = '#94a3b8';
Chart.defaults.font.size = 11;

if (labels.length && document.getElementById('chartEnroll')) {
    new Chart(document.getElementById('chartEnroll'), {
        type: 'bar',
        data: {
            labels,
            datasets: [{
                label: 'Inscriptions approuvées',
                data: {{ chartEnroll|json_encode|raw }},
                backgroundColor: 'rgba(99,102,241,0.7)',
                borderColor: '#6366f1', borderWidth: 2, borderRadius: 8
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, grid: { color: 'rgba(255,255,255,0.05)' } },
                x: { grid: { display: false } }
            }
        }
    });
}

if (labels.length && document.getElementById('chartScores')) {
    const sc = {{ chartScores|json_encode|raw }};
    new Chart(document.getElementById('chartScores'), {
        type: 'bar',
        data: {
            labels,
            datasets: [{
                label: 'Score moyen /20',
                data: sc,
                backgroundColor: sc.map(s => s >= 10 ? 'rgba(16,185,129,0.7)' : 'rgba(239,68,68,0.6)'),
                borderColor: sc.map(s => s >= 10 ? '#10b981' : '#ef4444'),
                borderWidth: 2, borderRadius: 8
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { min: 0, max: 20, grid: { color: 'rgba(255,255,255,0.05)' } },
                x: { grid: { display: false } }
            }
        }
    });
}
</script>
{% endblock %}
