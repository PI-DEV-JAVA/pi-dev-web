{% extends 'front/_base.html.twig' %}
{% block title %}Détail de l'Activité — Talentos{% endblock %}
{% block content %}
<div class="fo-page-header">
    <div class="container">
        <h1>Détail de l'Activité 📋</h1>
        <p>Rapport d'activité et retours</p>
    </div>
</div>
<section class="fo-section" style="padding-top:40px">
    <div class="container" style="max-width:800px">
        <a href="{{ path('app_activities') }}" class="fo-btn fo-btn-outline mb-4"><i class="bi bi-arrow-left me-2"></i>Retour aux activités</a>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success mb-3"><i class="bi bi-check-circle-fill me-2"></i>{{ message }}</div>
        {% endfor %}

        <div class="fo-card mb-4" style="padding:30px">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h4 style="margin-bottom:8px;font-weight:700">{{ activity.description }}</h4>
                    <span style="color:var(--fo-text-secondary)"><i class="bi bi-calendar3 me-1"></i>{{ activity.activityDate ? activity.activityDate|date('d/m/Y') : '—' }}</span>
                </div>
                <span class="fo-badge {% if activity.status == 'APPROVED' %}fo-badge-success{% elseif activity.status == 'REJECTED' %}fo-badge-danger{% else %}fo-badge-warning{% endif %}" style="font-size:1.1rem;padding:8px 16px">
                    {{ activity.status }}
                </span>
            </div>

            <div class="row mb-4">
                <div class="col-md-6 mb-3 mb-md-0">
                    <div style="font-size:0.85rem;color:var(--fo-text-secondary);margin-bottom:4px">Projet associé</div>
                    <div style="font-weight:600">
                        {% if activity.project %}
                            <i class="bi bi-kanban me-2 text-primary"></i>{{ activity.project.name }}
                        {% else %}
                            —
                        {% endif %}
                    </div>
                </div>
                <div class="col-md-6">
                    <div style="font-size:0.85rem;color:var(--fo-text-secondary);margin-bottom:4px">Heures Travaillées</div>
                    <div style="font-weight:600"><i class="bi bi-clock me-2 text-primary"></i>{{ activity.hoursWorked ?? '0' }}h</div>
                </div>
            </div>

            <hr style="opacity:0.1">

            {# Admin Response feedback block #}
            {% if activity.adminResponse %}
                <div class="alert {% if activity.status == 'REJECTED' %}alert-danger{% else %}alert-info{% endif %} mt-4 mb-4" style="border-radius:12px; border-left:4px solid {% if activity.status == 'REJECTED' %}#dc3545{% else %}#0dcaf0{% endif %}">
                    <h6 style="font-weight:700"><i class="bi bi-chat-left-text-fill me-2"></i>Retour du responsable</h6>
                    <p style="margin:0; white-space:pre-wrap">{{ activity.adminResponse }}</p>
                </div>
            {% endif %}

            {# Form to submit the report #}
            <h6 style="font-weight:700;margin-bottom:16px"><i class="bi bi-journal-text me-2"></i>Votre Rapport d'Activité</h6>
            
            {% if activity.status == 'APPROVED' %}
                <div class="p-3 bg-light" style="border-radius:12px; white-space:pre-wrap">{{ activity.employeeReport|default('Aucun rapport fourni.') }}</div>
                <div class="mt-2" style="font-size:0.85rem;color:var(--fo-text-secondary)"><i class="bi bi-lock-fill me-1"></i>Ce rapport a été approuvé et ne peut plus être modifié.</div>
            {% else %}
                <form method="post" action="{{ path('app_activity_detail', {id: activity.id}) }}">
                    <div class="mb-3">
                        <textarea class="form-control" name="employeeReport" rows="6" placeholder="Décrivez les tâches accomplies, les défis rencontrés..." style="resize:vertical" required>{{ activity.employeeReport }}</textarea>
                    </div>
                    <button type="submit" class="btn btn-primary-custom w-100">
                        <i class="bi bi-send me-2"></i>{% if activity.employeeReport %}Mettre à jour le rapport{% else %}Soumettre le rapport{% endif %}
                    </button>
                    {% if activity.status == 'REJECTED' %}
                        <div class="text-center mt-2" style="font-size:0.85rem;color:var(--fo-text-secondary)">La soumission de ce formulaire rétablira le statut à "PENDING".</div>
                    {% endif %}
                </form>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
