{% extends 'base.html.twig' %}
{% from 'components/_sidebar.html.twig' import sidebar %}

{% block title %}Mes Candidatures — Talentos{% endblock %}

{% block body %}
{{ sidebar(app.user) }}

<main class="app-main">
    <div class="page-header">
        <h2>Mes Candidatures 📄</h2>
        <p>Suivez l'état de vos candidatures</p>
    </div>

    {% if applications is empty %}
        <div class="stat-card text-center" style="padding:60px">
            <i class="bi bi-inbox" style="font-size:3rem;color:var(--text-secondary)"></i>
            <p class="mt-3" style="color:var(--text-secondary)">Vous n'avez pas encore postulé à une offre.</p>
            <a href="{{ path('app_offers') }}" class="btn btn-primary-custom" style="width:auto;padding:10px 24px;display:inline-block;margin-top:8px">
                <i class="bi bi-search me-1"></i> Parcourir les offres
            </a>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table" style="color:var(--text-primary)">
                <thead>
                    <tr style="color:var(--text-secondary);font-size:0.8rem;text-transform:uppercase;letter-spacing:0.5px;border-bottom:1px solid var(--border)">
                        <th>Offre</th>
                        <th>Département</th>
                        <th>Date</th>
                        <th>Statut</th>
                        <th>Score</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for app in applications %}
                        <tr style="border-bottom:1px solid rgba(71,85,105,0.2)">
                            <td style="font-weight:500">{{ app.offer.title }}</td>
                            <td style="color:var(--text-secondary)">{{ app.offer.department ?: '—' }}</td>
                            <td style="color:var(--text-secondary);font-size:0.9rem">{{ app.applicationDate ? app.applicationDate|date('d/m/Y') : '—' }}</td>
                            <td>
                                {% set statusColor = {
                                    'Nouvelle': 'rgba(6,182,212,0.15)',
                                    'En cours': 'rgba(245,158,11,0.15)',
                                    'Acceptée': 'rgba(16,185,129,0.15)',
                                    'Refusée': 'rgba(239,68,68,0.15)'
                                } %}
                                {% set statusText = {
                                    'Nouvelle': 'var(--accent)',
                                    'En cours': 'var(--warning)',
                                    'Acceptée': 'var(--success)',
                                    'Refusée': 'var(--danger)'
                                } %}
                                <span class="badge" style="background:{{ statusColor[app.status]|default('rgba(148,163,184,0.15)') }};color:{{ statusText[app.status]|default('var(--text-secondary)') }};padding:4px 12px;border-radius:6px;font-weight:500">
                                    {{ app.status }}
                                </span>
                            </td>
                            <td style="font-weight:600">{{ app.score > 0 ? app.score ~ '%' : '—' }}</td>
                            <td>
                                <a href="{{ path('app_offer_detail', {id: app.offer.id}) }}"
                                   style="color:var(--primary-light);text-decoration:none;font-size:0.85rem">
                                    Voir <i class="bi bi-arrow-right"></i>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</main>
{% endblock %}
