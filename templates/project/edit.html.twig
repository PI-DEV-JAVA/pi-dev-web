{# templates/project/edit.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Edit Project{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-modern p-4 p-lg-5">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
                <div>
                    <h1 class="fw-bold">Edit Project</h1>
                    <p class="text-muted">Update details for <strong>{{ project.name }}</strong></p>
                </div>
                <a href="{{ path('app_project_show', {'id': project.id}) }}" class="btn btn-outline-secondary rounded-pill mt-2 mt-sm-0">
                    <i class="bi bi-eye"></i> View Project
                </a>
            </div>
            {{ include('project/_form.html.twig', {'button_label': 'Update Project'}) }}
        </div>
    </div>
</div>
{% endblock %}