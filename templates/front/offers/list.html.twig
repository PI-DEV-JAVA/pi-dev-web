{% extends 'front/_base.html.twig' %}

{% block title %}Offres d'emploi — Talentos{% endblock %}

{% block content %}
<div class="fo-page-header">
    <div class="container">
        <h1>Offres d'emploi</h1>
        <p>{{ offers|length }} offre(s) disponible(s)</p>
    </div>
</div>

<section class="fo-section" style="padding-top:40px">
    <div class="container">
        <div class="d-flex gap-3 mb-4 border-bottom pb-2">
            <a href="{{ path('app_offers') }}" class="btn btn-sm" style="font-weight:600; color: var(--primary); border-bottom: 2px solid var(--primary); border-radius: 0; padding-bottom: 8px;">Toutes les offres</a>
            {% if app.user %}
                <a href="{{ path('app_my_bookmarks') }}" class="btn btn-sm text-secondary" style="font-weight:500; border-bottom: 2px solid transparent; border-radius: 0; padding-bottom: 8px;">Mes favoris</a>
            {% endif %}
        </div>

        <form method="get" action="{{ path('app_offers') }}" class="mb-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <div class="fo-form">
                        <input type="text" name="q" value="{{ search }}" class="form-control" placeholder="Rechercher par titre, compétence...">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="fo-form">
                        <select name="contract" class="form-select">
                            <option value="">Tous les types</option>
                            <option value="CDI" {{ contractFilter == 'CDI' ? 'selected' : '' }}>CDI</option>
                            <option value="CDD" {{ contractFilter == 'CDD' ? 'selected' : '' }}>CDD</option>
                            <option value="Stage" {{ contractFilter == 'Stage' ? 'selected' : '' }}>Stage</option>
                            <option value="Freelance" {{ contractFilter == 'Freelance' ? 'selected' : '' }}>Freelance</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary-custom w-100"><i class="bi bi-search me-2"></i>Filtrer</button>
                </div>
            </div>
        </form>

        {% if offers is empty %}
            <div class="fo-card text-center" style="padding:60px">
                <i class="bi bi-search" style="font-size:3rem;color:var(--fo-text-secondary)"></i>
                <p class="mt-3" style="color:var(--fo-text-secondary)">Aucune offre ne correspond à votre recherche.</p>
            </div>
        {% else %}
            <div class="row g-4">
                {% for offer in offers %}
                    <div class="col-md-6 col-lg-4">
                        <a href="{{ path('app_offer_detail', {id: offer.id}) }}" class="text-decoration-none">
                            <div class="fo-card h-100" style="cursor:pointer">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div class="offer-icon"><i class="bi bi-briefcase"></i></div>
                                    {% if offer.contractType %}
                                        <span class="fo-badge fo-badge-primary">{{ offer.contractType }}</span>
                                    {% endif %}
                                </div>
                                <h5 style="font-weight:700;color:var(--fo-text);margin-bottom:8px;font-size:1.05rem">{{ offer.title }}</h5>
                                <p style="color:var(--fo-text-secondary);font-size:0.85rem;line-height:1.6;
                                   display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:16px">
                                    {{ offer.description|default('Pas de description')|striptags|slice(0,120) }}
                                </p>
                                <div style="font-size:0.8rem;color:var(--fo-text-secondary)">
                                    {% if offer.location %}<span class="me-3"><i class="bi bi-geo-alt me-1"></i>{{ offer.location }}</span>{% endif %}
                                    {% if offer.experienceLevel %}<span><i class="bi bi-bar-chart me-1"></i>{{ offer.experienceLevel }}</span>{% endif %}
                                </div>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        {# ━━━━━ FEATURE 4: Job Market News Hub ━━━━━ #}
        <div class="fo-card mt-5" style="border:1px solid #e0e7ff;background:linear-gradient(135deg, #fefce8 0%, #fff7ed 50%, #fdf2f8 100%)">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
                <div>
                    <h5 style="font-weight:800;margin:0;color:#1e293b"><i class="bi bi-newspaper me-2 text-primary"></i>Tendances & Actualités de l'Emploi</h5>
                    <p class="mb-0 mt-1" style="font-size:0.8rem;color:var(--fo-text-secondary)">📰 Source: Google News RSS · Mis à jour en temps réel</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label style="font-size:0.85rem;font-weight:600;color:#475569;white-space:nowrap">Secteur :</label>
                    <select id="newsFieldSelect" class="form-select form-select-sm" style="width:auto;min-width:160px;border-radius:8px;font-weight:500" onchange="fetchMarketNews()">
                        <option value="informatique">💻 Informatique</option>
                        <option value="data">🤖 Data / IA</option>
                        <option value="finance">💰 Finance</option>
                        <option value="marketing">📣 Marketing</option>
                        <option value="rh">👥 Ressources Humaines</option>
                        <option value="sante">🏥 Santé</option>
                        <option value="ingenierie">⚙️ Ingénierie</option>
                        <option value="design">🎨 Design / UX</option>
                    </select>
                </div>
            </div>
            
            <div id="newsHubContent">
                <div class="row g-3">
                    <div class="col-md-4"><div class="placeholder-glow"><span class="placeholder col-12" style="height:80px;border-radius:8px"></span></div></div>
                    <div class="col-md-4"><div class="placeholder-glow"><span class="placeholder col-12" style="height:80px;border-radius:8px"></span></div></div>
                    <div class="col-md-4"><div class="placeholder-glow"><span class="placeholder col-12" style="height:80px;border-radius:8px"></span></div></div>
                </div>
            </div>
        </div>

    </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function() {
    fetchMarketNews();
});

function fetchMarketNews() {
    const field = document.getElementById('newsFieldSelect').value;
    const box = document.getElementById('newsHubContent');
    box.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary spinner-border-sm"></div><div class="mt-2 text-muted" style="font-size:0.8rem">Chargement des actualités...</div></div>';

    fetch('/api/market-news?field=' + encodeURIComponent(field))
        .then(r => r.json())
        .then(data => {
            if (!data.articles || data.articles.length === 0) {
                box.innerHTML = '<div class="text-center py-4 text-muted"><i class="bi bi-inbox" style="font-size:2rem"></i><p class="mt-2">Aucune actualité trouvée pour ce secteur.</p></div>';
                return;
            }

            let html = '<div class="row g-3">';
            data.articles.forEach((a, i) => {
                let colors = ['#dbeafe','#fce7f3','#d1fae5','#fef3c7','#ede9fe','#ffe4e6'];
                let bg = colors[i % colors.length];
                html += `
                    <div class="col-md-6 col-lg-4">
                        <a href="${a.link}" target="_blank" rel="noopener" class="text-decoration-none">
                            <div style="background:${bg};border-radius:12px;padding:16px;height:100%;transition:transform .2s;cursor:pointer" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='none'">
                                <div style="font-size:0.7rem;color:#6b7280;margin-bottom:6px"><i class="bi bi-calendar3 me-1"></i>${a.date} · ${a.source || 'Google News'}</div>
                                <div style="font-weight:700;color:#1e293b;font-size:0.9rem;line-height:1.4;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden">${a.title}</div>
                                <div style="font-size:0.75rem;color:var(--primary);margin-top:8px;font-weight:600">Lire l'article <i class="bi bi-arrow-right"></i></div>
                            </div>
                        </a>
                    </div>
                `;
            });
            html += '</div>';
            box.innerHTML = html;
        })
        .catch(() => {
            box.innerHTML = '<div class="text-center py-3 text-muted"><i class="bi bi-wifi-off me-1"></i>Impossible de charger les actualités.</div>';
        });
}
</script>
{% endblock %}
