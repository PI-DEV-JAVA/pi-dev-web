{% extends 'back/_base.html.twig' %}
{% block page_title %}Participations — {{ event.title }}{% endblock %}
{% block content %}
<style>
    .part-card { background: var(--bo-bg-input); border: 1.5px solid var(--bo-border); border-radius: 12px; padding: 14px 18px; display: flex; align-items: center; gap: 14px; margin-bottom: 10px; transition: all 0.3s; }
    .part-card:hover { border-color: rgba(79,70,229,0.3); }
    .part-avatar { width: 40px; height: 40px; border-radius: 10px; background: linear-gradient(135deg, var(--primary), var(--accent)); display: flex; align-items: center; justify-content: center; font-weight: 700; color: white; flex-shrink: 0; overflow: hidden; }
    .part-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .part-status { padding: 4px 12px; border-radius: 20px; font-size: 0.72rem; font-weight: 600; }
    .st-PENDING { background: rgba(245,158,11,0.15); color: #fbbf24; }
    .st-CONFIRMED { background: rgba(79,70,229,0.15); color: #818cf8; }
    .st-ATTENDED { background: rgba(16,185,129,0.15); color: #34d399; }
    .st-CANCELLED { background: rgba(239,68,68,0.15); color: #f87171; }
    .status-btn { padding: 5px 10px; border-radius: 6px; font-size: 0.72rem; font-weight: 600; border: none; cursor: pointer; transition: all 0.2s; }
    .status-btn:hover { transform: translateY(-1px); }
</style>

<div class="mb-3"><a href="{{ path('admin_events') }}" style="color:var(--primary-light);text-decoration:none;font-size:0.85rem"><i class="bi bi-arrow-left me-1"></i>Retour aux événements</a></div>

{% for message in app.flashes('success') %}
    <div class="alert" style="background:rgba(16,185,129,0.1);color:#10b981;border:1px solid rgba(16,185,129,0.2);border-radius:12px;padding:12px;font-size:0.85rem;margin-bottom:16px"><i class="bi bi-check-circle-fill me-2"></i>{{ message }}</div>
{% endfor %}

{# Event summary #}
<div class="bo-card mb-4 d-flex align-items-center justify-content-between" style="padding:20px 24px">
    <div>
        <h5 style="font-weight:700;margin:0">{{ event.title }}</h5>
        <div style="font-size:0.85rem;color:var(--bo-text-secondary);margin-top:4px">
            <span class="bo-badge bo-badge-primary">{{ event.eventType }}</span>
            <span style="margin-left:8px"><i class="bi bi-calendar3 me-1"></i>{{ event.eventDate|date('d/m/Y H:i') }}</span>
            <span style="margin-left:8px"><i class="bi bi-geo-alt me-1"></i>{{ event.location ?: '—' }}</span>
        </div>
    </div>
    <div class="text-end">
        <div style="font-size:2rem;font-weight:800;color:var(--primary-light)">{{ participations|length }}</div>
        <div style="font-size:0.75rem;color:var(--bo-text-secondary)">participant(s)</div>
    </div>
</div>

{# Stats mini #}
{% set confirmed = participations|filter(p => p.status == 'CONFIRMED')|length %}
{% set attended = participations|filter(p => p.status == 'ATTENDED')|length %}
{% set pending = participations|filter(p => p.status == 'PENDING')|length %}
{% set cancelled = participations|filter(p => p.status == 'CANCELLED')|length %}
<div class="row g-3 mb-4">
    <div class="col-3"><div class="bo-card text-center" style="padding:12px"><div style="font-size:1.3rem;font-weight:700;color:#fbbf24">{{ pending }}</div><div style="font-size:0.7rem;color:var(--bo-text-secondary)">En attente</div></div></div>
    <div class="col-3"><div class="bo-card text-center" style="padding:12px"><div style="font-size:1.3rem;font-weight:700;color:#818cf8">{{ confirmed }}</div><div style="font-size:0.7rem;color:var(--bo-text-secondary)">Confirmés</div></div></div>
    <div class="col-3"><div class="bo-card text-center" style="padding:12px"><div style="font-size:1.3rem;font-weight:700;color:#34d399">{{ attended }}</div><div style="font-size:0.7rem;color:var(--bo-text-secondary)">Présents</div></div></div>
    <div class="col-3"><div class="bo-card text-center" style="padding:12px"><div style="font-size:1.3rem;font-weight:700;color:#f87171">{{ cancelled }}</div><div style="font-size:0.7rem;color:var(--bo-text-secondary)">Annulés</div></div></div>
</div>

{# Participant list #}
{% for p in participations %}
<div class="part-card">
    <div class="part-avatar">
        {% if p.user.profile and p.user.profile.profilePicturePath %}
            <img src="{{ p.user.profile.profilePicturePath }}" alt="">
        {% else %}
            {{ p.user.email|first|upper }}
        {% endif %}
    </div>
    <div style="flex:1;min-width:0">
        <div style="font-weight:600;font-size:0.9rem">
            {% if p.user.profile and p.user.profile.firstName %}{{ p.user.profile.firstName }} {{ p.user.profile.lastName }}{% else %}{{ p.user.email|split('@')[0] }}{% endif %}
        </div>
        <div style="font-size:0.78rem;color:var(--bo-text-secondary)">{{ p.user.email }} · {{ p.registeredAt|date('d/m/Y H:i') }}</div>
    </div>
    <span class="part-status st-{{ p.status }}">{{ p.status }}</span>
    <form method="post" action="{{ path('admin_participation_status', {id: p.id}) }}" class="d-flex gap-1">
        <button type="submit" name="status" value="CONFIRMED" class="status-btn" style="background:rgba(79,70,229,0.12);color:#818cf8" title="Confirmer"><i class="bi bi-check"></i></button>
        <button type="submit" name="status" value="ATTENDED" class="status-btn" style="background:rgba(16,185,129,0.12);color:#34d399" title="Présent"><i class="bi bi-person-check"></i></button>
        <button type="submit" name="status" value="CANCELLED" class="status-btn" style="background:rgba(239,68,68,0.12);color:#f87171" title="Annuler"><i class="bi bi-x"></i></button>
    </form>
</div>
{% else %}
<div class="bo-card text-center" style="padding:40px">
    <i class="bi bi-people" style="font-size:2.5rem;color:var(--bo-text-secondary);opacity:0.2;display:block;margin-bottom:8px"></i>
    <p style="color:var(--bo-text-secondary)">Aucune participation pour cet événement.</p>
</div>
{% endfor %}
{% endblock %}
