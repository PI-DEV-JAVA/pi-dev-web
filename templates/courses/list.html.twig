{% extends 'base.html.twig' %}
{% from 'components/_sidebar.html.twig' import sidebar %}

{% block title %}Formations — Talentos{% endblock %}

{% block body %}
{{ sidebar(app.user) }}

<main class="app-main">
    <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2>Formations 📚</h2>
            <p>Développez vos compétences avec nos formations</p>
        </div>
        {% if app.user and app.user.role == 'CANDIDATE' %}
        <div class="d-flex align-items-center gap-3">
            <div style="background:linear-gradient(135deg,rgba(79,70,229,0.2),rgba(6,182,212,0.15));
                        border:1px solid rgba(79,70,229,0.3);border-radius:12px;padding:10px 18px;
                        display:flex;align-items:center;gap:10px">
                <i class="bi bi-coin" style="color:#f59e0b;font-size:1.3rem"></i>
                <div>
                    <div style="font-size:0.7rem;color:var(--text-secondary);text-transform:uppercase;letter-spacing:1px">Mon solde</div>
                    <div style="font-weight:700;color:var(--text-primary);font-size:1.1rem">{{ pointsBalance }} pts</div>
                </div>
            </div>
            <a href="{{ path('app_points_buy') }}" style="display:inline-flex;align-items:center;gap:6px;
               background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;border-radius:10px;
               padding:10px 18px;font-size:0.85rem;font-weight:600;text-decoration:none;
               transition:opacity 0.2s" onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">
                <i class="bi bi-plus-circle"></i>Acheter des points
            </a>
        </div>
        {% endif %}
    </div>

    {# ── Filters & Sort ── #}
    <div class="stat-card mb-4" style="padding:16px 20px">
        <form method="GET" class="d-flex flex-wrap gap-3 align-items-center">
            <div class="d-flex align-items-center gap-2">
                <label style="font-size:0.85rem;color:var(--text-secondary);white-space:nowrap"><i class="bi bi-sort-down me-1"></i>Trier par</label>
                <select name="sort" id="sort" onchange="this.form.submit()"
                        style="background:var(--bg-input);border:1px solid var(--border);color:var(--text-primary);
                               border-radius:8px;padding:7px 14px;font-size:0.85rem;cursor:pointer">
                    <option value="date"        {{ sort == 'date'        ? 'selected' : '' }}>Date (récent)</option>
                    <option value="name"        {{ sort == 'name'        ? 'selected' : '' }}>Nom A→Z</option>
                    <option value="enrollments" {{ sort == 'enrollments' ? 'selected' : '' }}>Plus inscrits</option>
                    <option value="price"       {{ sort == 'price'       ? 'selected' : '' }}>Prix</option>
                </select>
            </div>
            <div class="d-flex align-items-center gap-2">
                <label style="font-size:0.85rem;color:var(--text-secondary);white-space:nowrap"><i class="bi bi-funnel me-1"></i>Type</label>
                <select name="type" id="type" onchange="this.form.submit()"
                        style="background:var(--bg-input);border:1px solid var(--border);color:var(--text-primary);
                               border-radius:8px;padding:7px 14px;font-size:0.85rem;cursor:pointer">
                    <option value=""     {{ type == ''     ? 'selected' : '' }}>Toutes</option>
                    <option value="free" {{ type == 'free' ? 'selected' : '' }}>Gratuites</option>
                    <option value="paid" {{ type == 'paid' ? 'selected' : '' }}>Payantes</option>
                </select>
            </div>
            <span style="font-size:0.8rem;color:var(--text-secondary)">{{ formations|length }} formation(s)</span>
        </form>
    </div>

    {% if formations is empty %}
        <div class="stat-card text-center" style="padding:60px">
            <i class="bi bi-mortarboard" style="font-size:3rem;color:var(--text-secondary)"></i>
            <p class="mt-3" style="color:var(--text-secondary)">Aucune formation disponible pour le moment.</p>
        </div>
    {% else %}
        <div class="row g-4">
            {% for f in formations %}
                <div class="col-md-6 col-lg-4">
                    <a href="{{ path('app_course_detail', {id: f.id}) }}" class="text-decoration-none">
                        <div class="stat-card h-100" style="cursor:pointer;transition:transform 0.2s,box-shadow 0.2s"
                             onmouseover="this.style.transform='translateY(-4px)';this.style.boxShadow='0 12px 40px rgba(79,70,229,0.2)'"
                             onmouseout="this.style.transform='';this.style.boxShadow=''">

                            {# Cover image #}
                            {% if f.image %}
                                <div style="width:100%;height:160px;border-radius:12px;margin-bottom:16px;overflow:hidden;position:relative">
                                    <img src="{{ asset('uploads/formations/' ~ f.image) }}"
                                         alt="{{ f.titre }}"
                                         style="width:100%;height:100%;object-fit:cover">
                                    <div style="position:absolute;top:10px;right:10px">
                                        {% if f.isPaid %}
                                            <span style="background:rgba(245,158,11,0.92);color:#fff;padding:4px 10px;border-radius:20px;font-size:0.75rem;font-weight:700;backdrop-filter:blur(4px)">
                                                <i class="bi bi-coin me-1"></i>{{ f.pricePoints }} pts
                                            </span>
                                        {% else %}
                                            <span style="background:rgba(16,185,129,0.92);color:#fff;padding:4px 10px;border-radius:20px;font-size:0.75rem;font-weight:700;backdrop-filter:blur(4px)">
                                                <i class="bi bi-gift me-1"></i>Gratuit
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>
                            {% else %}
                                <div style="width:100%;height:160px;border-radius:12px;margin-bottom:16px;position:relative;
                                            background:linear-gradient(135deg,rgba(79,70,229,0.3),rgba(6,182,212,0.2));
                                            display:flex;align-items:center;justify-content:center">
                                    <i class="bi bi-book" style="font-size:3rem;color:var(--primary-light)"></i>
                                    <div style="position:absolute;top:10px;right:10px">
                                        {% if f.isPaid %}
                                            <span style="background:rgba(245,158,11,0.92);color:#fff;padding:4px 10px;border-radius:20px;font-size:0.75rem;font-weight:700">
                                                <i class="bi bi-coin me-1"></i>{{ f.pricePoints }} pts
                                            </span>
                                        {% else %}
                                            <span style="background:rgba(16,185,129,0.92);color:#fff;padding:4px 10px;border-radius:20px;font-size:0.75rem;font-weight:700">
                                                <i class="bi bi-gift me-1"></i>Gratuit
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endif %}

                            <h5 style="font-weight:600;color:var(--text-primary);margin-bottom:6px">{{ f.titre }}</h5>
                            <p style="color:var(--text-secondary);font-size:0.85rem;line-height:1.5;
                                       display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:12px">
                                {{ f.description|default('Aucune description')|striptags|slice(0,100) }}
                            </p>

                            <div class="d-flex justify-content-between align-items-center" style="font-size:0.8rem;color:var(--text-secondary)">
                                <span><i class="bi bi-clock me-1"></i>{{ f.duree ?: '—' }}h</span>
                                <span><i class="bi bi-bar-chart me-1"></i>{{ f.niveau ?: 'Tous niveaux' }}</span>
                                <span><i class="bi bi-people me-1"></i>{{ enrollmentCounts[f.id] ?? 0 }} inscrits</span>
                            </div>

                            {% if app.user and app.user.role == 'CANDIDATE' %}
                                {% if enrollments[f.id] is defined %}
                                    <div class="mt-3 text-center" style="font-size:0.8rem;padding:6px 12px;border-radius:8px;
                                        background:{{ enrollments[f.id] == 'APPROVED' ? 'rgba(16,185,129,0.15)' : (enrollments[f.id] == 'REJECTED' ? 'rgba(239,68,68,0.15)' : 'rgba(245,158,11,0.15)') }};
                                        color:{{ enrollments[f.id] == 'APPROVED' ? 'var(--success)' : (enrollments[f.id] == 'REJECTED' ? '#ef4444' : 'var(--warning)') }}">
                                        <i class="bi bi-{{ enrollments[f.id] == 'APPROVED' ? 'check-circle' : (enrollments[f.id] == 'REJECTED' ? 'x-circle' : 'hourglass-split') }} me-1"></i>
                                        {{ enrollments[f.id] == 'APPROVED' ? 'Inscrit(e)' : (enrollments[f.id] == 'REJECTED' ? 'Refusé(e)' : 'En attente') }}
                                    </div>
                                {% endif %}
                            {% endif %}
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</main>
{% endblock %}
