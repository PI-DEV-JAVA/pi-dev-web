{% extends 'front/_base.html.twig' %}
{% block title %}Entretiens — Talentos{% endblock %}
{% block content %}
<div class="fo-page-header">
    <div class="container">
        <h1>Mes entretiens 🎥</h1>
        <p>Vos entretiens planifiés</p>
    </div>
</div>
<section class="fo-section" style="padding-top:40px">
    <div class="container">
        {% if interviews is empty %}
            <div class="fo-card text-center" style="padding:60px">
                <i class="bi bi-camera-video" style="font-size:3rem;color:var(--fo-text-secondary)"></i>
                <p class="mt-3" style="color:var(--fo-text-secondary)">Aucun entretien planifié.</p>
            </div>
        {% else %}
            <div class="row g-3">
                {% for interview in interviews %}
                    <div class="col-md-6">
                        <div class="fo-card">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 style="font-weight:700;margin:0">{{ interview.application.offer.title }}</h6>
                                <span class="fo-badge fo-badge-{{ interview.status == 'COMPLETED' ? 'success' : (interview.status == 'CANCELLED' ? 'warning' : 'primary') }}">{{ interview.status }}</span>
                            </div>
                            <div style="color:var(--fo-text-secondary);font-size:0.85rem">
                                <div class="mb-1"><i class="bi bi-calendar3 me-1"></i>{{ interview.interviewDate ? interview.interviewDate|date('d/m/Y à H:i') : '—' }}</div>
                                {% if interview.meetingLink %}
                                    <a href="{{ interview.meetingLink }}" target="_blank" style="color:var(--primary);text-decoration:none;font-weight:500">
                                        <i class="bi bi-camera-video me-1"></i>Rejoindre
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
