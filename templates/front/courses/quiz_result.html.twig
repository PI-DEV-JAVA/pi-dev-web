{% extends 'front/_base.html.twig' %}

{% block title %}Résultat — {{ quiz.titre }}{% endblock %}

{% block content %}
<style>
    .result-hero { text-align: center; padding: 48px 24px 32px; }
    .score-ring { width: 140px; height: 140px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; flex-direction: column; margin-bottom: 20px; position: relative; }
    .score-ring::before { content: ''; position: absolute; inset: 0; border-radius: 50%; border: 6px solid; }
    .score-excellent::before { border-color: #10b981; background: rgba(16,185,129,0.1); }
    .score-good::before { border-color: #3b82f6; background: rgba(59,130,246,0.1); }
    .score-poor::before { border-color: #ef4444; background: rgba(239,68,68,0.1); }
    .score-num { font-size: 2.2rem; font-weight: 900; line-height: 1; }
    .score-denom { font-size: 1rem; font-weight: 600; color: #94a3b8; }
    .result-answer { border-radius: 12px; padding: 18px; margin-bottom: 12px; }
    .answer-correct { background: rgba(16,185,129,0.06); border: 1.5px solid rgba(16,185,129,0.25); }
    .answer-wrong { background: rgba(239,68,68,0.06); border: 1.5px solid rgba(239,68,68,0.2); }
    .cheated-banner { background: linear-gradient(135deg, #fee2e2, #fecaca); border: 2px solid #ef4444; border-radius: 16px; padding: 32px; text-align: center; margin-bottom: 24px; }
</style>

<div class="fo-page-header">
    <div class="container">
        {% set formationId = formation ? formation.id : (quiz.seance ? quiz.seance.formation.id : (quiz.formation ? quiz.formation.id : null)) %}
        {% if formationId %}
        <a href="{{ path('app_course_detail', {id: formationId}) }}" style="color:var(--primary);text-decoration:none;font-size:0.9rem;font-weight:500">
            <i class="bi bi-arrow-left me-1"></i> Retour à la formation
        </a>
        {% endif %}
        <h1 class="mt-2">{{ quiz.titre }} — Résultat</h1>
    </div>
</div>

<section class="fo-section" style="padding-top:32px">
    <div class="container" style="max-width:740px">

        {% if cheated %}
            <div class="cheated-banner">
                <div style="font-size:3rem;margin-bottom:12px">🚫</div>
                <h3 style="font-weight:800;color:#dc2626;margin-bottom:8px">Quiz invalidé — Tentative de triche détectée</h3>
                <p style="color:#7f1d1d;margin-bottom:4px">Vous avez changé d'onglet pendant le quiz. Votre note est de</p>
                <div style="font-size:3rem;font-weight:900;color:#dc2626">0 / 20</div>
            </div>
        {% else %}
            <div class="fo-card result-hero">
                {% if score >= 16 %}
                    <div class="score-ring score-excellent">
                        <span class="score-num" style="color:#10b981">{{ score }}</span>
                        <span class="score-denom">/20</span>
                    </div>
                    <h2 style="font-weight:800;margin-bottom:6px">🏆 Excellent !</h2>
                    <p style="color:#64748b">Félicitations, vous maîtrisez très bien ce contenu !</p>
                {% elseif score >= 10 %}
                    <div class="score-ring score-good">
                        <span class="score-num" style="color:#3b82f6">{{ score }}</span>
                        <span class="score-denom">/20</span>
                    </div>
                    <h2 style="font-weight:800;margin-bottom:6px">👍 Bien joué !</h2>
                    <p style="color:#64748b">Vous avez une bonne compréhension du sujet.</p>
                {% else %}
                    <div class="score-ring score-poor">
                        <span class="score-num" style="color:#ef4444">{{ score }}</span>
                        <span class="score-denom">/20</span>
                    </div>
                    <h2 style="font-weight:800;margin-bottom:6px">📚 À retravailler</h2>
                    <p style="color:#64748b">Revoyez le contenu de la séance pour mieux maîtriser les concepts.</p>
                {% endif %}

                {% if results %}
                <div style="display:flex;justify-content:center;gap:32px;margin-top:20px;padding-top:20px;border-top:1px solid var(--fo-border,#e2e8f0)">
                    <div style="text-align:center">
                        <div style="font-size:1.5rem;font-weight:800;color:#10b981">{{ results|filter(r => r.isCorrect)|length }}</div>
                        <div style="font-size:0.8rem;color:#64748b">Correctes</div>
                    </div>
                    <div style="text-align:center">
                        <div style="font-size:1.5rem;font-weight:800;color:#ef4444">{{ results|filter(r => not r.isCorrect)|length }}</div>
                        <div style="font-size:0.8rem;color:#64748b">Incorrectes</div>
                    </div>
                    <div style="text-align:center">
                        <div style="font-size:1.5rem;font-weight:800;color:#64748b">{{ results|length }}</div>
                        <div style="font-size:0.8rem;color:#64748b">Total</div>
                    </div>
                </div>
                {% endif %}
            </div>
        {% endif %}

        {% if results %}
        <h5 style="font-weight:700;margin:24px 0 16px">Détail des réponses</h5>
        {% for r in results %}
            <div class="result-answer {{ r.isCorrect ? 'answer-correct' : 'answer-wrong' }}">
                <div class="d-flex align-items-start gap-3">
                    <div style="width:30px;height:30px;border-radius:50%;background:{{ r.isCorrect ? 'rgba(16,185,129,0.15)' : 'rgba(239,68,68,0.15)' }};display:flex;align-items:center;justify-content:center;flex-shrink:0">
                        <i class="bi bi-{{ r.isCorrect ? 'check-lg' : 'x-lg' }}" style="color:{{ r.isCorrect ? '#10b981' : '#ef4444' }};font-size:0.85rem"></i>
                    </div>
                    <div style="flex:1">
                        <div style="font-weight:700;margin-bottom:8px">Q{{ loop.index }}. {{ r.question.enonce }}</div>
                        <div style="font-size:0.9rem;color:{{ r.isCorrect ? '#047857' : '#b91c1c' }}">
                            <i class="bi bi-{{ r.isCorrect ? 'check-circle' : 'x-circle' }} me-1"></i>
                            Votre réponse : <strong>{{ r.userAnswer ? r.userAnswer.texte : 'Non répondu' }}</strong>
                        </div>
                        {% if not r.isCorrect and r.correctAnswer %}
                        <div style="font-size:0.9rem;color:#047857;margin-top:4px">
                            <i class="bi bi-check-circle me-1"></i>
                            Bonne réponse : <strong>{{ r.correctAnswer.texte }}</strong>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
        {% endif %}

        <div class="text-center mt-4 mb-5">
            {% if formationId %}
            <a href="{{ path('app_course_detail', {id: formationId}) }}" class="btn btn-primary-custom" style="width:auto;padding:14px 36px">
                <i class="bi bi-arrow-left me-2"></i>Retour à la formation
            </a>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
