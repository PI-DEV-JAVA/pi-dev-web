{# ── Navbar Scroll Effect ── #}
{% block javascripts %}
<!-- Driver.js for User Onboarding Tour -->
<script src="https://cdn.jsdelivr.net/npm/driver.js@1.0.1/dist/driver.js.iife.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/driver.js@1.0.1/dist/driver.css"/>

<script>
    const nav = document.getElementById('foNavbar');
    window.addEventListener('scroll', () => {
        nav.classList.toggle('scrolled', window.scrollY > 30);
    });
    if (window.scrollY > 30) nav.classList.add('scrolled');

    // ── Notification Panel ──
    const notifBellBtn = document.getElementById('notifBellBtn');
    const notifPanel = document.getElementById('notifPanel');
    const notifOverlay = document.getElementById('notifOverlay');
    const notifPanelBody = document.getElementById('notifPanelBody');
    let notifLoaded = false;

    function toggleNotifPanel() {
        const isOpen = notifPanel?.classList.toggle('open');
        notifOverlay?.classList.toggle('open', isOpen);
        if (isOpen && !notifLoaded) loadNotifications();
    }
    notifBellBtn?.addEventListener('click', toggleNotifPanel);
    notifOverlay?.addEventListener('click', () => {
        notifPanel?.classList.remove('open');
        notifOverlay?.classList.remove('open');
    });

    const notifTypeConfig = {
        OFFER_DECISION: { icon: 'briefcase', bg: 'rgba(16,185,129,0.1)', color: '#10b981' },
        REPLY: { icon: 'chat-dots', bg: 'rgba(6,182,212,0.1)', color: '#06b6d4' },
        INTERVIEW: { icon: 'camera-video', bg: 'rgba(245,158,11,0.1)', color: '#f59e0b' },
        ACTIVITY: { icon: 'clipboard-data', bg: 'rgba(99,102,241,0.1)', color: '#818cf8' },
        EVENT: { icon: 'calendar-event', bg: 'rgba(236,72,153,0.1)', color: '#ec4899' },
        COURSE: { icon: 'book', bg: 'rgba(139,92,246,0.1)', color: '#8b5cf6' },
        ENROLLMENT: { icon: 'person-check', bg: 'rgba(16,185,129,0.1)', color: '#10b981' },
        GENERAL: { icon: 'bell', bg: 'rgba(79,70,229,0.1)', color: '#4f46e5' }
    };

    function loadNotifications() {
        fetch('/notifications/list')
            .then(r => r.json())
            .then(items => {
                if (!notifPanelBody) return;
                if (items.length === 0) {
                    notifPanelBody.innerHTML = '<div style="padding:40px 20px;text-align:center;color:#94a3b8"><i class="bi bi-bell-slash" style="font-size:2rem;opacity:0.4"></i><p style="margin:12px 0 0;font-size:0.85rem">Aucune notification</p></div>';
                    return;
                }
                notifPanelBody.innerHTML = items.slice(0, 8).map(n => {
                    const cfg = notifTypeConfig[n.type] || notifTypeConfig.GENERAL;
                    const timeAgo = formatTimeAgo(n.createdAt);
                    return `<a href="/notifications/${n.id}/read" class="notif-item ${n.isRead ? '' : 'unread'}">
                        <div class="notif-icon" style="background:${cfg.bg};color:${cfg.color}"><i class="bi bi-${cfg.icon}"></i></div>
                        <div style="flex:1;min-width:0">
                            <div style="font-weight:${n.isRead ? 500 : 700};font-size:0.85rem;line-height:1.3">${n.title}</div>
                            ${n.message ? `<div style="font-size:0.8rem;color:#94a3b8;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${n.message}</div>` : ''}
                            <div style="font-size:0.72rem;color:#94a3b8;margin-top:4px">${timeAgo}</div>
                        </div>
                    </a>`;
                }).join('');
                notifLoaded = true;
            }).catch(() => {
                if (notifPanelBody) notifPanelBody.innerHTML = '<div style="padding:30px;text-align:center;color:#94a3b8;font-size:0.85rem">Impossible de charger</div>';
            });
    }

    function formatTimeAgo(dateStr) {
        const d = new Date(dateStr);
        const now = new Date();
        const diff = Math.floor((now - d) / 1000);
        if (diff < 60) return "À l'instant";
        if (diff < 3600) return Math.floor(diff/60) + ' min';
        if (diff < 86400) return Math.floor(diff/3600) + ' h';
        if (diff < 604800) return Math.floor(diff/86400) + ' j';
        return d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
    }

    // Badge polling
    function updateNotifBadge() {
        fetch('/notifications/count')
            .then(r => r.json())
            .then(data => {
                const badge = document.getElementById('notifBadge');
                if (badge) {
                    if (data.count > 0) {
                        badge.textContent = data.count > 9 ? '9+' : data.count;
                        badge.style.display = 'flex';
                    } else {
                        badge.style.display = 'none';
                    }
                }
            }).catch(() => {});
    }
    updateNotifBadge();
    setInterval(() => { updateNotifBadge(); notifLoaded = false; }, 30000);

    // ── Chat Messenger Widget ──
    const chatFab = document.getElementById('chatFab');
    const chatWidget = document.getElementById('chatWidget');
    const cwListView = document.getElementById('cwListView');
    const cwChatView = document.getElementById('cwChatView');
    const cwChatBody = document.getElementById('cwChatBody');
    const cwInput = document.getElementById('cwInput');
    const cwSendBtn = document.getElementById('cwSendBtn');
    const fabBadge = document.getElementById('fabBadge');
    let cwActiveSyncId = null;
    let cwLastMsgId = 0;
    let cwPollTimer = null;

    chatFab?.addEventListener('click', () => {
        chatWidget?.classList.toggle('open');
        if (chatWidget?.classList.contains('open') && !cwActiveSyncId) cwLoadContacts();
    });

    // Load conversation list
    function cwLoadContacts() {
        fetch('/messages?_fmt=contacts', {headers:{'X-Requested-With':'XMLHttpRequest'}})
            .then(r => r.text())
            .then(() => {
                // Use the poll endpoint to build contact list from syncs data
                fetch('/connect?tab=connections&_xhr=1', {headers:{'X-Requested-With':'XMLHttpRequest'}})
                    .catch(() => {});
            }).catch(() => {});
        // Simpler: just fetch contacts from a dedicated lightweight endpoint
        cwFetchContacts();
    }

    function cwFetchContacts() {
        fetch('/api/chat/contacts', {headers:{'X-Requested-With':'XMLHttpRequest'}})
            .then(r => r.json())
            .then(contacts => {
                const list = document.getElementById('chatContactList');
                if (!contacts || contacts.length === 0) {
                    list.innerHTML = '<div class="cw-empty"><i class="bi bi-chat-square-text"></i><p style="font-size:0.85rem;margin:4px 0 0">Aucune conversation</p><a href="/connect" style="color:var(--primary);font-size:0.8rem">Découvrir des personnes</a></div>';
                    return;
                }
                let totalUnread = 0;
                list.innerHTML = contacts.map(c => {
                    totalUnread += c.unread;
                    return `<div class="chat-contact" onclick="cwOpenChat(${c.syncId}, '${cwEsc(c.name)}', '${cwEsc(c.avatar)}', '${cwEsc(c.initial)}')"><div class="chat-contact-avatar">${c.avatar ? '<img src="'+cwEsc(c.avatar)+'" alt="">' : cwEsc(c.initial)}</div><div class="chat-contact-info"><div class="chat-contact-name">${cwEsc(c.name)}</div><div class="chat-contact-preview">${c.lastMsg ? cwEsc(c.lastMsg) : 'Démarrez la conversation'}</div></div>${c.unread > 0 ? '<span class="chat-contact-unread">'+c.unread+'</span>' : ''}</div>`;
                }).join('');
                if (totalUnread > 0) { fabBadge.textContent = totalUnread; fabBadge.style.display = 'flex'; }
                else { fabBadge.style.display = 'none'; }
            })
            .catch(() => {});
    }

    // Open a chat inside the widget
    function cwOpenChat(syncId, name, avatar, initial) {
        cwActiveSyncId = syncId;
        cwLastMsgId = 0;
        document.getElementById('cwChatName').textContent = name;
        const av = document.getElementById('cwChatAvatar');
        av.innerHTML = avatar ? '<img src="'+avatar+'" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:50%">' : initial;
        cwChatBody.innerHTML = '<div class="cw-empty"><i class="bi bi-hourglass-split"></i></div>';
        cwListView.style.display = 'none';
        cwChatView.classList.add('active');
        cwLoadMessages();
        if (cwPollTimer) clearInterval(cwPollTimer);
        cwPollTimer = setInterval(cwLoadMessages, 4000);
    }

    function cwBack() {
        cwActiveSyncId = null;
        if (cwPollTimer) { clearInterval(cwPollTimer); cwPollTimer = null; }
        cwChatView.classList.remove('active');
        cwListView.style.display = '';
        cwFetchContacts();
    }

    function cwLoadMessages() {
        if (!cwActiveSyncId) return;
        fetch('/messages/' + cwActiveSyncId + '/poll?after=' + cwLastMsgId)
            .then(r => r.json())
            .then(msgs => {
                if (cwLastMsgId === 0) cwChatBody.innerHTML = '';
                if (msgs.length === 0 && cwLastMsgId === 0) {
                    cwChatBody.innerHTML = '<div class="cw-empty" style="margin:auto"><p style="font-size:0.85rem">👋 Dites bonjour !</p></div>';
                }
                msgs.forEach(m => {
                    if (m.id <= cwLastMsgId && cwLastMsgId > 0) return;
                    if (m.isMine && m.id <= cwLastMsgId) return;
                    const empty = cwChatBody.querySelector('.cw-empty');
                    if (empty) empty.remove();
                    const row = document.createElement('div');
                    row.className = 'cw-bubble-row ' + (m.isMine ? 'mine' : '');
                    row.innerHTML = '<div class="cw-bubble '+(m.isMine?'mine':'theirs')+'">'+cwEsc(m.message)+'<div class="cw-time">'+m.time+'</div></div>';
                    cwChatBody.appendChild(row);
                    cwLastMsgId = Math.max(cwLastMsgId, m.id);
                });
                cwChatBody.scrollTop = cwChatBody.scrollHeight;
            }).catch(() => {});
    }

    // Send message
    function cwSend() {
        const text = cwInput.value.trim();
        if (!text || !cwActiveSyncId) return;
        const empty = cwChatBody.querySelector('.cw-empty');
        if (empty) empty.remove();
        const row = document.createElement('div');
        row.className = 'cw-bubble-row mine';
        row.innerHTML = '<div class="cw-bubble mine">'+cwEsc(text)+'<div class="cw-time">'+new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})+'</div></div>';
        cwChatBody.appendChild(row);
        cwChatBody.scrollTop = cwChatBody.scrollHeight;
        cwInput.value = '';
        fetch('/messages/' + cwActiveSyncId + '/send', {
            method: 'POST',
            headers: {'Content-Type':'application/x-www-form-urlencoded','X-Requested-With':'XMLHttpRequest'},
            body: 'message=' + encodeURIComponent(text)
        });
    }
    cwSendBtn?.addEventListener('click', cwSend);
    cwInput?.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); cwSend(); } });

    function cwEsc(t) { const d = document.createElement('div'); d.textContent = t||''; return d.innerHTML; }

    // Refresh contacts every 15s for unread badge
    setInterval(cwFetchContacts, 15000);
    setTimeout(cwFetchContacts, 1000);
</script>

{# ═══════ AI CHATBOT WIDGET (available to all visitors) ═══════ #}
<div class="ai-tooltip" id="aiTooltip">
    <span style="margin-right:4px">💡</span> Besoin d'aide ? Essayez notre assistante IA !
    <button onclick="document.getElementById('aiTooltip').classList.remove('show')" style="background:none;border:none;color:#94a3b8;font-size:0.8rem;cursor:pointer;margin-left:4px"><i class="bi bi-x"></i></button>
</div>

<div class="ai-fab" id="aiFab" onclick="toggleAiChat()">
    <img src="/images/chatbot_avatar.png" alt="Sara AI">
    <div class="ai-fab-pulse"></div>
</div>

<div class="ai-chat" id="aiChat">
    <div class="ai-chat-header">
        <div class="ai-hdr-avatar"><img src="/images/chatbot_avatar.png" alt="Sara"></div>
        <div class="ai-hdr-info">
            <h6>Sara — Assistante IA</h6>
            <span><i class="bi bi-circle-fill" style="font-size:0.5rem;color:#34d399;margin-right:4px"></i>En ligne</span>
        </div>
        <button class="ai-hdr-close" onclick="toggleAiChat()"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="ai-chat-body" id="aiChatBody">
        <div class="ai-msg">
            <div class="ai-msg-avatar"><img src="/images/chatbot_avatar.png" alt="Sara"></div>
            <div class="ai-msg-bubble">Bonjour ! 👋 Je suis Sara, votre assistante Talentos. Je peux vous aider avec la recherche d'emploi, votre CV, la préparation aux entretiens, et l'utilisation de la plateforme. Comment puis-je vous aider ?</div>
        </div>
    </div>
    <div class="ai-chat-footer">
        <div class="ai-chat-input-wrap">
            <input type="text" id="aiInput" placeholder="Posez votre question..." autocomplete="off"
                   onkeydown="if(event.key==='Enter'){event.preventDefault();sendAiMsg()}">
            <button onclick="sendAiMsg()" id="aiSendBtn"><i class="bi bi-send-fill"></i></button>
        </div>
        <div class="ai-chat-limit" id="aiLimit"></div>
    </div>
</div>

<script>
var aiOpen = false;
var aiHistory = [];
var aiSending = false;

function toggleAiChat() {
    aiOpen = !aiOpen;
    document.getElementById('aiChat').classList.toggle('open', aiOpen);
    document.getElementById('aiTooltip').classList.remove('show');
    if (aiOpen) setTimeout(() => document.getElementById('aiInput').focus(), 300);
}

function sendAiMsg() {
    if (aiSending) return;
    var input = document.getElementById('aiInput');
    var msg = input.value.trim();
    if (!msg) return;

    input.value = '';
    appendAiMsg(msg, 'user');
    aiHistory.push({role: 'user', content: msg});
    aiSending = true;
    document.getElementById('aiSendBtn').disabled = true;

    // Typing indicator
    var typing = document.createElement('div');
    typing.className = 'ai-msg';
    typing.id = 'aiTyping';
    typing.innerHTML = '<div class="ai-msg-avatar"><img src="/images/chatbot_avatar.png" alt="Sara"></div><div class="ai-msg-bubble"><div class="ai-typing"><span></span><span></span><span></span></div></div>';
    document.getElementById('aiChatBody').appendChild(typing);
    scrollAiChat();

    fetch('/api/chatbot', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
        body: JSON.stringify({message: msg, history: aiHistory})
    })
    .then(r => r.json())
    .then(data => {
        var t = document.getElementById('aiTyping');
        if (t) t.remove();
        appendAiMsg(data.message, 'bot');
        if (data.success) aiHistory.push({role: 'assistant', content: data.message});
        if (data.remaining !== undefined) {
            document.getElementById('aiLimit').textContent = data.remaining > 0
                ? data.remaining + ' message' + (data.remaining > 1 ? 's' : '') + ' restant' + (data.remaining > 1 ? 's' : '')
                : 'Limite atteinte pour aujourd\'hui';
        }
        aiSending = false;
        document.getElementById('aiSendBtn').disabled = false;
    })
    .catch(() => {
        var t = document.getElementById('aiTyping');
        if (t) t.remove();
        appendAiMsg('Oups, une erreur est survenue. Réessayez.', 'bot');
        aiSending = false;
        document.getElementById('aiSendBtn').disabled = false;
    });
}

function appendAiMsg(text, type) {
    var body = document.getElementById('aiChatBody');
    var div = document.createElement('div');
    div.className = 'ai-msg' + (type === 'user' ? ' user' : '');
    if (type === 'user') {
        div.innerHTML = '<div class="ai-msg-bubble">' + escAi(text) + '</div>';
    } else {
        div.innerHTML = '<div class="ai-msg-avatar"><img src="/images/chatbot_avatar.png" alt="Sara"></div><div class="ai-msg-bubble">' + escAi(text) + '</div>';
    }
    body.appendChild(div);
    scrollAiChat();
}

function scrollAiChat() { var b = document.getElementById('aiChatBody'); b.scrollTop = b.scrollHeight; }
function escAi(t) { var d = document.createElement('div'); d.textContent = t||''; return d.innerHTML; }

// Periodic tooltip
var aiTooltipShown = 0;
function showAiTooltip() {
    if (aiOpen || aiTooltipShown >= 3) return;
    aiTooltipShown++;
    var tip = document.getElementById('aiTooltip');
    tip.classList.add('show');
    setTimeout(() => tip.classList.remove('show'), 6000);
}
setTimeout(showAiTooltip, 8000);
setInterval(showAiTooltip, 60000);

