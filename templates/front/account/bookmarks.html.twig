{% extends 'front/_base.html.twig' %}

{% block title %}Mes favoris — Talentos{% endblock %}

{% block content %}
<div class="fo-page-header">
    <div class="container">
        <h1>Mes offres favorites</h1>
        <p>Retrouvez rapidement les offres qui vous intéressent</p>
    </div>
</div>

<section class="fo-section" style="padding-top:40px">
    <div class="container">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mb-3"><i class="bi bi-check-circle-fill me-2"></i>{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('info') %}
            <div class="alert alert-info mb-3"><i class="bi bi-info-circle-fill me-2"></i>{{ message }}</div>
        {% endfor %}

        <div class="d-flex gap-3 mb-4 border-bottom pb-2">
            <a href="{{ path('app_offers') }}" class="btn btn-sm text-secondary" style="font-weight:500; border-bottom: 2px solid transparent; border-radius: 0; padding-bottom: 8px;">Toutes les offres</a>
            <a href="{{ path('app_my_bookmarks') }}" class="btn btn-sm" style="font-weight:600; color: var(--primary); border-bottom: 2px solid var(--primary); border-radius: 0; padding-bottom: 8px;">Mes favoris</a>
        </div>

        {% if bookmarks is empty %}
            <div class="fo-card text-center" style="padding:60px">
                <i class="bi bi-bookmark-x" style="font-size:3rem;color:var(--fo-text-secondary)"></i>
                <p class="mt-3" style="color:var(--fo-text-secondary)">Aucune offre dans vos favoris pour le moment.</p>
                <a href="{{ path('app_offers') }}" class="btn btn-primary-custom mt-2" style="display:inline-block;width:auto">Explorer les offres</a>
            </div>
        {% else %}
            <div class="row g-3">
                {% for bookmark in bookmarks %}
                    <div class="col-md-6">
                        <div class="fo-card">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 style="font-weight:700;margin:0">{{ bookmark.offer ? bookmark.offer.title : 'Offre supprimée' }}</h6>
                                {% if bookmark.offer %}
                                    <a href="{{ path('app_offer_bookmark', {id: bookmark.offer.id}) }}" class="btn btn-sm btn-outline-danger" title="Retirer des favoris" style="border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;padding:0">
                                        <i class="bi bi-bookmark-x-fill"></i>
                                    </a>
                                {% endif %}
                            </div>
                            <div style="color:var(--fo-text-secondary);font-size:0.85rem">
                                <i class="bi bi-calendar-plus me-1"></i>Ajouté le {{ bookmark.createdAt|date('d/m/Y') }}
                                {% if bookmark.offer and bookmark.offer.contractType %}
                                    · {{ bookmark.offer.contractType }}
                                {% endif %}
                            </div>
                            {% if bookmark.offer %}
                                <div class="mt-3 d-flex gap-2">
                                    <a href="{{ path('app_offer_detail', {id: bookmark.offer.id}) }}" class="btn btn-sm btn-primary-custom" style="padding:6px 12px">
                                        Consulter l'offre
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
