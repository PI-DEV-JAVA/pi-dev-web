{% extends 'back/_base.html.twig' %}
{% block page_title %}Gestion des formations{% endblock %}
{% block content %}
{# Header + Search + New button #}
<div class="d-flex align-items-center justify-content-between" style="margin-bottom:20px;flex-wrap:wrap;gap:12px">
    <h5 style="font-weight:700;margin:0"><i class="bi bi-book me-2" style="color:var(--accent)"></i>Formations (<span id="fCount">{{ formations|length }}</span>)</h5>
    <div class="d-flex align-items-center gap-3">
        <div style="position:relative;width:300px">
            <i class="bi bi-search" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--bo-text-secondary);font-size:0.85rem"></i>
            <input type="text" id="searchInput" placeholder="Rechercher par titre, niveau..."
                   style="width:100%;padding:10px 14px 10px 38px;border-radius:10px;border:1.5px solid var(--bo-border);background:var(--bo-bg-input);color:var(--bo-text);font-size:0.85rem;transition:border-color 0.2s"
                   onfocus="this.style.borderColor='var(--primary-light)'" onblur="this.style.borderColor='var(--bo-border)'">
        </div>
        <a href="{{ path('admin_course_new') }}" class="bo-btn bo-btn-primary" style="white-space:nowrap"><i class="bi bi-plus-lg me-1"></i> Nouvelle formation</a>
    </div>
</div>

{% for message in app.flashes('success') %}
    <div class="alert" style="background:rgba(16,185,129,0.1);color:#10b981;border:1px solid rgba(16,185,129,0.2);border-radius:12px;padding:12px;font-size:0.85rem;margin-bottom:16px">
        <i class="bi bi-check-circle-fill me-2"></i>{{ message }}
    </div>
{% endfor %}

<div class="bo-card" style="overflow-x:auto">
    <table class="bo-table" id="fTable">
        <thead>
            <tr>
                <th style="cursor:pointer;user-select:none" onclick="sortTable(0)">
                    <span class="d-flex align-items-center gap-1">Titre <i class="bi bi-arrow-up sort-icon" id="sort-0" style="font-size:0.7rem;opacity:0.4;transition:all 0.2s"></i></span>
                </th>
                <th style="cursor:pointer;user-select:none" onclick="sortTable(1)">
                    <span class="d-flex align-items-center gap-1">Durée <i class="bi bi-arrow-up sort-icon" id="sort-1" style="font-size:0.7rem;opacity:0.4;transition:all 0.2s"></i></span>
                </th>
                <th style="cursor:pointer;user-select:none" onclick="sortTable(2)">
                    <span class="d-flex align-items-center gap-1">Niveau <i class="bi bi-arrow-up sort-icon" id="sort-2" style="font-size:0.7rem;opacity:0.4;transition:all 0.2s"></i></span>
                </th>
                <th style="cursor:pointer;user-select:none" onclick="sortTable(3)">
                    <span class="d-flex align-items-center gap-1">Début <i class="bi bi-arrow-up sort-icon" id="sort-3" style="font-size:0.7rem;opacity:0.4;transition:all 0.2s"></i></span>
                </th>
                <th>Séances</th>
                <th>Quiz</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="fBody">
            {% for f in formations %}
                <tr>
                    <td style="font-weight:600">{{ f.titre }}</td>
                    <td data-num="{{ f.duree ?: 0 }}">{{ f.duree ?: '—' }}h</td>
                    <td><span class="bo-badge bo-badge-warning">{{ f.niveau ?: 'Tous' }}</span></td>
                    <td style="color:var(--bo-text-secondary)" data-date="{{ f.dateDebut ? f.dateDebut|date('Y-m-d') : '' }}">{{ f.dateDebut ? f.dateDebut|date('d/m/Y') : '—' }}</td>
                    <td><span class="bo-badge bo-badge-primary">{{ f.seances|length }}</span></td>
                    <td><span class="bo-badge bo-badge-accent" style="background:rgba(6,182,212,0.15);color:var(--accent)">{{ f.quizzes|length }}</span></td>
                    <td>
                        <div class="d-flex gap-1">
                            <a href="{{ path('admin_course_edit', {id: f.id}) }}" class="bo-action-btn" title="Gérer"><i class="bi bi-pencil"></i></a>
                            <a href="{{ path('admin_course_enrollments', {id: f.id}) }}" class="bo-action-btn" title="Voir les candidats" style="background:rgba(99,102,241,0.12);color:#6366f1"><i class="bi bi-people-fill"></i></a>
                            <button type="button" class="bo-action-btn danger" title="Supprimer" onclick="confirmDelete({{ f.id }}, '{{ f.titre|e('js') }}')" style="border:none;cursor:pointer"><i class="bi bi-trash"></i></button>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr id="emptyRow"><td colspan="7" class="text-center" style="padding:30px;color:var(--bo-text-secondary)">Aucune formation.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    <div id="noResults" style="display:none;text-align:center;padding:40px 20px;color:var(--bo-text-secondary)">
        <i class="bi bi-search" style="font-size:2rem;opacity:0.3;display:block;margin-bottom:8px"></i>
        Aucune formation trouvée
    </div>
</div>

{# Delete modal #}
<div id="deleteModal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;z-index:9999;background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);align-items:center;justify-content:center">
    <div style="background:var(--bo-bg-card);border-radius:16px;padding:32px;max-width:400px;width:90%;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,0.3);border:1px solid var(--bo-border)">
        <div style="width:56px;height:56px;border-radius:14px;background:rgba(239,68,68,0.1);display:inline-flex;align-items:center;justify-content:center;margin-bottom:16px">
            <i class="bi bi-exclamation-triangle-fill" style="font-size:1.5rem;color:#ef4444"></i>
        </div>
        <h5 style="font-weight:700;margin-bottom:8px">Supprimer cette formation ?</h5>
        <p style="color:var(--bo-text-secondary);font-size:0.9rem;margin-bottom:24px">
            <strong id="deleteTitle" style="color:var(--bo-text)"></strong>, ses séances et ses quiz seront supprimés.
        </p>
        <div class="d-flex gap-2 justify-content-center">
            <button onclick="closeDeleteModal()" class="btn" style="padding:10px 24px;border-radius:10px;font-weight:600;font-size:0.85rem;border:1.5px solid var(--bo-border);color:var(--bo-text);background:transparent">Annuler</button>
            <a id="deleteLink" href="#" class="btn" style="padding:10px 24px;border-radius:10px;font-weight:600;font-size:0.85rem;background:#ef4444;color:white;border:none;text-decoration:none">
                <i class="bi bi-trash3 me-1"></i> Supprimer
            </a>
        </div>
    </div>
</div>

<script>
function confirmDelete(id, title) { document.getElementById('deleteTitle').textContent = title; document.getElementById('deleteLink').href = '/admin/courses/' + id + '/delete'; document.getElementById('deleteModal').style.display = 'flex'; }
function closeDeleteModal() { document.getElementById('deleteModal').style.display = 'none'; }
document.getElementById('deleteModal').addEventListener('click', function(e) { if (e.target === this) closeDeleteModal(); });

var searchInput = document.getElementById('searchInput'), tbody = document.getElementById('fBody'), fCount = document.getElementById('fCount'), noResults = document.getElementById('noResults');
searchInput.addEventListener('input', function() {
    var q = this.value.toLowerCase().trim(), rows = tbody.querySelectorAll('tr:not(#emptyRow)'), visible = 0;
    rows.forEach(function(r) { var m = q === '' || r.textContent.toLowerCase().includes(q); r.style.display = m ? '' : 'none'; if (m) visible++; });
    fCount.textContent = visible; noResults.style.display = (visible === 0 && rows.length > 0) ? 'block' : 'none';
});

var currentSort = { col: -1, asc: true };
function sortTable(colIndex) {
    var rows = Array.from(tbody.querySelectorAll('tr:not(#emptyRow)')); if (!rows.length) return;
    currentSort.asc = currentSort.col === colIndex ? !currentSort.asc : true; currentSort.col = colIndex;
    document.querySelectorAll('.sort-icon').forEach(function(i) { i.className = 'bi bi-arrow-up sort-icon'; i.style.opacity = '0.4'; });
    var icon = document.getElementById('sort-' + colIndex); icon.className = currentSort.asc ? 'bi bi-arrow-up sort-icon' : 'bi bi-arrow-down sort-icon'; icon.style.opacity = '1';
    rows.sort(function(a, b) {
        if (colIndex === 1) { return currentSort.asc ? (parseFloat(a.cells[1].getAttribute('data-num'))||0) - (parseFloat(b.cells[1].getAttribute('data-num'))||0) : (parseFloat(b.cells[1].getAttribute('data-num'))||0) - (parseFloat(a.cells[1].getAttribute('data-num'))||0); }
        if (colIndex === 3) { var ad = a.cells[3].getAttribute('data-date')||'', bd = b.cells[3].getAttribute('data-date')||''; return currentSort.asc ? (ad<bd?-1:ad>bd?1:0) : (ad>bd?-1:ad<bd?1:0); }
        var aT = a.cells[colIndex].textContent.trim().toLowerCase(), bT = b.cells[colIndex].textContent.trim().toLowerCase();
        return currentSort.asc ? (aT<bT?-1:aT>bT?1:0) : (aT>bT?-1:aT<bT?1:0);
    });
    rows.forEach(function(r) { tbody.appendChild(r); });
}
</script>
{% endblock %}
