{% extends 'front/_base.html.twig' %}

{% block title %}{{ offer.title }} — Talentos{% endblock %}

{% block content %}
<div class="fo-page-header">
    <div class="container">
        <a href="{{ path('app_offers') }}" style="color:var(--primary);text-decoration:none;font-size:0.85rem;font-weight:500">
            <i class="bi bi-arrow-left me-1"></i> Retour aux offres
        </a>
        <h1 class="mt-2" style="font-size:1.6rem">{{ offer.title }}</h1>
        <div class="d-flex gap-2 mt-2 flex-wrap align-items-center">
            {% if offer.contractType %}<span class="fo-badge fo-badge-primary">{{ offer.contractType }}</span>{% endif %}
            {% if offer.experienceLevel %}<span class="fo-badge fo-badge-accent">{{ offer.experienceLevel }}</span>{% endif %}
            {% if offer.status %}<span class="fo-badge fo-badge-success">{{ offer.status }}</span>{% endif %}
            {% if offer.publishDate %}
                <span style="font-size:0.78rem;color:var(--fo-text-secondary);margin-left:8px"><i class="bi bi-clock me-1"></i>Publiée le {{ offer.publishDate|date('d/m/Y') }}</span>
            {% endif %}
        </div>
    </div>
</div>

<section class="fo-section" style="padding-top:32px">
    <div class="container">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mb-3"><i class="bi bi-check-circle-fill me-2"></i>{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger mb-3"><i class="bi bi-exclamation-circle-fill me-2"></i>{{ message }}</div>
        {% endfor %}

        <div class="row g-4">
            {# ════════ LEFT COLUMN ════════ #}
            <div class="col-lg-8">
                {# Quick info bar #}
                <div class="fo-card d-flex flex-wrap gap-4" style="padding:16px 20px;margin-bottom:20px">
                    {% if offer.location %}
                    <div class="d-flex align-items-center gap-2">
                        <div style="width:32px;height:32px;border-radius:8px;background:rgba(79,70,229,0.06);display:flex;align-items:center;justify-content:center"><i class="bi bi-geo-alt" style="color:var(--primary);font-size:0.9rem"></i></div>
                        <div><div style="font-size:0.65rem;color:var(--fo-text-secondary);text-transform:uppercase;font-weight:600">Lieu</div><div style="font-weight:600;font-size:0.85rem">{{ offer.location }}</div></div>
                    </div>
                    {% endif %}
                    {% if offer.salaryMin and offer.salaryMax %}
                    <div class="d-flex align-items-center gap-2">
                        <div style="width:32px;height:32px;border-radius:8px;background:rgba(16,185,129,0.06);display:flex;align-items:center;justify-content:center"><i class="bi bi-cash-stack" style="color:#10b981;font-size:0.9rem"></i></div>
                        <div><div style="font-size:0.65rem;color:var(--fo-text-secondary);text-transform:uppercase;font-weight:600">Salaire</div><div style="font-weight:600;font-size:0.85rem">{{ offer.salaryMin|number_format(0,',',' ') }} — {{ offer.salaryMax|number_format(0,',',' ') }} DT</div></div>
                    </div>
                    {% endif %}
                    {% if offer.department %}
                    <div class="d-flex align-items-center gap-2">
                        <div style="width:32px;height:32px;border-radius:8px;background:rgba(245,158,11,0.06);display:flex;align-items:center;justify-content:center"><i class="bi bi-building" style="color:#f59e0b;font-size:0.9rem"></i></div>
                        <div><div style="font-size:0.65rem;color:var(--fo-text-secondary);text-transform:uppercase;font-weight:600">Département</div><div style="font-weight:600;font-size:0.85rem">{{ offer.department }}</div></div>
                    </div>
                    {% endif %}
                    <div class="d-flex align-items-center gap-2">
                        <div style="width:32px;height:32px;border-radius:8px;background:rgba(124,58,237,0.06);display:flex;align-items:center;justify-content:center"><i class="bi bi-people" style="color:#7c3aed;font-size:0.9rem"></i></div>
                        <div><div style="font-size:0.65rem;color:var(--fo-text-secondary);text-transform:uppercase;font-weight:600">Postes</div><div style="font-weight:600;font-size:0.85rem">{{ offer.positionsAvailable }} disponible(s)</div></div>
                    </div>
                </div>

                {# Description #}
                <div class="fo-card" style="margin-bottom:20px">
                    <h5 style="font-weight:700;margin-bottom:16px"><i class="bi bi-text-paragraph me-2" style="color:var(--primary);font-size:0.9rem"></i>Description du poste</h5>
                    <div style="color:var(--fo-text-secondary);line-height:1.8;white-space:pre-line;font-size:0.92rem">{{ offer.description|default('Aucune description disponible.') }}</div>
                </div>

                {# Closing date warning #}
                {% if offer.closingDate %}
                <div class="fo-card d-flex align-items-center gap-3" style="padding:14px 20px;margin-bottom:20px;border-left:3px solid {{ offer.closingDate|date('U') > 'now'|date('U') ? '#f59e0b' : '#ef4444' }}">
                    <i class="bi bi-calendar-x" style="font-size:1.2rem;color:{{ offer.closingDate|date('U') > 'now'|date('U') ? '#f59e0b' : '#ef4444' }}"></i>
                    <div>
                        <div style="font-weight:600;font-size:0.88rem">Date limite : {{ offer.closingDate|date('d/m/Y') }}</div>
                        <div style="font-size:0.75rem;color:var(--fo-text-secondary)">
                            {% if offer.closingDate|date('U') > 'now'|date('U') %}
                                Dépêchez-vous de postuler avant la clôture !
                            {% else %}
                                Cette offre est clôturée.
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% endif %}
            </div>

            {# ════════ RIGHT COLUMN ════════ #}
            <div class="col-lg-4">
                <div style="position:sticky;top:100px;display:flex;flex-direction:column;gap:16px">

                {# ── Recruiter Card ── #}
                {% if offer.recruiter %}
                <div class="fo-card" style="padding:20px">
                    <h6 style="font-weight:700;margin-bottom:14px;font-size:0.85rem"><i class="bi bi-person-badge me-2" style="color:var(--primary)"></i>Recruteur</h6>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        {% if offer.recruiter.profile and offer.recruiter.profile.profilePicturePath %}
                            <img src="{{ offer.recruiter.profile.profilePicturePath }}" style="width:48px;height:48px;border-radius:50%;object-fit:cover;border:2px solid rgba(79,70,229,0.15)" alt="">
                        {% else %}
                            <div style="width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--accent));display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:1rem;flex-shrink:0">
                                {{ offer.recruiter.email|first|upper }}
                            </div>
                        {% endif %}
                        <div style="flex:1;min-width:0">
                            <div style="font-weight:700;font-size:0.9rem">
                                {% if offer.recruiter.profile and offer.recruiter.profile.firstName %}
                                    {{ offer.recruiter.profile.firstName }} {{ offer.recruiter.profile.lastName|default('') }}
                                {% else %}
                                    {{ offer.recruiter.email|split('@')[0] }}
                                {% endif %}
                            </div>
                            {% if offer.recruiter.profile and offer.recruiter.profile.professionalTitle %}
                                <div style="font-size:0.75rem;color:var(--fo-text-secondary)">{{ offer.recruiter.profile.professionalTitle }}</div>
                            {% else %}
                                <div style="font-size:0.75rem;color:var(--fo-text-secondary)">Responsable RH</div>
                            {% endif %}
                        </div>
                    </div>
                    <div style="font-size:0.78rem;color:var(--fo-text-secondary)">
                        <div class="mb-1"><i class="bi bi-envelope me-2" style="color:var(--primary);opacity:0.6"></i>{{ offer.recruiter.email }}</div>
                        {% if offer.recruiter.profile and offer.recruiter.profile.phoneNumber %}
                            <div class="mb-1"><i class="bi bi-telephone me-2" style="color:var(--primary);opacity:0.6"></i>{{ offer.recruiter.profile.phoneNumber }}</div>
                        {% endif %}
                        {% if offer.recruiter.profile and offer.recruiter.profile.location %}
                            <div><i class="bi bi-geo-alt me-2" style="color:var(--primary);opacity:0.6"></i>{{ offer.recruiter.profile.location }}</div>
                        {% endif %}
                    </div>
                </div>
                {% endif %}

                {# AI Match Analyzer #}
                {% if app.user %}
                    <div class="fo-card" style="border:1px solid #c7d2fe;background:linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);padding:20px">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 style="font-weight:700;color:#3730a3;margin:0;font-size:0.85rem"><i class="bi bi-magic me-2"></i>Compatibilité</h6>
                            <span class="badge bg-primary" style="opacity:0.8;font-size:0.6rem">BETA</span>
                        </div>
                        <div id="aiMatchContent">
                            <p style="font-size:0.8rem;color:var(--fo-text-secondary);margin-bottom:10px">Analysez votre profil vs. cette offre.</p>
                            <button class="btn btn-sm w-100" id="btnRunMatch" style="background:#4f46e5;color:white;font-weight:600;border-radius:8px;font-size:0.82rem" onclick="fetchAiMatch({{ offer.id }})">
                                <i class="bi bi-stars me-1"></i>Lancer l'analyse
                            </button>
                        </div>
                    </div>
                {% endif %}

                {# Apply Card #}
                <div class="fo-card" style="padding:20px">
                    {% if app.user %}
                        {% if alreadyApplied %}
                            <div class="text-center" style="padding:12px 0">
                                <div style="width:48px;height:48px;border-radius:50%;background:rgba(16,185,129,0.1);display:inline-flex;align-items:center;justify-content:center;margin-bottom:10px">
                                    <i class="bi bi-check-lg" style="font-size:1.3rem;color:var(--success)"></i>
                                </div>
                                <h6 style="font-weight:700;font-size:0.9rem">Candidature envoyée !</h6>
                                <p style="color:var(--fo-text-secondary);font-size:0.82rem;margin:0">Statut : <strong>{{ application.status }}</strong></p>
                            </div>
                        {% else %}
                            <h6 style="font-weight:700;margin-bottom:14px;font-size:0.9rem"><i class="bi bi-send me-2" style="color:var(--primary)"></i>Postuler</h6>
                            <form method="post" action="{{ path('app_offer_apply', {id: offer.id}) }}" enctype="multipart/form-data" class="fo-form">
                                <div class="mb-3">
                                    <label style="font-size:0.82rem">Lettre de motivation</label>
                                    <textarea name="motivation" class="form-control" rows="3" placeholder="Pourquoi ce poste vous intéresse ?" style="font-size:0.85rem"></textarea>
                                </div>
                                <div class="mb-3">
                                    <label style="font-size:0.82rem">CV (PDF)</label>
                                    <input type="file" name="cv" class="form-control" accept=".pdf,.doc,.docx" style="font-size:0.85rem">
                                </div>
                                <button type="submit" class="btn btn-primary-custom w-100" style="font-size:0.88rem">
                                    <i class="bi bi-send me-2"></i>Envoyer ma candidature
                                </button>
                            </form>
                        {% endif %}

                        <hr style="margin:14px 0;border-color:var(--fo-border)">
                        <a href="{{ path('app_offer_bookmark', {id: offer.id}) }}" class="btn w-100"
                           style="border:1.5px solid var(--fo-border);border-radius:10px;padding:8px;font-weight:600;font-size:0.82rem;color:{{ bookmarked ? 'var(--warning)' : 'var(--fo-text-secondary)' }}">
                            <i class="bi bi-{{ bookmarked ? 'bookmark-fill' : 'bookmark' }} me-1"></i>
                            {{ bookmarked ? 'Retirer des favoris' : 'Sauvegarder' }}
                        </a>
                    {% else %}
                        <div class="text-center" style="padding:16px 0">
                            <i class="bi bi-person-lock" style="font-size:2rem;color:var(--fo-text-secondary)"></i>
                            <p class="mt-2" style="color:var(--fo-text-secondary);font-size:0.85rem;margin-bottom:12px">Connectez-vous pour postuler</p>
                            <a href="{{ path('app_login') }}" class="btn btn-primary-custom w-100" style="font-size:0.85rem">Se connecter</a>
                        </div>
                    {% endif %}
                </div>

                {# AI Insights #}
                <div class="fo-card" style="padding:20px">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 style="font-weight:700;margin:0;font-size:0.85rem"><i class="bi bi-lightbulb text-warning me-2"></i>Insights</h6>
                        <span style="font-size:0.6rem;color:var(--fo-text-secondary)">⚡ AI</span>
                    </div>
                    <div id="aiInsightsContent">
                        <div class="placeholder-glow">
                            <span class="placeholder col-12" style="border-radius:4px;margin-bottom:6px"></span>
                            <span class="placeholder col-8" style="border-radius:4px;margin-bottom:6px"></span>
                            <span class="placeholder col-10" style="border-radius:4px;margin-bottom:12px"></span>
                            <span class="placeholder col-12" style="border-radius:4px;margin-bottom:6px"></span>
                            <span class="placeholder col-9" style="border-radius:4px"></span>
                        </div>
                    </div>
                </div>

                </div> {# End Sticky #}
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        fetchAiInsights({{ offer.id }});
    });

    function fetchAiMatch(offerId) {
        const contentBox = document.getElementById('aiMatchContent');
        contentBox.innerHTML = '<div class="text-center py-2"><div class="spinner-border text-primary spinner-border-sm" role="status"></div><div class="mt-2 text-muted" style="font-size:0.75rem">Analyse en cours (10-15s)...</div></div>';
        
        fetch('/api/offers/' + offerId + '/match')
            .then(response => response.json())
            .then(data => {
                if (data.error) {
                    contentBox.innerHTML = `<div class="alert alert-warning mb-0" style="font-size:0.8rem"><i class="bi bi-info-circle me-1"></i>${data.error}</div>`;
                    return;
                }
                let score = parseInt(data.score) || 0;
                let scoreColor = score >= 75 ? '#10b981' : (score >= 50 ? '#f59e0b' : '#ef4444');
                let strengths = Array.isArray(data.strengths) ? data.strengths : ['Analyse non disponible'];
                let weaknesses = Array.isArray(data.weaknesses) ? data.weaknesses : ['Complétez votre profil'];
                
                contentBox.innerHTML = `
                    <div class="text-center mb-3">
                        <div style="width:60px;height:60px;border-radius:50%;background:conic-gradient(${scoreColor} ${score}%, #e2e8f0 ${score}%);display:inline-flex;align-items:center;justify-content:center;position:relative">
                            <div style="position:absolute;inset:5px;background:white;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;color:${scoreColor};font-size:1rem">${score}%</div>
                        </div>
                    </div>
                    <div style="font-size:0.8rem">
                        <strong style="color:#10b981"><i class="bi bi-check2-circle me-1"></i>Atouts:</strong>
                        <ul class="text-muted ps-3 mb-2" style="font-size:0.75rem">
                            ${strengths.map(s => '<li>' + s + '</li>').join('')}
                        </ul>
                        <strong style="color:#ef4444"><i class="bi bi-exclamation-circle me-1"></i>À améliorer:</strong>
                        <ul class="text-muted ps-3 mb-0" style="font-size:0.75rem">
                            ${weaknesses.map(w => '<li>' + w + '</li>').join('')}
                        </ul>
                    </div>
                `;
            })
            .catch(() => {
                contentBox.innerHTML = '<div class="text-muted" style="font-size:0.8rem"><i class="bi bi-wifi-off me-1"></i>Service indisponible.</div>';
            });
    }

    function fetchAiInsights(offerId) {
        fetch('/api/offers/' + offerId + '/insights')
            .then(r => r.json())
            .then(data => {
                const box = document.getElementById('aiInsightsContent');
                let salary = data.salary_estimation || 'Selon profil et expérience';
                let questions = Array.isArray(data.interview_questions) ? data.interview_questions : [
                    'Décrivez votre expérience la plus pertinente.',
                    'Comment gérez-vous les deadlines serrées ?',
                    'Où vous voyez-vous dans 3 ans ?'
                ];

                box.innerHTML = `
                    <div style="margin-bottom:14px">
                        <div style="font-size:0.7rem;text-transform:uppercase;color:var(--fo-text-secondary);font-weight:600;letter-spacing:0.5px">💰 Estimation Salaire</div>
                        <div style="font-weight:700;color:#10b981;font-size:0.95rem;margin-top:3px"><i class="bi bi-cash-stack me-1"></i>${salary}</div>
                    </div>
                    <div style="border-top:1px solid var(--fo-border);padding-top:10px">
                        <div style="font-size:0.7rem;text-transform:uppercase;color:var(--fo-text-secondary);font-weight:600;letter-spacing:0.5px;margin-bottom:6px">🎯 Questions probables</div>
                        <ol class="mb-0 ps-3" style="font-size:0.78rem;color:#374151">
                            ${questions.map(q => '<li style="margin-bottom:4px">' + q + '</li>').join('')}
                        </ol>
                    </div>
                `;
            })
            .catch(() => {
                document.getElementById('aiInsightsContent').innerHTML = '<div class="text-muted" style="font-size:0.8rem"><i class="bi bi-wifi-off me-1"></i>Insights indisponibles.</div>';
            });
    }
</script>
{% endblock %}
