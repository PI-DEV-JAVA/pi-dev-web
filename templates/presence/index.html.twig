{% extends 'base.html.twig' %}

{% block title %}Liste des Présences | PIWEB{% endblock %}

{% block body %}
<div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
        <h1 class="text-2xl font-semibold text-gray-900">Présences</h1>
        <p class="mt-2 text-sm text-gray-700">Gestion des présences avec codes QR.</p>
    </div>
    <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
        <!-- Pas de bouton ajouter manuellement ici car généralement lié à la participation, on peut laisser si besoin -->
    </div>
</div>

<div class="mt-8 flex flex-col">
    <div class="-my-2 -mx-4 overflow-x-auto sm:-mx-6 lg:-mx-8">
        <div class="inline-block min-w-full py-2 align-middle md:px-6 lg:px-8">
            <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 md:rounded-lg">
                <table class="min-w-full divide-y divide-gray-300">
                    <thead class="bg-gray-50">
                        <tr>
                            <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Événement</th>
                            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Participant</th>
                            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Présent</th>
                            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Date Scan</th>
                            <th scope="col" class="px-3 py-3.5 text-center text-sm font-semibold text-gray-900">Code QR</th>
                            <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                                <span class="sr-only">Actions</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 bg-white">
                    {% for presence in presences %}
                        <tr>
                            <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">{{ presence.participation.evenement.titre ?? '' }}</td>
                            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{ presence.participation.user.prenom ?? '' }} {{ presence.participation.user.nom ?? '' }}</td>
                            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                                {% if presence.estPresent %}
                                    <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Oui</span>
                                {% else %}
                                    <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">Non</span>
                                {% endif %}
                            </td>
                            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{ presence.dateScan ? presence.dateScan|date('d/m/Y H:i') : '' }}</td>
                            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500 text-center">
                                {% if presence.codeQr %}
                                    <img src="{{ path('app_presence_qr', {'code': presence.codeQr}) }}" alt="QR Code" class="h-12 w-12 mx-auto block mb-1">
                                    <span class="text-xs text-gray-400 select-all">{{ presence.codeQr }}</span>
                                {% endif %}
                            </td>
                            <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6 flex justify-end gap-3 items-center">
                                <a href="{{ path('app_presence_edit', {'idPresence': presence.idPresence}) }}" class="text-indigo-600 hover:text-indigo-900">Modifier</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-center text-gray-500 sm:pl-6">
                                Aucune présence trouvée.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
