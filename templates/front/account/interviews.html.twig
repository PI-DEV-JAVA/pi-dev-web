{% extends 'front/_base.html.twig' %}
{% block title %}Entretiens — Talentos{% endblock %}
{% block content %}
<div class="fo-page-header">
    <div class="container">
        <h1>Mes entretiens 🎥</h1>
        <p>Vos entretiens planifiés</p>
    </div>
</div>
<section class="fo-section" style="padding-top:40px">
    <div class="container">
        
        <div class="fo-card mb-4" style="padding:20px">
            <form method="get" action="{{ path('app_interviews') }}" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label style="font-size:0.85rem;color:var(--fo-text-secondary);margin-bottom:6px">Rechercher</label>
                    <input type="text" name="q" class="fo-input form-control" value="{{ search ?? '' }}" placeholder="Offre ou statut...">
                </div>
                <div class="col-md-4">
                    <label style="font-size:0.85rem;color:var(--fo-text-secondary);margin-bottom:6px">Trier par date</label>
                    <select name="sort" class="fo-input form-select">
                        <option value="date_desc" {% if (sort ?? '') == 'date_desc' %}selected{% endif %}>Récent en premier</option>
                        <option value="date_asc" {% if (sort ?? '') == 'date_asc' %}selected{% endif %}>Ancien en premier</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="fo-btn fo-btn-primary w-100">Filtrer</button>
                </div>
            </form>
        </div>

        {% if interviews is empty %}
            <div class="fo-card text-center" style="padding:60px">
                <i class="bi bi-camera-video" style="font-size:3rem;color:var(--fo-text-secondary)"></i>
                <p class="mt-3" style="color:var(--fo-text-secondary)">Aucun entretien trouvé.</p>
            </div>
        {% else %}
            <div class="row g-4">
                {% for interview in interviews %}
                    <div class="col-12">
                        <div class="fo-card">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 style="font-weight:700;margin:0">{{ interview.application.offer.title }}</h5>
                                <span class="fo-badge fo-badge-{{ interview.status == 'COMPLETED' ? 'success' : (interview.status == 'CANCELLED' ? 'warning' : 'primary') }}">{{ interview.status }}</span>
                            </div>
                            <div style="color:var(--fo-text-secondary);font-size:0.9rem;margin-bottom:15px">
                                <div><i class="bi bi-calendar3 me-1"></i> Entretien initialement prévu le {{ interview.interviewDate ? interview.interviewDate|date('d/m/Y à H:i') : '—' }}</div>
                            </div>
                            
                            {% if interview.meets is empty %}
                                <div class="alert alert-info py-2" style="font-size:0.85rem;margin:0">Aucun meet planifié pour le moment. L'équipe HR vous contactera sous peu.</div>
                            {% else %}
                                <div class="table-responsive">
                                    <table class="table align-middle" style="color:var(--fo-text);margin:0;font-size:0.9rem">
                                        <thead>
                                            <tr>
                                                <th style="color:var(--fo-text-secondary);border-bottom-color:var(--fo-border);font-weight:600">Session</th>
                                                <th style="color:var(--fo-text-secondary);border-bottom-color:var(--fo-border);font-weight:600">Date et Heure</th>
                                                <th style="color:var(--fo-text-secondary);border-bottom-color:var(--fo-border);font-weight:600" class="text-end">Lien</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for meet in interview.meets %}
                                                <tr>
                                                    <td style="border-bottom-color:var(--fo-border)">{{ meet.title }}</td>
                                                    <td style="border-bottom-color:var(--fo-border)">{{ meet.meetDate|date('d/m/Y H:i') }}</td>
                                                    <td style="border-bottom-color:var(--fo-border)" class="text-end">
                                                        <a href="{{ path('app_meet_room', {'roomId': meet.roomId}) }}" class="fo-btn fo-btn-primary" style="padding:6px 12px;font-size:0.8rem" target="_blank">
                                                            <i class="bi bi-camera-video me-1"></i>Rejoindre
                                                        </a>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
