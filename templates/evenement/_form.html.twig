                </div>

                <div>
                    {{ form_label(form.dateEvent, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.dateEvent) }}
                    <div class="text-red-500 text-xs mt-1">{{ form_errors(form.dateEvent) }}</div>
                </div>

                <div>
                    {{ form_label(form.lieu, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
