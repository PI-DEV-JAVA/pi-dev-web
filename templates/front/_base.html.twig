                <div class="d-flex gap-2">
                    <input type="email" placeholder="Votre email" style="flex:1;background:rgba(255,255,255,0.06);border:1px solid rgba(71,85,105,0.3);border-radius:10px;padding:10px 16px;color:white;font-size:0.9rem">
