                </p>
            </div>
            <div class="mt-5 md:col-span-2 md:mt-0 space-y-6">
                <div>
                    {{ form_label(form.titre, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(form.titre) }}
                    <div class="text-red-500 text-xs mt-1">{{ form_errors(form.titre) }}</div>
                </div>

                <div>
                    {{ form_label(form.typeEvent, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
