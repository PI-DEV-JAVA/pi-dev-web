{% extends 'back/_base.html.twig' %}
{% block page_title %}Ticket #{{ ticket.id }}{% endblock %}
{% block content %}
<div class="mb-3"><a href="{{ path('admin_support') }}" style="color:var(--primary-light);text-decoration:none;font-size:0.9rem"><i class="bi bi-arrow-left me-1"></i> Retour aux tickets</a></div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="bo-card">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5 style="font-weight:700;margin-bottom:4px">{{ ticket.subject }}</h5>
                    <div style="font-size:0.85rem;color:var(--bo-text-secondary)">
                        <i class="bi bi-person me-1"></i>{{ ticket.user ? ticket.user.email : '—' }}
                        · {{ ticket.createdAt ? ticket.createdAt|date('d/m/Y H:i') : '' }}
                    </div>
                </div>
                <span class="bo-badge bo-badge-{{ ticket.status == 'OPEN' ? 'warning' : (ticket.status == 'CLOSED' ? 'success' : 'primary') }}">{{ ticket.status }}</span>
            </div>
            <div style="background:rgba(255,255,255,0.03);border:1px solid var(--bo-border);border-radius:12px;padding:16px;margin-bottom:20px">
                <p style="margin:0;line-height:1.6">{{ ticket.description }}</p>
            </div>

            {# Replies #}
            {% for reply in replies %}
                <div class="d-flex gap-3 mb-3">
                    <div style="width:32px;height:32px;border-radius:8px;background:{{ reply.user and reply.user.role == 'ADMIN' ? 'linear-gradient(135deg,var(--primary),var(--accent))' : 'rgba(148,163,184,0.15)' }};display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.75rem;color:{{ reply.user and reply.user.role == 'ADMIN' ? 'white' : 'var(--bo-text-secondary)' }};flex-shrink:0">
                        {{ reply.user ? reply.user.email|first|upper : '?' }}
                    </div>
                    <div style="flex:1;background:rgba(255,255,255,0.03);border:1px solid var(--bo-border);border-radius:12px;padding:12px 16px">
                        <div style="font-weight:600;font-size:0.8rem;margin-bottom:4px">
                            {{ reply.user ? reply.user.email : '—' }}
                            {% if reply.user and reply.user.role == 'ADMIN' %}<span class="bo-badge bo-badge-primary" style="margin-left:6px;font-size:0.6rem">Admin</span>{% endif %}
                            <span style="color:var(--bo-text-secondary);font-weight:400;margin-left:8px">{{ reply.createdAt ? reply.createdAt|date('d/m H:i') : '' }}</span>
                        </div>
                        <p style="margin:0;font-size:0.9rem;line-height:1.5">{{ reply.message }}</p>
                    </div>
                </div>
            {% endfor %}

            {# Reply form #}
            {% if ticket.status != 'CLOSED' %}
            <form method="post" action="{{ path('admin_support_reply', {id: ticket.id}) }}" class="bo-form mt-3">
                <textarea name="content" class="form-control" rows="3" placeholder="Répondre au ticket..." required></textarea>
                <div class="d-flex gap-2 mt-2">
                    <button type="submit" class="bo-btn bo-btn-primary"><i class="bi bi-send me-1"></i>Répondre</button>
                    <a href="{{ path('admin_support_close', {id: ticket.id}) }}" class="bo-btn bo-btn-outline" onclick="return confirm('Fermer ce ticket ?')"><i class="bi bi-check2-circle me-1"></i>Fermer le ticket</a>
                </div>
            </form>
            {% else %}
                <div class="text-center mt-3" style="padding:16px;background:rgba(16,185,129,0.08);border-radius:12px">
                    <i class="bi bi-check-circle-fill me-2" style="color:var(--success)"></i>
                    <span style="color:var(--success);font-weight:600">Ticket fermé</span>
                </div>
            {% endif %}
        </div>
    </div>
    <div class="col-lg-4">
        <div class="bo-card">
            <h6 style="font-weight:700;margin-bottom:12px">Informations</h6>
            <div style="font-size:0.85rem;color:var(--bo-text-secondary)">
                <div class="mb-2"><strong>ID :</strong> #{{ ticket.id }}</div>
                <div class="mb-2"><strong>Utilisateur :</strong> {{ ticket.user ? ticket.user.email : '—' }}</div>
                <div class="mb-2"><strong>Créé le :</strong> {{ ticket.createdAt ? ticket.createdAt|date('d/m/Y H:i') : '—' }}</div>
                <div class="mb-2"><strong>Statut :</strong> {{ ticket.status }}</div>
                <div><strong>Réponses :</strong> {{ replies|length }}</div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
