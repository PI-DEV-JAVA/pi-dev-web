{% extends 'back/_base.html.twig' %}
{% block page_title %}Leaderboard{% endblock %}
{% block content %}
<style>
    .podium{display:flex;justify-content:center;gap:16px;margin-bottom:32px;align-items:flex-end}
    .podium-item{text-align:center;border-radius:16px;padding:24px 20px;position:relative;transition:all .3s}
    .podium-item:hover{transform:translateY(-4px)}
    .podium-1{background:linear-gradient(135deg,rgba(255,215,0,.15),rgba(255,215,0,.05));border:1px solid rgba(255,215,0,.25);order:2;min-width:180px}
    .podium-2{background:linear-gradient(135deg,rgba(192,192,192,.15),rgba(192,192,192,.05));border:1px solid rgba(192,192,192,.25);order:1;min-width:160px}
    .podium-3{background:linear-gradient(135deg,rgba(205,127,50,.15),rgba(205,127,50,.05));border:1px solid rgba(205,127,50,.25);order:3;min-width:160px}
    .podium-rank{font-size:2rem;font-weight:800;margin-bottom:8px}
    .podium-avatar{width:56px;height:56px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-weight:800;font-size:1.2rem;color:#fff;margin-bottom:8px}
    .podium-name{font-weight:700;font-size:.9rem;margin-bottom:4px}
    .podium-hours{font-size:1.4rem;font-weight:800}
    .podium-label{font-size:.75rem;color:var(--bo-text-secondary)}
    .progress-bar-custom{height:8px;border-radius:4px;background:rgba(255,255,255,.05);overflow:hidden}
    .progress-bar-fill{height:100%;border-radius:4px;transition:width 1s ease;background:linear-gradient(90deg,var(--primary),var(--accent))}
    .period-toggle{display:inline-flex;background:rgba(255,255,255,.04);border-radius:10px;border:1px solid var(--bo-border);overflow:hidden}
    .period-btn{padding:8px 16px;border:none;background:transparent;color:var(--bo-text-secondary);font-size:.82rem;font-weight:600;cursor:pointer;transition:all .2s;text-decoration:none}
    .period-btn.active{background:rgba(79,70,229,.15);color:var(--primary-light)}
    .period-btn:hover:not(.active){background:rgba(255,255,255,.06);color:var(--bo-text)}
</style>
<div class="d-flex align-items-center justify-content-between" style="margin-bottom:24px;flex-wrap:wrap;gap:12px">
    <h5 style="font-weight:700;margin:0"><i class="bi bi-trophy-fill me-2" style="color:#fbbf24"></i>Leaderboard</h5>
    <div class="period-toggle">
        <a href="{{ path('admin_leaderboard',{period:'week'}) }}" class="period-btn {{ period=='week'?'active':'' }}">Semaine</a>
        <a href="{{ path('admin_leaderboard',{period:'month'}) }}" class="period-btn {{ period=='month'?'active':'' }}">Mois</a>
        <a href="{{ path('admin_leaderboard') }}" class="period-btn {{ period=='all'?'active':'' }}">Tout</a>
    </div>
</div>
{% if rankings|length > 0 %}
<div class="podium">
    {% for i in [1,0,2] %}{% if rankings[i] is defined %}{% set r=rankings[i] %}{% set p=profiles[r.id] %}{% set medals=['🥇','🥈','🥉'] %}
    <div class="podium-item podium-{{ i+1 }}">
        <div class="podium-rank">{{ medals[i] }}</div>
        {% if p.avatar %}<img src="{{ p.avatar }}" class="podium-avatar" style="object-fit:cover;border:3px solid {{ i==0?'#ffd700':(i==1?'#c0c0c0':'#cd7f32') }}" alt="">
        {% else %}<div class="podium-avatar" style="background:linear-gradient(135deg,var(--primary),var(--accent))">{{ r.email|first|upper }}</div>{% endif %}
        <div class="podium-name">{% if p.firstName %}{{ p.firstName }} {{ p.lastName|first }}.{% else %}{{ r.email|split('@')[0] }}{% endif %}</div>
        <div class="podium-hours" style="color:{{ i==0?'#ffd700':(i==1?'#c0c0c0':'#cd7f32') }}">{{ r.efficiencyScore ?? 0 }} pts</div>
        <div class="podium-label">FTAR: {{ r.ftar ?? 0 }}% | {{ r.activityCount }} act.</div>
    </div>
    {% endif %}{% endfor %}
</div>
<div class="bo-card">
    <table class="bo-table"><thead><tr><th>#</th><th>Employé</th><th>Activités</th><th>Score</th><th>Qualité (FTAR)</th><th style="width:200px">Progression</th><th>Actions</th></tr></thead>
    <tbody>
    {% set maxScore=rankings[0].efficiencyScore ?? 1 %}
    {% for r in rankings %}{% set p=profiles[r.id] %}
    <tr>
        <td><span style="font-weight:700;{% if loop.index<=3 %}color:{{ loop.index==1?'#ffd700':(loop.index==2?'#c0c0c0':'#cd7f32') }}{% endif %}">{{ loop.index }}</span></td>
        <td><div class="d-flex align-items-center gap-2">
            {% if p.avatar %}<img src="{{ p.avatar }}" style="width:32px;height:32px;border-radius:50%;object-fit:cover" alt="">
            {% else %}<div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--accent));display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.75rem;color:#fff;flex-shrink:0">{{ r.email|first|upper }}</div>{% endif %}
            <div><div style="font-weight:600;font-size:.85rem">{% if p.firstName %}{{ p.firstName }} {{ p.lastName }}{% else %}{{ r.email|split('@')[0] }}{% endif %}</div><div style="font-size:.72rem;color:var(--bo-text-secondary)">{{ r.email }}</div></div>
        </div></td>
        <td><span class="bo-badge bo-badge-primary">{{ r.activityCount }}</span></td>
        <td style="font-weight:700;color:var(--accent)">{{ r.efficiencyScore ?? 0 }} pts</td>
        <td style="color:var(--bo-text-secondary)">{{ r.ftar ?? 0 }}%</td>
        <td><div class="progress-bar-custom"><div class="progress-bar-fill" style="width:{{ maxScore>0?(((r.efficiencyScore ?? 0)/maxScore)*100)|round:0 }}%"></div></div></td>
        <td><a href="{{ path('admin_report_employee',{id:r.id}) }}" class="bo-action-btn" title="Rapport" style="width:32px;height:32px;border-radius:8px;border:1px solid var(--bo-border);display:inline-flex;align-items:center;justify-content:center;color:var(--bo-text-secondary);text-decoration:none"><i class="bi bi-file-earmark-pdf"></i></a></td>
    </tr>
    {% endfor %}
    </tbody></table>
</div>
{% else %}
<div class="bo-card text-center" style="padding:60px"><i class="bi bi-trophy" style="font-size:3rem;color:var(--bo-text-secondary);opacity:.4"></i><p class="mt-3" style="color:var(--bo-text-secondary)">Aucune donnée disponible.</p></div>
{% endif %}
{% endblock %}
