        <div class="chat-widget-header">
            <h6><i class="bi bi-chat-dots me-2"></i>Messages</h6>
            <div style="display:flex;gap:8px;align-items:center">
                <a href="{{ path('app_messages') }}" style="color:rgba(255,255,255,0.8);font-size:0.85rem" title="Ouvrir en plein écran"><i class="bi bi-arrows-fullscreen"></i></a>
                <button onclick="chatWidget.classList.remove('open')"><i class="bi bi-x-lg"></i></button>
            </div>
        </div>
        <div class="chat-contact-list" id="chatContactList">
            <div class="cw-empty">
                <i class="bi bi-chat-square-text"></i>
                <p style="font-size:0.85rem;margin:0">Loading...</p>
            </div>
        </div>
    </div>
    {# — Active Chat View — #}
    <div class="cw-chat-view" id="cwChatView">
