{% extends 'base.html.twig' %}
{% from 'components/_sidebar.html.twig' import sidebar %}

{% block title %}{{ formation.titre }} — Talentos{% endblock %}

{% block body %}
{{ sidebar(app.user) }}

<main class="app-main">
    <div class="mb-3">
        <a href="{{ path('app_courses') }}" style="color:var(--primary-light);text-decoration:none;font-size:0.9rem">
            <i class="bi bi-arrow-left me-1"></i> Retour aux formations
        </a>
    </div>

    <div class="row g-4">
        <div class="col-md-8">
            <div class="stat-card" style="margin-bottom:16px">
                {# Cover image #}
                {% if formation.image %}
                    <img src="{{ asset('uploads/formations/' ~ formation.image) }}"
                         alt="{{ formation.titre }}"
                         style="width:100%;height:220px;object-fit:cover;border-radius:12px;margin-bottom:16px">
                {% else %}
                    <div style="width:100%;height:160px;border-radius:12px;margin-bottom:16px;
                                background:linear-gradient(135deg,rgba(79,70,229,0.3),rgba(6,182,212,0.2));
                                display:flex;align-items:center;justify-content:center">
                        <i class="bi bi-book" style="font-size:3.5rem;color:var(--primary-light)"></i>
                    </div>
                {% endif %}

                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                    <h3 style="font-weight:700;margin-bottom:0">{{ formation.titre }}</h3>
                    {# Price badge #}
                    {% if formation.isPaid %}
                        <span style="background:rgba(245,158,11,0.15);color:#d97706;border:1px solid rgba(245,158,11,0.4);
                                     padding:6px 14px;border-radius:20px;font-size:0.85rem;font-weight:700;white-space:nowrap">
                            <i class="bi bi-coin me-1"></i>{{ formation.pricePoints }} pts
                        </span>
                    {% else %}
                        <span style="background:rgba(16,185,129,0.15);color:#059669;border:1px solid rgba(16,185,129,0.4);
                                     padding:6px 14px;border-radius:20px;font-size:0.85rem;font-weight:700">
                            <i class="bi bi-gift me-1"></i>Gratuit
                        </span>
                    {% endif %}
                </div>

                <div class="d-flex gap-3 mb-3" style="font-size:0.85rem">
                    {% if formation.niveau %}
                        <span class="badge" style="background:rgba(79,70,229,0.15);color:var(--primary-light);padding:5px 12px;border-radius:8px">
                            {{ formation.niveau }}
                        </span>
                    {% endif %}
                    {% if formation.duree %}
                        <span class="badge" style="background:rgba(6,182,212,0.15);color:var(--accent);padding:5px 12px;border-radius:8px">
                            <i class="bi bi-clock me-1"></i>{{ formation.duree }}h
                        </span>
                    {% endif %}
                </div>

                <div style="color:var(--text-secondary);line-height:1.8;white-space:pre-line">
                    {{ formation.description|default('Aucune description.') }}
                </div>
            </div>

            {# Sessions #}
            <div class="stat-card">
                <h5 style="font-weight:600;margin-bottom:16px"><i class="bi bi-calendar3 me-2" style="color:var(--accent)"></i>Séances ({{ seances|length }})</h5>
                {% if seances is empty %}
                    <p style="color:var(--text-secondary)">Aucune séance planifiée.</p>
                {% else %}
                    {% for s in seances %}
                        <div class="d-flex align-items-center gap-3 p-3 mb-2" style="background:var(--bg-input);border-radius:12px">
                            <div style="width:48px;height:48px;border-radius:10px;
                                        background:{{ s.type == 'EN_LIGNE' ? 'rgba(6,182,212,0.15)' : 'rgba(79,70,229,0.15)' }};
                                        display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                <i class="bi bi-{{ s.type == 'EN_LIGNE' ? 'camera-video' : 'geo-alt' }}"
                                   style="color:{{ s.type == 'EN_LIGNE' ? 'var(--accent)' : 'var(--primary-light)' }};font-size:1.2rem"></i>
                            </div>
                            <div style="flex:1;min-width:0">
                                <div style="font-weight:600;font-size:0.9rem">{{ s.titre }}</div>
                                <div style="color:var(--text-secondary);font-size:0.8rem">
                                    {{ s.dateDebut|date('d/m/Y H:i') }} — {{ s.dateFin|date('H:i') }}
                                    {% if s.adresse %} · {{ s.adresse }}{% endif %}
                                </div>
                            </div>
                            <span class="badge" style="font-size:0.7rem;padding:3px 8px;border-radius:5px;
                                                        background:{{ s.statut == 'TERMINEE' ? 'rgba(16,185,129,0.15)' : (s.statut == 'EN_COURS' ? 'rgba(245,158,11,0.15)' : 'rgba(148,163,184,0.15)') }};
                                                        color:{{ s.statut == 'TERMINEE' ? 'var(--success)' : (s.statut == 'EN_COURS' ? 'var(--warning)' : 'var(--text-secondary)') }}">
                                {{ s.statut }}
                            </span>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>

        {# Right Sidebar #}
        <div class="col-md-4">
            {# Enrollment / Score card #}
            <div class="stat-card mb-3">
                {% if app.user and app.user.role == 'CANDIDATE' %}
                    {% if enrollment and enrollment.isApproved %}
                        {# Score progress #}
                        {% if avgScore is not null %}
                            <div class="text-center mb-3">
                                <div style="font-size:0.8rem;color:var(--text-secondary);margin-bottom:6px;text-transform:uppercase;letter-spacing:1px">Votre progression</div>
                                {% set pct = (avgScore / 20 * 100)|round %}
                                <div style="position:relative;width:90px;height:90px;margin:0 auto 10px">
                                    <svg viewBox="0 0 36 36" style="width:90px;height:90px;transform:rotate(-90deg)">
                                        <circle cx="18" cy="18" r="15.9" fill="none" stroke="rgba(79,70,229,0.1)" stroke-width="3"/>
                                        <circle cx="18" cy="18" r="15.9" fill="none"
                                                stroke="{{ pct >= 70 ? '#10b981' : (pct >= 50 ? '#f59e0b' : '#ef4444') }}"
                                                stroke-width="3" stroke-dasharray="{{ pct }},100"
                                                stroke-linecap="round"/>
                                    </svg>
                                    <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
                                                font-weight:800;font-size:1.1rem;color:{{ pct >= 70 ? 'var(--success)' : (pct >= 50 ? 'var(--warning)' : '#ef4444') }}">
                                        {{ pct }}%
                                    </div>
                                </div>
                                <div style="font-size:0.85rem;color:var(--text-secondary)">Moyenne : {{ avgScore }}/20</div>
                                {% if canGetCertificate %}
                                    <div style="margin-top:6px;font-size:0.8rem;color:var(--success);font-weight:600">
                                        <i class="bi bi-check-circle-fill me-1"></i>Éligible au certificat !
                                    </div>
                                {% else %}
                                    <div style="margin-top:6px;font-size:0.78rem;color:var(--text-secondary)">
                                        Besoin de 70% pour le certificat
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}

                        <div class="text-center mb-3">
                            <span style="background:rgba(16,185,129,0.15);color:var(--success);padding:8px 16px;border-radius:10px;font-size:0.85rem;font-weight:600">
                                <i class="bi bi-check-circle me-1"></i>Inscrit(e) & Approuvé(e)
                            </span>
                        </div>

                        {% if canGetCertificate %}
                            <a href="{{ path('app_certificate', {id: formation.id}) }}"
                               style="display:block;text-align:center;background:linear-gradient(135deg,#10b981,#059669);
                                      color:#fff;border-radius:12px;padding:12px;font-weight:700;
                                      text-decoration:none;transition:opacity 0.2s"
                               onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">
                                <i class="bi bi-award me-2"></i>Télécharger mon certificat
                            </a>
                        {% else %}
                            <div style="background:rgba(148,163,184,0.1);border:1px dashed rgba(148,163,184,0.3);
                                        border-radius:12px;padding:12px;text-align:center;
                                        color:var(--text-secondary);font-size:0.85rem">
                                <i class="bi bi-lock me-1"></i>Certificat disponible après 70%
                            </div>
                        {% endif %}

                    {% elseif enrollment and enrollment.isPending %}
                        <div class="text-center">
                            <i class="bi bi-hourglass-split" style="font-size:2rem;color:var(--warning)"></i>
                            <p class="mt-2" style="color:var(--text-secondary);font-size:0.9rem">Votre demande est en attente de validation.</p>
                        </div>
                    {% elseif enrollment and enrollment.isRejected %}
                        <div class="text-center">
                            <i class="bi bi-x-circle" style="font-size:2rem;color:#ef4444"></i>
                            <p class="mt-2" style="color:var(--text-secondary);font-size:0.9rem">Votre inscription a été refusée.</p>
                        </div>
                    {% else %}
                        {# Apply button #}
                        {% if formation.isPaid %}
                            <div class="mb-3 text-center" style="background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.3);border-radius:10px;padding:12px">
                                <div style="font-size:0.8rem;color:var(--text-secondary)">Coût d'inscription</div>
                                <div style="font-size:1.4rem;font-weight:800;color:#d97706">
                                    <i class="bi bi-coin me-1"></i>{{ formation.pricePoints }} pts
                                </div>
                                {% if app.user %}
                                    <div style="font-size:0.8rem;color:var(--text-secondary)">
                                        Votre solde : <strong>{{ app.user.pointsBalance }} pts</strong>
                                    </div>
                                    {% if app.user.pointsBalance < formation.pricePoints %}
                                        <a href="{{ path('app_points_buy') }}" style="display:inline-block;margin-top:8px;font-size:0.8rem;color:#f59e0b;text-decoration:underline">
                                            <i class="bi bi-plus-circle me-1"></i>Acheter des points
                                        </a>
                                    {% endif %}
                                {% endif %}
                            </div>
                        {% endif %}

                        {% if app.user %}
                            <form method="POST" action="{{ path('app_course_apply', {id: formation.id}) }}">
                                <button type="submit"
                                        {% if formation.isPaid and app.user.pointsBalance < (formation.pricePoints ?? 0) %}disabled{% endif %}
                                        style="width:100%;background:{% if formation.isPaid and app.user.pointsBalance < (formation.pricePoints ?? 0) %}rgba(148,163,184,0.2){% else %}linear-gradient(135deg,var(--primary),#6366f1){% endif %};
                                               color:{% if formation.isPaid and app.user.pointsBalance < (formation.pricePoints ?? 0) %}var(--text-secondary){% else %}#fff{% endif %};
                                               border:none;border-radius:12px;padding:12px;font-size:0.95rem;font-weight:700;
                                               cursor:{% if formation.isPaid and app.user.pointsBalance < (formation.pricePoints ?? 0) %}not-allowed{% else %}pointer{% endif %}">
                                    {% if formation.isPaid %}
                                        <i class="bi bi-coin me-2"></i>S'inscrire ({{ formation.pricePoints }} pts)
                                    {% else %}
                                        <i class="bi bi-send me-2"></i>Demander une inscription
                                    {% endif %}
                                </button>
                            </form>
                        {% else %}
                            <a href="{{ path('app_login') }}"
                               style="display:block;text-align:center;background:linear-gradient(135deg,var(--primary),#6366f1);
                                      color:#fff;border-radius:12px;padding:12px;font-weight:700;text-decoration:none">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Se connecter pour s'inscrire
                            </a>
                        {% endif %}
                    {% endif %}
                {% endif %}
            </div>

            {# Quizzes #}
            <div class="stat-card">
                <h5 style="font-weight:600;margin-bottom:16px"><i class="bi bi-patch-question me-2" style="color:var(--warning)"></i>Quiz</h5>
                {% set allQuizzes = [] %}
                {% for s in seances %}
                    {% if s.quiz %}
                        {% set allQuizzes = allQuizzes|merge([s.quiz]) %}
                    {% endif %}
                {% endfor %}
                {% if allQuizzes is empty %}
                    <p style="color:var(--text-secondary);font-size:0.9rem">Aucun quiz disponible.</p>
                {% else %}
                    {% for q in allQuizzes %}
                        {% set attempted = attemptedQuizIds[q.id] is defined ? attemptedQuizIds[q.id] : null %}
                        <a href="{{ path(attempted ? 'app_quiz_result' : 'app_quiz', {id: q.id}) }}" class="text-decoration-none d-block mb-2">
                            <div class="p-3" style="background:var(--bg-input);border-radius:10px;transition:all 0.2s;border:1px solid transparent"
                                 onmouseover="this.style.borderColor='rgba(79,70,229,0.3)'"
                                 onmouseout="this.style.borderColor='transparent'">
                                <div style="font-weight:600;color:var(--text-primary);font-size:0.9rem">{{ q.titre }}</div>
                                <div style="color:var(--text-secondary);font-size:0.8rem;margin-top:4px">
                                    {% if attempted %}
                                        <i class="bi bi-check2-circle me-1" style="color:var(--success)"></i>
                                        Score : <strong style="color:{{ attempted.score >= 15 ? 'var(--success)' : (attempted.score >= 10 ? 'var(--warning)' : '#ef4444') }}">
                                            {{ attempted.score }}/20
                                        </strong>
                                    {% else %}
                                        <i class="bi bi-arrow-right-circle me-1"></i>Commencer le quiz
                                    {% endif %}
                                </div>
                            </div>
                        </a>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>
</main>
{% endblock %}
