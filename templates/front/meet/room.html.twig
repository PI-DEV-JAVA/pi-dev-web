<!-- RequireJS for Monaco Editor -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/require.js/2.3.6/require.min.js"></script>
<script>
    require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.43.0/min/vs' }});
    require(['vs/editor/editor.main'], function() {
        window.editor = monaco.editor.create(document.getElementById('editor'), {
            value: "// L'éditeur collaboratif est prêt\n// Tapez votre code ici...\n",
            language: 'javascript',
            theme: 'vs-dark',
            automaticLayout: true,
            minimap: { enabled: false },
            fontSize: 14
        });

        // Language toggle sync
        const langSelect = document.getElementById('languageSelect');
        langSelect.addEventListener('change', function(e) {
            monaco.editor.setModelLanguage(window.editor.getModel(), e.target.value);
            if (ws && ws.readyState === WebSocket.OPEN) {
                ws.send(JSON.stringify({ type: "code_lang", room: ROOM_ID, language: e.target.value }));
            }
        });

        let isApplyingRemoteChange = false;

        // Capture local changes
        window.editor.onDidChangeModelContent(function(e) {
            if (isApplyingRemoteChange) return;

            const content = window.editor.getValue();
            if (ws && ws.readyState === WebSocket.OPEN) {
                ws.send(JSON.stringify({ 
                    type: "code", 
                    room: ROOM_ID, 
                    user: DISPLAY_NAME, 
                    content: content 
                }));
            }
        });

        // Process remote change
        window.applyRemoteCodeChange = function(data) {
            if (data.user !== DISPLAY_NAME) {
                isApplyingRemoteChange = true;
                const position = window.editor.getPosition();
                window.editor.setValue(data.content);
                window.editor.setPosition(position);
                isApplyingRemoteChange = false;
            }
        };

        // Process remote language change
        window.applyRemoteLangChange = function(language) {
            if (langSelect.value !== language) {
                langSelect.value = language;
                monaco.editor.setModelLanguage(window.editor.getModel(), language);
            }
        };

        // Console Logic
        const consoleOutput = document.getElementById('consoleOutput');
        const btnRunCode = document.getElementById('btnRunCode');
        const btnClearConsole = document.getElementById('btnClearConsole');

        function setConsoleMessage(msg, isError = false) {
            consoleOutput.className = isError ? 'code-console-output error' : 'code-console-output';
            consoleOutput.innerText = msg || '';
        }

        btnClearConsole.addEventListener('click', () => {
            setConsoleMessage("En attente d'exécution...");
        });

        window.applyRemoteOutput = function(data) {
            if (data.user !== DISPLAY_NAME) {
                setConsoleMessage("Résultat de " + data.user + " :\n\n" + data.text, data.isError);
            }
        };

        btnRunCode.addEventListener('click', async () => {
            btnRunCode.innerHTML = '<i class="spinner-border spinner-border-sm"></i> Exécution...';
            btnRunCode.disabled = true;
            setConsoleMessage("Compilation & Exécution en cours...");

            try {
                const response = await fetch("{{ path('api_meet_run_code', {id: meet.id}) }}", {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        language: langSelect.value,
                        code: window.editor.getValue()
                    })
                });
                const result = await response.json();
                
                let finalText = "";
                let isError = false;
                
                if (result.error && result.error.trim() !== '') {
                    finalText = result.error;
                    isError = true;
                } else {
                    finalText = result.output;
                    if (!finalText || finalText.trim() === '') finalText = "Le programme a été exécuté avec succès mais n'a retourné aucune sortie.";
                }
                
                setConsoleMessage(finalText, isError);

                // Broadcast output to room
                if (ws && ws.readyState === WebSocket.OPEN) {
                    ws.send(JSON.stringify({
                        type: "code_output",
                        room: ROOM_ID,
                        user: DISPLAY_NAME,
                        text: finalText,
                        isError: isError
                    }));
                }
                
            } catch (err) {
                setConsoleMessage("Une erreur interne est survenue lors de l'exécution.", true);
            } finally {
                btnRunCode.innerHTML = '<i class="bi bi-play-fill"></i> Exécuter';
                btnRunCode.disabled = false;
            }
        });
    });
</script>
{% endif %}

