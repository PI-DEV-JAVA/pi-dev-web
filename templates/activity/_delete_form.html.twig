{# templates/activity/_delete_form.html.twig #}
<form method="post" action="{{ path('app_activity_delete', {'id': activity.id}) }}" onsubmit="return confirm('Delete this activity? All time tracking data will be lost.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ activity.id) }}">
    <button class="btn btn-link text-danger p-0"><i class="bi bi-trash3"></i></button>
</form>