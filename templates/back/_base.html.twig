{% extends 'base.html.twig' %}

{% block base_stylesheets %}
<style>
    /* ═══════════════════════════════════════════
       BACK OFFICE — Dark Admin Panel
       ═══════════════════════════════════════════ */

    :root {
        --bo-bg: #0f172a;
        --bo-bg-card: #1e293b;
        --bo-bg-input: #334155;
        --bo-text: #f8fafc;
        --bo-text-secondary: #94a3b8;
        --bo-border: rgba(71,85,105,0.3);
        --bo-sidebar-w: 260px;
    }

    body {
        background: var(--bo-bg);
        color: var(--bo-text);
        min-height: 100vh;
    }

    /* ── Sidebar ── */
    .bo-sidebar {
        position: fixed; top: 0; left: 0;
        width: var(--bo-sidebar-w); height: 100vh;
        background: var(--bo-bg-card);
        border-right: 1px solid var(--bo-border);
        display: flex; flex-direction: column;
        z-index: 100;
    }
    .bo-sidebar-header {
        padding: 24px 20px;
        border-bottom: 1px solid var(--bo-border);
    }
    .bo-sidebar-logo {
        font-size: 1.4rem; font-weight: 800;
        background: linear-gradient(135deg, var(--primary-light), var(--accent));
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    .bo-sidebar-label {
        font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1.5px;
        color: var(--bo-text-secondary); margin-top: 4px;
    }
    .bo-sidebar-nav {
        flex: 1; padding: 12px; overflow-y: auto;
    }
    .bo-nav-section {
        font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1.5px;
        color: var(--bo-text-secondary); padding: 16px 12px 6px;
        font-weight: 600;
    }
    .bo-nav-link {
        display: flex; align-items: center; gap: 12px;
        padding: 10px 12px; border-radius: 10px;
        color: var(--bo-text-secondary); text-decoration: none;
        font-weight: 500; font-size: 0.88rem;
        transition: all 0.2s; margin-bottom: 2px;
    }
    .bo-nav-link:hover {
        background: rgba(79,70,229,0.1); color: var(--primary-light);
    }
    .bo-nav-link.active {
        background: rgba(79,70,229,0.15); color: var(--primary-light);
    }
    .bo-nav-link i { font-size: 1.15rem; width: 22px; text-align: center; }
    .bo-nav-badge {
        margin-left: auto; background: var(--primary);
        color: white; font-size: 0.65rem; font-weight: 700;
        padding: 2px 8px; border-radius: 50px;
    }

    .bo-sidebar-user {
        border-top: 1px solid var(--bo-border);
        padding: 14px 16px;
        display: flex; align-items: center; gap: 10px;
    }
    .bo-user-avatar {
        width: 36px; height: 36px; border-radius: 10px;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 0.85rem; color: white; flex-shrink: 0;
    }

    /* ── Top Bar ── */
    .bo-topbar {
        position: fixed; top: 0;
        left: var(--bo-sidebar-w); right: 0;
        height: 64px; z-index: 90;
        background: rgba(15,23,42,0.85);
        backdrop-filter: blur(20px);
        border-bottom: 1px solid var(--bo-border);
        display: flex; align-items: center;
        padding: 0 28px;
    }
    .bo-topbar-title {
        font-weight: 700; font-size: 1.1rem;
    }
    .bo-topbar-actions {
        margin-left: auto;
        display: flex; align-items: center; gap: 12px;
    }
    .bo-topbar-btn {
        width: 36px; height: 36px; border-radius: 10px;
        background: rgba(255,255,255,0.05);
        border: 1px solid var(--bo-border);
        display: flex; align-items: center; justify-content: center;
        color: var(--bo-text-secondary); transition: all 0.2s;
        text-decoration: none; cursor: pointer;
    }
    .bo-topbar-btn:hover {
        background: rgba(79,70,229,0.15); color: var(--primary-light);
        border-color: rgba(79,70,229,0.3);
    }

    /* ── Main Content ── */
    .bo-main {
        margin-left: var(--bo-sidebar-w);
        padding: 88px 28px 28px;
        min-height: 100vh;
    }

    /* ── Cards ── */
    .bo-card {
        background: var(--bo-bg-card);
        border: 1px solid var(--bo-border);
        border-radius: 16px;
        padding: 24px;
        transition: all 0.3s;
    }
    .bo-card:hover {
        border-color: rgba(79,70,229,0.2);
    }
    .bo-stat-card .stat-icon {
        width: 48px; height: 48px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem; margin-bottom: 16px;
    }
    .bo-stat-card .stat-value {
        font-size: 2rem; font-weight: 700;
    }
    .bo-stat-card .stat-label {
        color: var(--bo-text-secondary);
        font-size: 0.85rem; margin-top: 4px;
    }

    /* ── Tables ── */
    .bo-table {
        width: 100%; border-collapse: separate; border-spacing: 0;
    }
    .bo-table th {
        background: rgba(255,255,255,0.03);
        color: var(--bo-text-secondary);
        font-weight: 600; font-size: 0.8rem;
        text-transform: uppercase; letter-spacing: 0.5px;
        padding: 12px 16px; border-bottom: 1px solid var(--bo-border);
    }
    .bo-table td {
        padding: 14px 16px; border-bottom: 1px solid var(--bo-border);
        font-size: 0.9rem; vertical-align: middle;
    }
    .bo-table tr:hover td {
        background: rgba(79,70,229,0.03);
    }
    .bo-table .bo-action-btn {
        display: inline-flex; align-items: center; justify-content: center;
        width: 32px; height: 32px; border-radius: 8px;
        border: 1px solid var(--bo-border); background: transparent;
        color: var(--bo-text-secondary); transition: all 0.2s;
        cursor: pointer; text-decoration: none;
    }
    .bo-table .bo-action-btn:hover {
        background: rgba(79,70,229,0.15); color: var(--primary-light);
        border-color: var(--primary);
    }
    .bo-table .bo-action-btn.danger:hover {
        background: rgba(239,68,68,0.15); color: var(--danger);
        border-color: var(--danger);
    }

    /* ── Forms ── */
    .bo-form .form-control, .bo-form .form-select, .bo-form textarea.form-control {
        background: var(--bo-bg-input);
        border: 1px solid var(--bo-border);
        color: var(--bo-text); border-radius: 10px;
        padding: 10px 16px; font-size: 0.9rem;
    }
    .bo-form .form-control:focus, .bo-form .form-select:focus {
        background: var(--bo-bg-input);
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(79,70,229,0.2);
        color: var(--bo-text);
    }
    .bo-form label {
        font-size: 0.85rem; font-weight: 600;
        color: var(--bo-text-secondary); margin-bottom: 6px;
    }

    /* ── Badges ── */
    .bo-badge {
        display: inline-block; padding: 4px 10px;
        border-radius: 6px; font-size: 0.7rem; font-weight: 600;
    }
    .bo-badge-success { background: rgba(16,185,129,0.15); color: #34d399; }
    .bo-badge-warning { background: rgba(245,158,11,0.15); color: #fbbf24; }
    .bo-badge-danger { background: rgba(239,68,68,0.15); color: #f87171; }
    .bo-badge-primary { background: rgba(79,70,229,0.15); color: var(--primary-light); }
    .bo-badge-neutral { background: rgba(148,163,184,0.15); color: #94a3b8; }

    /* ── Buttons ── */
    .bo-btn {
        border-radius: 10px; font-weight: 600;
        font-size: 0.85rem; padding: 10px 20px;
        transition: all 0.2s; border: none;
    }
    .bo-btn-primary {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
    }
    .bo-btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(79,70,229,0.4);
        color: white;
    }
    .bo-btn-outline {
        background: transparent;
        border: 1px solid var(--bo-border);
        color: var(--bo-text-secondary);
    }
    .bo-btn-outline:hover {
        border-color: var(--primary); color: var(--primary-light);
    }

    .alert-danger { background: rgba(239,68,68,0.15); color: #fca5a5; border: none; }
    .alert-success { background: rgba(16,185,129,0.15); color: #6ee7b7; border: none; }
    .alert-info { background: rgba(6,182,212,0.15); color: #67e8f9; border: none; }

    /* ── Notification Bell ── */
    .notif-wrapper { position: relative; }
    .notif-badge { position: absolute; top: -4px; right: -4px; width: 18px; height: 18px; border-radius: 50%; background: #ef4444; color: white; font-size: 0.6rem; font-weight: 700; display: flex; align-items: center; justify-content: center; border: 2px solid var(--bo-bg); }
    .notif-dropdown { display: none; position: absolute; top: calc(100% + 8px); right: 0; width: 360px; max-height: 440px; background: var(--bo-bg-card); border: 1px solid var(--bo-border); border-radius: 14px; box-shadow: 0 12px 40px rgba(0,0,0,0.3); z-index: 999; overflow: hidden; }
    .notif-dropdown.open { display: block; animation: fadeIn 0.2s ease; }
    @keyframes fadeIn { from { opacity:0; transform: translateY(-6px); } to { opacity:1; transform: translateY(0); } }
    .notif-dropdown-header { padding: 14px 16px; border-bottom: 1px solid var(--bo-border); display: flex; align-items: center; justify-content: space-between; }
    .notif-dropdown-header h6 { margin: 0; font-weight: 700; font-size: 0.9rem; }
    .notif-list { max-height: 340px; overflow-y: auto; }
    .notif-item { padding: 12px 16px; border-bottom: 1px solid var(--bo-border); display: flex; gap: 10px; transition: background 0.2s; cursor: pointer; text-decoration: none; color: var(--bo-text); }
    .notif-item:hover { background: rgba(79,70,229,0.05); color: var(--bo-text); }
    .notif-item.unread { background: rgba(79,70,229,0.04); }
    .notif-item .notif-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--primary-light); flex-shrink: 0; margin-top: 6px; }
    .notif-item.read .notif-dot { background: transparent; }
    .notif-item-title { font-weight: 600; font-size: 0.82rem; }
    .notif-item-msg { font-size: 0.75rem; color: var(--bo-text-secondary); margin-top: 2px; }
    .notif-item-time { font-size: 0.65rem; color: var(--bo-text-secondary); margin-top: 4px; }
    .notif-empty { text-align: center; padding: 30px; color: var(--bo-text-secondary); }

    /* ── Language Toggle ── */
    .lang-toggle {
        display:flex; background:rgba(255,255,255,0.04); border-radius:10px;
        border:1px solid var(--bo-border); overflow:hidden;
    }
    .lang-btn {
        display:flex; align-items:center; gap:4px; padding:6px 12px;
        border:none; background:transparent; color:var(--bo-text-secondary);
        font-size:0.75rem; font-weight:600; cursor:pointer; transition:all 0.25s;
        position:relative; z-index:1;
    }
    .lang-btn.active {
        background:rgba(79,70,229,0.15); color:var(--primary-light);
        box-shadow:inset 0 0 0 1px rgba(79,70,229,0.3);
        border-radius:8px;
    }
    .lang-btn:hover:not(.active) { color:var(--bo-text); background:rgba(255,255,255,0.06); }
    .lang-flag { font-size:0.9rem; }
    .lang-label { letter-spacing:0.5px; }

    /* ═══ Driver.js Onboarding Tour — Dark Theme ═══ */
    .driver-popover {
        background: rgba(30,41,59,0.97) !important;
        backdrop-filter: blur(24px) !important;
        -webkit-backdrop-filter: blur(24px) !important;
        border: 1px solid rgba(79,70,229,0.25) !important;
        border-radius: 18px !important;
        box-shadow: 0 25px 60px rgba(0,0,0,0.45), 0 0 0 1px rgba(79,70,229,0.1) inset !important;
        padding: 24px 24px 18px !important;
        max-width: 380px !important;
    }
    .driver-popover .driver-popover-title {
        font-size: 1.12rem !important;
        font-weight: 800 !important;
        color: #f1f5f9 !important;
        letter-spacing: -0.3px !important;
        margin-bottom: 8px !important;
    }
    .driver-popover .driver-popover-description {
        font-size: 0.86rem !important;
        color: #94a3b8 !important;
        line-height: 1.65 !important;
    }
    .driver-popover .driver-popover-progress-text {
        font-size: 0.7rem !important;
        color: #64748b !important;
        font-weight: 600 !important;
    }
    .driver-popover .driver-popover-navigation-btns {
        gap: 8px !important;
    }
    .driver-popover .driver-popover-next-btn {
        background: linear-gradient(135deg, #4f46e5, #7c3aed) !important;
        color: white !important;
        border: none !important;
        border-radius: 10px !important;
        padding: 8px 20px !important;
        font-weight: 700 !important;
        font-size: 0.82rem !important;
        text-shadow: none !important;
        box-shadow: 0 4px 14px rgba(79,70,229,0.4) !important;
        transition: all 0.2s ease !important;
    }
    .driver-popover .driver-popover-next-btn:hover {
        transform: translateY(-1px) !important;
        box-shadow: 0 6px 18px rgba(79,70,229,0.5) !important;
    }
    .driver-popover .driver-popover-prev-btn {
        background: transparent !important;
        color: #94a3b8 !important;
        border: 1.5px solid rgba(71,85,105,0.5) !important;
        border-radius: 10px !important;
        padding: 8px 16px !important;
        font-weight: 600 !important;
        font-size: 0.82rem !important;
        text-shadow: none !important;
    }
    .driver-popover .driver-popover-prev-btn:hover {
        border-color: #6366f1 !important;
        color: #a5b4fc !important;
    }
    .driver-popover .driver-popover-close-btn {
        color: #64748b !important;
        font-size: 1.2rem !important;
        width: 28px !important; height: 28px !important;
        display: flex !important; align-items: center !important; justify-content: center !important;
        border-radius: 8px !important;
        transition: all 0.2s !important;
    }
    .driver-popover .driver-popover-close-btn:hover {
        background: rgba(239,68,68,0.15) !important;
        color: #f87171 !important;
    }
    .driver-popover-arrow-side-top .driver-popover-arrow,
    .driver-popover-arrow-side-bottom .driver-popover-arrow,
    .driver-popover-arrow-side-left .driver-popover-arrow,
    .driver-popover-arrow-side-right .driver-popover-arrow {
        border-color: rgba(30,41,59,0.97) !important;
    }
    .driver-active-element {
        box-shadow: 0 0 0 4px rgba(99,102,241,0.35), 0 0 24px rgba(99,102,241,0.2) !important;
        border-radius: 12px !important;
    }
</style>
{% endblock %}

{% block body %}
{# ── Sidebar ── #}
<aside class="bo-sidebar">
    <div class="bo-sidebar-header">
        <div style="display:flex;align-items:center;justify-content:space-between">
            <div class="bo-sidebar-logo"><i class="bi bi-briefcase-fill me-1"></i> Talentos</div>
            <div class="lang-toggle" role="group">
                <a href="{{ path('switch_locale', {locale: 'fr'}) }}" class="lang-btn lang-fr {{ app.request.locale == 'fr' ? 'active' : '' }}" title="Français">
                    <span class="lang-flag">🇫🇷</span><span class="lang-label">FR</span>
                </a>
                <a href="{{ path('switch_locale', {locale: 'en'}) }}" class="lang-btn lang-en {{ app.request.locale == 'en' ? 'active' : '' }}" title="English">
                    <span class="lang-flag">🇬🇧</span><span class="lang-label">EN</span>
                </a>
            </div>
        </div>
        <div class="bo-sidebar-label">{{ 'nav.administration'|trans }}</div>
    </div>

    <nav class="bo-sidebar-nav">
        <div class="bo-nav-section">{{ 'nav.main'|trans }}</div>
        <a href="{{ path('admin_dashboard') }}" class="bo-nav-link {{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'active' : '' }}">
            <i class="bi bi-grid-1x2-fill"></i> {{ 'nav.dashboard'|trans }}
        </a>

        <div class="bo-nav-section">{{ 'nav.management'|trans }}</div>
        <a href="{{ path('admin_offers') }}" class="bo-nav-link {{ app.request.attributes.get('_route') starts with 'admin_offer' ? 'active' : '' }}">
            <i class="bi bi-megaphone"></i> {{ 'nav.offers'|trans }}
        </a>
        <a href="{{ path('admin_interviews') }}" class="bo-nav-link {{ app.request.attributes.get('_route') starts with 'admin_interview' ? 'active' : '' }}">
            <i class="bi bi-camera-video"></i> Entretiens
        </a>
        <a href="{{ path('admin_events') }}" class="bo-nav-link {{ app.request.attributes.get('_route') in ['admin_events','admin_event_new','admin_event_edit','admin_event_delete','admin_events_calendar_data','admin_event_participations','admin_participation_status'] ? 'active' : '' }}">
            <i class="bi bi-calendar-event"></i> {{ 'nav.events'|trans }}
        </a>
        <a href="{{ path('admin_event_presence') }}" class="bo-nav-link {{ app.request.attributes.get('_route') in ['admin_event_presence','admin_presence_toggle'] ? 'active' : '' }}" style="padding-left:42px;font-size:0.82rem">
            <i class="bi bi-clipboard-check"></i> Présences
        </a>
        <a href="{{ path('admin_event_feedback') }}" class="bo-nav-link {{ app.request.attributes.get('_route') in ['admin_event_feedback','admin_feedback_delete'] ? 'active' : '' }}" style="padding-left:42px;font-size:0.82rem">
            <i class="bi bi-chat-square-heart"></i> Avis
        </a>
        <a href="{{ path('admin_event_stats') }}" class="bo-nav-link {{ app.request.attributes.get('_route') == 'admin_event_stats' ? 'active' : '' }}" style="padding-left:42px;font-size:0.82rem">
            <i class="bi bi-graph-up"></i> Statistiques
        </a>
        <a href="{{ path('admin_projects') }}" class="bo-nav-link {{ app.request.attributes.get('_route') starts with 'admin_project' ? 'active' : '' }}">
            <i class="bi bi-kanban"></i> {{ 'nav.projects'|trans }}
        </a>
        <a href="{{ path('admin_projects_kanban') }}" class="bo-nav-link {{ app.request.attributes.get('_route') == 'admin_projects_kanban' ? 'active' : '' }}" style="padding-left:42px;font-size:0.82rem">
            <i class="bi bi-columns-gap"></i> Kanban Board
        </a>

        <a href="{{ path('admin_activities') }}" class="bo-nav-link {{ app.request.attributes.get('_route') starts with 'admin_activit' ? 'active' : '' }}">
            <i class="bi bi-clipboard-data"></i> {{ 'nav.activities'|trans }}
        </a>
        <a href="{{ path('admin_leaderboard') }}" class="bo-nav-link {{ app.request.attributes.get('_route') == 'admin_leaderboard' ? 'active' : '' }}" style="padding-left:42px;font-size:0.82rem">
            <i class="bi bi-trophy"></i> Leaderboard
        </a>
        <a href="{{ path('admin_courses') }}" class="bo-nav-link {{ app.request.attributes.get('_route') starts with 'admin_course' ? 'active' : '' }}">
            <i class="bi bi-book"></i> {{ 'nav.courses'|trans }}
        </a>

        <a href="{{ path('admin_calendar') }}" class="bo-nav-link {{ app.request.attributes.get('_route') in ['admin_calendar','admin_calendar_data'] ? 'active' : '' }}">
            <i class="bi bi-calendar-week"></i> Calendrier
        </a>
        <a href="{{ path('admin_hr_messages') }}" class="bo-nav-link {{ app.request.attributes.get('_route') starts with 'admin_hr_messages' or app.request.attributes.get('_route') == 'admin_message_candidate' ? 'active' : '' }}">
            <i class="bi bi-chat-dots-fill"></i> Messages candidats
        </a>

        {% if app.user.role == 'ADMIN' %}
        <div class="bo-nav-section">{{ 'nav.administration'|trans }}</div>
        <a href="{{ path('admin_users') }}" class="bo-nav-link {{ app.request.attributes.get('_route') starts with 'admin_user' ? 'active' : '' }}">
            <i class="bi bi-people-fill"></i> {{ 'nav.users'|trans }}
        </a>
        <a href="{{ path('admin_support') }}" class="bo-nav-link {{ app.request.attributes.get('_route') starts with 'admin_support' ? 'active' : '' }}">
            <i class="bi bi-headset"></i> {{ 'nav.tickets'|trans }}
        </a>
        {% endif %}

        <hr style="border-color:var(--bo-border);margin:8px 0">
        <a href="{{ path('app_home') }}" class="bo-nav-link">
            <i class="bi bi-box-arrow-up-right"></i> {{ 'nav.view_site'|trans }}
        </a>
        <a href="#" class="bo-nav-link" id="boReplayTour" onclick="event.preventDefault();localStorage.removeItem('talentos_bo_tour_done');location.reload();" style="color:#64748b">
            <i class="bi bi-signpost-2"></i> Relancer le guide
        </a>
    </nav>


    <div class="bo-sidebar-user">
        <a href="{{ path('admin_profile') }}" style="text-decoration:none;display:flex;align-items:center;gap:10px;flex:1;min-width:0">
            {% if app.user.profile and app.user.profile.profilePicturePath %}
                <img src="{{ app.user.profile.profilePicturePath }}" style="width:36px;height:36px;border-radius:50%;object-fit:cover;border:2px solid rgba(79,70,229,0.3)" alt="">
            {% else %}
                <div class="bo-user-avatar">{{ app.user.email|first|upper }}</div>
            {% endif %}
            <div style="flex:1;min-width:0">
                <div style="font-weight:600;font-size:0.8rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--bo-text)">
                    {% if app.user.profile and app.user.profile.firstName %}{{ app.user.profile.firstName }} {{ app.user.profile.lastName }}{% else %}{{ app.user.email }}{% endif %}
                </div>
                <div style="font-size:0.7rem;color:var(--bo-text-secondary)">{{ app.user.role }}</div>
            </div>
        </a>
        <a href="{{ path('app_logout') }}" class="bo-topbar-btn" title="{{ 'nav.logout'|trans }}">
            <i class="bi bi-box-arrow-right" style="font-size:0.9rem"></i>
        </a>
    </div>
</aside>

{# ── Top Bar ── #}
<header class="bo-topbar">
    <div class="bo-topbar-title">{% block page_title %}{{ 'nav.dashboard'|trans }}{% endblock %}</div>
    <div class="bo-topbar-actions">
        {# Notification bell #}
        <div class="notif-wrapper">
            <button class="bo-topbar-btn" id="notifToggle" title="{{ 'nav.notifications'|trans }}" onclick="toggleNotifDropdown()" style="position:relative">
                <i class="bi bi-bell"></i>
                {% if notif_unread_count is defined and notif_unread_count > 0 %}
                    <span class="notif-badge">{{ notif_unread_count > 9 ? '9+' : notif_unread_count }}</span>
                {% endif %}
            </button>
            <div class="notif-dropdown" id="notifDropdown">
                <div class="notif-dropdown-header">
                    <h6><i class="bi bi-bell me-1"></i> {{ 'notif.title'|trans }}</h6>
                {% if notif_unread_count is defined and notif_unread_count > 0 %}
                    <a href="{{ path('admin_notifications_read_all') }}" style="font-size:0.75rem;color:var(--primary-light);text-decoration:none">{{ 'notif.mark_all'|trans }}</a>
                    {% endif %}
                </div>
                <div class="notif-list">
                    {% if notif_latest is defined and notif_latest|length > 0 %}
                        {% for n in notif_latest %}
                            <a href="{{ path('admin_notification_read', {id: n.id}) }}" class="notif-item {{ n.isRead ? 'read' : 'unread' }}">
                                <div class="notif-dot"></div>
                                <div style="flex:1;min-width:0">
                                    <div class="notif-item-title">{{ n.title }}</div>
                                    {% if n.message %}<div class="notif-item-msg">{{ n.message|length > 80 ? n.message|slice(0, 80) ~ '…' : n.message }}</div>{% endif %}
                                    <div class="notif-item-time"><i class="bi bi-clock me-1"></i>{{ n.createdAt|date('d/m/Y H:i') }}</div>
                                </div>
                            </a>
                        {% endfor %}
                    {% else %}
                        <div class="notif-empty"><i class="bi bi-bell-slash" style="font-size:1.5rem;opacity:0.3;display:block;margin-bottom:6px"></i>{{ 'notif.empty'|trans }}</div>
                    {% endif %}
                </div>
                <a href="{{ path('admin_notifications') }}" style="display:block;text-align:center;padding:10px;font-size:0.8rem;color:var(--primary-light);text-decoration:none;border-top:1px solid var(--bo-border);font-weight:600">{{ 'notif.view_all'|trans }}</a>
            </div>
        </div>
        <a href="{{ path('admin_profile') }}" class="bo-topbar-btn" title="{{ 'nav.profile'|trans }}"><i class="bi bi-person-circle"></i></a>
        <a href="{{ path('app_home') }}" class="bo-topbar-btn" title="{{ 'nav.view_site'|trans }}"><i class="bi bi-box-arrow-up-right"></i></a>
        <a href="{{ path('app_logout') }}" class="bo-topbar-btn" title="{{ 'nav.logout'|trans }}"><i class="bi bi-power"></i></a>
    </div>
</header>

<script>
function toggleNotifDropdown() {
    document.getElementById('notifDropdown').classList.toggle('open');
}
document.addEventListener('click', function(e) {
    var w = document.querySelector('.notif-wrapper');
    if (w && !w.contains(e.target)) document.getElementById('notifDropdown').classList.remove('open');
});
</script>

{# ── Main Content ── #}
<main class="bo-main">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} mb-3"><i class="bi bi-{{ label == 'success' ? 'check-circle-fill' : (label == 'danger' ? 'exclamation-circle-fill' : 'info-circle-fill') }} me-2"></i>{{ message }}</div>
        {% endfor %}
    {% endfor %}
    {% block content %}{% endblock %}
</main>

<!-- Driver.js for RH Onboarding Tour -->
<script src="https://cdn.jsdelivr.net/npm/driver.js@1.0.1/dist/driver.js.iife.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/driver.js@1.0.1/dist/driver.css"/>

<script>
document.addEventListener("DOMContentLoaded", function() {
    if (!localStorage.getItem('talentos_bo_tour_done')) {
        setTimeout(function() {
            const driver = window.driver.js.driver;
            const driverObj = driver({
                showProgress: true,
                allowClose: true,
                animate: true,
                overlayColor: 'rgba(0, 0, 0, 0.8)',
                doneBtnText: 'C\'est parti ! 🚀',
                closeBtnText: 'Passer',
                nextBtnText: 'Suivant &rarr;',
                prevBtnText: '&larr; Précédent',
                onDestroyed: () => {
                    localStorage.setItem('talentos_bo_tour_done', 'true');
                },
                steps: [
                    {
                        popover: {
                            title: 'Bienvenue dans votre Espace RH ! 🏢',
                            description: 'C\'est ici que vous gérez l\'ensemble du processus de recrutement. Nous allons vous montrer les fonctionnalités clés en quelques secondes.',
                            side: "bottom",
                            align: 'center'
                        }
                    },
                    {
                        element: '.bo-sidebar',
                        popover: {
                            title: 'Votre panneau de navigation',
                            description: 'La barre latérale regroupe tous les modules : offres, événements, projets, formations, et plus encore. Tout est accessible en un clic.',
                            side: "right",
                            align: 'start'
                        }
                    },
                    {
                        element: '.bo-nav-link[href*="offers"]',
                        popover: {
                            title: 'Gestion des Offres d\'Emploi 💼',
                            description: 'Créez, modifiez et publiez vos offres d\'emploi. Vous pouvez également consulter les candidatures reçues et changer leur statut (acceptée / refusée).',
                            side: "right",
                            align: 'start'
                        }
                    },
                    {
                        element: '.bo-nav-link[href*="events"]',
                        popover: {
                            title: 'Organisation d\'Événements 📅',
                            description: 'Planifiez des job fairs, des workshops ou des webinaires. Gérez les participations, les présences et consultez les feedbacks des participants.',
                            side: "right",
                            align: 'start'
                        }
                    },
                    {
                        element: '.bo-nav-link[href*="messages"]',
                        popover: {
                            title: 'Messagerie Candidats 💬',
                            description: 'Échangez directement avec les candidats qui ont postulé à vos offres. La communication directe améliore l\'expérience candidat.',
                            side: "right",
                            align: 'start'
                        }
                    },
                    {
                        element: '#notifToggle',
                        popover: {
                            title: 'Centre de Notifications 🔔',
                            description: 'Recevez des alertes en temps réel : nouvelle candidature, message d\'un candidat, événement à venir... Ne manquez rien !',
                            side: "bottom",
                            align: 'end'
                        }
                    },
                    {
                        element: '.bo-sidebar-user',
                        popover: {
                            title: 'Votre Profil',
                            description: 'Cliquez ici pour modifier vos informations personnelles ou vous déconnecter. Bon recrutement ! 🌟',
                            side: "top",
                            align: 'start'
                        }
                    }
                ]
            });

            driverObj.drive();
        }, 1200);
    }
});
</script>

{% endblock %}
