{% extends 'back/_base.html.twig' %}
{% block page_title %}Logs des Contributions — {{ project.name }}{% endblock %}
{% block content %}
<div class="mb-4 d-flex justify-content-between align-items-center">
    <a href="{{ path('admin_projects') }}" style="color:var(--primary-light);text-decoration:none;font-size:0.9rem"><i class="bi bi-arrow-left me-1"></i> Retour</a>
</div>

<h4 style="font-weight:800; margin-bottom:24px"><i class="bi bi-bar-chart-line-fill me-2" style="color:var(--primary)"></i> Dashboard de Performance: {{ project.name }}</h4>

<div class="row g-4">
    {% for stat in logs %}
        <div class="col-lg-6">
            <div class="bo-card" style="position:relative; {% if stat.percentage < 50 and stat.total > 0 %}border-left:5px solid #ef4444;{% else %}border-left:5px solid var(--success);{% endif %}">
                <div class="d-flex align-items-start gap-3 mb-3">
                    <div style="width:48px;height:48px;border-radius:12px;background:rgba(255,255,255,0.05);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i class="bi bi-person-badge" style="font-size:1.5rem; color:var(--bo-text-secondary)"></i>
                    </div>
                    <div>
                        <h6 style="font-weight:700; margin:0">{{ stat.employee.email }}</h6>
                        <span class="badge {% if stat.percentage >= 50 %}bg-success{% else %}bg-danger{% endif %} mt-1">Rentabilité : {{ stat.percentage }}%</span>
                    </div>
                </div>

                <div class="row text-center mt-3 mb-4 g-2">
                    <div class="col-4">
                        <div style="background:rgba(255,255,255,0.03); border-radius:8px; padding:10px;">
                            <div style="font-weight:800; font-size:1.2rem">{{ stat.total }}</div>
                            <div style="font-size:0.75rem; color:var(--bo-text-secondary)">Assignées</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div style="background:rgba(255,255,255,0.03); border-radius:8px; padding:10px;">
                            <div style="font-weight:800; font-size:1.2rem; color:var(--success)">{{ stat.approved }}</div>
                            <div style="font-size:0.75rem; color:var(--bo-text-secondary)">Validées</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div style="background:rgba(255,255,255,0.03); border-radius:8px; padding:10px;">
                            <div style="font-weight:800; font-size:1.2rem; color:{% if stat.onTime == stat.total %}var(--success){% else %}var(--warning){% endif %}">{{ stat.onTime }}</div>
                            <div style="font-size:0.75rem; color:var(--bo-text-secondary)">À l'heure</div>
                        </div>
                    </div>
                </div>

                {% if stat.percentage < 50 and stat.total > 0 %}
                    <div class="alert alert-danger" style="background:rgba(239, 68, 68, 0.1); border:1px solid #ef4444; color:#ef4444; padding:12px; font-size:0.85rem">
                        <i class="bi bi-exclamation-octagon-fill me-2"></i> L'efficacité de ce candidat est en dessous du quota acceptable. Une action disciplinaire est conseillée.
                    </div>
                {% endif %}

                <h6 style="font-weight:700; font-size:0.85rem; margin-top:20px; color:var(--bo-text-secondary)">Rapport des tâches :</h6>
                <div style="max-height:200px; overflow-y:auto; padding-right:8px;">
                    {% for a in stat.activities %}
                        <div class="d-flex align-items-center justify-content-between py-2" style="border-bottom:1px solid var(--bo-border);">
                            <div style="flex:1">
                                <div style="font-size:0.85rem; font-weight:600">{{ a.description }}</div>
                                <div style="font-size:0.75rem; color:var(--bo-text-secondary)">Créée le {{ a.activityDate|date('d/m') }} {% if a.deadline %}— Deadline: {{ a.deadline|date('d/m') }}{% endif %}</div>
                            </div>
                            <div style="text-align:right">
                                <span class="badge {% if a.status == 'APPROVED' %}bg-success{% elseif a.status == 'REJECTED' %}bg-danger{% else %}bg-warning text-dark{% endif %}" style="font-size:0.65rem">{{ a.status }}</span>
                                <span class="badge {% if a.isOnTime() %}bg-success{% else %}bg-danger{% endif %}" style="font-size:0.65rem">{% if a.isOnTime() %}ON TIME{% else %}LATE{% endif %}</span>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12 text-center" style="padding:60px">
            <i class="bi bi-folder-x" style="font-size:3rem; color:var(--bo-text-secondary); opacity:0.5"></i>
            <p class="mt-3" style="color:var(--bo-text-secondary)">Aucune activité n'a encore été enregistrée sur ce projet.</p>
        </div>
    {% endfor %}
</div>
{% endblock %}
