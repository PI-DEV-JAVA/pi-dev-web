{% extends 'base.html.twig' %}
{% from 'components/_sidebar.html.twig' import sidebar %}

{% block title %}Offres — Talentos{% endblock %}

{% block body %}
{{ sidebar(app.user) }}

<main class="app-main">
    <div class="page-header d-flex align-items-center justify-content-between">
        <div>
            <h2>Offres d'emploi 💼</h2>
            <p>Trouvez l'opportunité qui vous correspond</p>
        </div>
    </div>

    {# Search & Filters #}
    <div class="stat-card" style="margin-bottom:24px;padding:20px">
        <form method="get" class="d-flex gap-3 align-items-end flex-wrap">
            <div style="flex:1;min-width:250px">
                <label class="form-label" style="color:var(--text-secondary);font-size:0.8rem">Rechercher</label>
                <div class="input-group">
                    <span class="input-group-text" style="background:var(--bg-input);border-color:var(--border);color:var(--text-secondary);border-radius:10px 0 0 10px">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="q" class="form-control" value="{{ search }}"
                           placeholder="Titre, compétence, département..."
                           style="background:var(--bg-input);border-color:var(--border);color:var(--text-primary);border-radius:0 10px 10px 0">
                </div>
            </div>
            <div style="width:180px">
                <label class="form-label" style="color:var(--text-secondary);font-size:0.8rem">Type de contrat</label>
                <select name="contract" class="form-select" style="background:var(--bg-input);border-color:var(--border);color:var(--text-primary);border-radius:10px">
                    <option value="">Tous</option>
                    <option value="CDI" {{ contractFilter == 'CDI' ? 'selected' }}>CDI</option>
                    <option value="CDD" {{ contractFilter == 'CDD' ? 'selected' }}>CDD</option>
                    <option value="Stage" {{ contractFilter == 'Stage' ? 'selected' }}>Stage</option>
                    <option value="Freelance" {{ contractFilter == 'Freelance' ? 'selected' }}>Freelance</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary-custom" style="width:auto;padding:10px 20px;height:42px;border-radius:10px">
                Filtrer
            </button>
        </form>
    </div>

    {# Offers Grid #}
    {% if offers is empty %}
        <div class="stat-card text-center" style="padding:60px">
            <i class="bi bi-inbox" style="font-size:3rem;color:var(--text-secondary)"></i>
            <p class="mt-3" style="color:var(--text-secondary)">Aucune offre trouvée.</p>
        </div>
    {% else %}
        <div class="row g-4">
            {% for offer in offers %}
                <div class="col-md-6 col-lg-4">
                    <a href="{{ path('app_offer_detail', {id: offer.id}) }}" class="text-decoration-none">
                        <div class="stat-card h-100" style="cursor:pointer">
                            <div class="d-flex align-items-start justify-content-between mb-3">
                                <div>
                                    <h5 style="font-weight:600;color:var(--text-primary);margin-bottom:4px">{{ offer.title }}</h5>
                                    <small style="color:var(--text-secondary)">{{ offer.department ?: '—' }}</small>
                                </div>
                                {% if offer.contractType %}
                                    <span class="badge" style="background:rgba(6,182,212,0.15);color:var(--accent);font-weight:500;padding:4px 10px;border-radius:6px;font-size:0.75rem">
                                        {{ offer.contractType }}
                                    </span>
                                {% endif %}
                            </div>

                            <p style="color:var(--text-secondary);font-size:0.85rem;line-height:1.5;margin-bottom:12px;
                                       display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
                                {{ offer.description|default('Aucune description')|striptags|slice(0,120) }}{% if offer.description|length > 120 %}...{% endif %}
                            </p>

                            <div class="d-flex flex-wrap gap-2" style="font-size:0.8rem;color:var(--text-secondary)">
                                {% if offer.location %}
                                    <span><i class="bi bi-geo-alt me-1"></i>{{ offer.location }}</span>
                                {% endif %}
                                {% if offer.experienceLevel %}
                                    <span><i class="bi bi-bar-chart me-1"></i>{{ offer.experienceLevel }}</span>
                                {% endif %}
                                {% if offer.salaryMin and offer.salaryMax %}
                                    <span><i class="bi bi-cash me-1"></i>{{ offer.salaryMin|number_format(0,'',',')|replace({',': ' '}) }}–{{ offer.salaryMax|number_format(0,'',',')|replace({',': ' '}) }} DT</span>
                                {% endif %}
                            </div>

                            <div class="mt-3 pt-3" style="border-top:1px solid rgba(71,85,105,0.2);font-size:0.75rem;color:var(--text-secondary)">
                                <i class="bi bi-clock me-1"></i>{{ offer.publishDate ? offer.publishDate|date('d/m/Y') : '—' }}
                                <span class="float-end">{{ offer.applicationsReceived }} candidature{{ offer.applicationsReceived > 1 ? 's' }}</span>
                            </div>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</main>
{% endblock %}
