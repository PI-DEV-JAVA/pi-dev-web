{% extends 'base.html.twig' %}
{% from 'components/_sidebar.html.twig' import sidebar %}

{% block title %}Entretiens — Talentos{% endblock %}

{% block body %}
{{ sidebar(app.user) }}

<main class="app-main">
    <div class="page-header">
        <h2>Entretiens 🎥</h2>
        <p>Vos entretiens planifiés</p>
    </div>

    {% if interviews is empty %}
        <div class="stat-card text-center" style="padding:60px">
            <i class="bi bi-camera-video" style="font-size:3rem;color:var(--text-secondary)"></i>
            <p class="mt-3" style="color:var(--text-secondary)">Aucun entretien planifié.</p>
        </div>
    {% else %}
        <div class="row g-4">
            {% for interview in interviews %}
                <div class="col-md-6">
                    <div class="stat-card">
                        <div class="d-flex align-items-start gap-3">
                            <div style="width:48px;height:48px;border-radius:12px;background:rgba(16,185,129,0.15);
                                        display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                <i class="bi bi-camera-video" style="color:var(--success);font-size:1.2rem"></i>
                            </div>
                            <div style="flex:1">
                                <h6 style="font-weight:600;margin-bottom:4px">{{ interview.application.offer.title }}</h6>
                                <div style="color:var(--text-secondary);font-size:0.85rem;margin-bottom:8px">
                                    <i class="bi bi-calendar3 me-1"></i>{{ interview.interviewDate|date('d/m/Y à H:i') }}
                                </div>
                                {% if interview.meetingLink %}
                                    <a href="{{ interview.meetingLink }}" target="_blank" class="btn btn-sm" 
                                       style="background:rgba(16,185,129,0.15);color:var(--success);border-radius:8px;font-size:0.8rem;padding:4px 12px">
                                        <i class="bi bi-camera-video me-1"></i>Rejoindre
                                    </a>
                                {% endif %}
                                <span class="badge ms-2" style="background:rgba(79,70,229,0.15);color:var(--primary-light);padding:4px 10px;border-radius:6px;font-size:0.75rem">
                                    {{ interview.status|default('Planifié') }}
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</main>
{% endblock %}
