{% extends 'back/_base.html.twig' %}
{% block page_title %}Gestion des offres{% endblock %}
{% block title %}Offres — Admin{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 style="font-weight:700;margin:0">Offres ({{ offers|length }})</h5>
    <a href="{{ path('admin_offer_new') }}" class="bo-btn bo-btn-primary"><i class="bi bi-plus-lg me-1"></i> Nouvelle offre</a>
</div>

<div class="bo-card">
    <table class="bo-table">
        <thead><tr><th>Titre</th><th>Type</th><th>Lieu</th><th>Candidatures</th><th>Statut</th><th>Actions</th></tr></thead>
        <tbody>
            {% for offer in offers %}
                <tr>
                    <td style="font-weight:600">{{ offer.title }}</td>
                    <td><span class="bo-badge bo-badge-primary">{{ offer.contractType ?: '—' }}</span></td>
                    <td style="color:var(--bo-text-secondary)">{{ offer.location ?: '—' }}</td>
                    <td>{{ offer.applicationsReceived }}</td>
                    <td><span class="bo-badge bo-badge-success">{{ offer.status ?: 'Active' }}</span></td>
                    <td>
                        <a href="{{ path('admin_offer_applications', {id: offer.id}) }}" class="bo-action-btn" title="Candidatures"><i class="bi bi-people"></i></a>
                        <a href="{{ path('admin_offer_edit', {id: offer.id}) }}" class="bo-action-btn" title="Modifier"><i class="bi bi-pencil"></i></a>
                        <a href="{{ path('admin_offer_delete', {id: offer.id}) }}" class="bo-action-btn danger" title="Supprimer" onclick="return confirm('Supprimer cette offre ?')"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="text-center" style="padding:30px;color:var(--bo-text-secondary)">Aucune offre.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
