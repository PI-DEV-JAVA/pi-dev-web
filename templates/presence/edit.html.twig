{% extends 'base.html.twig' %}

{% block title %}Modifier la Présence | PIWEB{% endblock %}

{% block body %}
    <div class="mb-6 flex items-center justify-between">
        <h1 class="text-2xl font-semibold text-gray-900">Modifier la présence</h1>
        <a href="{{ path('app_presence_index') }}" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">Retour à la liste</a>
    </div>

    {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
        <div class="bg-white px-4 py-5 shadow sm:rounded-lg sm:p-6">
            <div class="md:grid md:grid-cols-3 md:gap-6">
                <div class="md:col-span-1">
                    <h3 class="text-lg font-medium leading-6 text-gray-900">État de la présence</h3>
                </div>
                <div class="mt-5 md:col-span-2 md:mt-0 space-y-6">
                    <div class="flex items-center">
                        {{ form_widget(form.estPresent) }}
                        {{ form_label(form.estPresent, null, {'label_attr': {'class': 'ml-2 block text-sm text-gray-900'}}) }}
                    </div>
                </div>
            </div>
        </div>

        <div class="flex justify-end gap-3 mt-4">
            <a href="{{ path('app_presence_index') }}" class="rounded-md border border-gray-300 bg-white py-2 px-4 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50">Annuler</a>
            <button class="inline-flex justify-center rounded-md border border-transparent bg-indigo-600 py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-indigo-700">Enregistrer</button>
        </div>
    {{ form_end(form) }}
{% endblock %}
