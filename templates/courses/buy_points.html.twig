{% extends 'base.html.twig' %}
{% from 'components/_sidebar.html.twig' import sidebar %}

{% block title %}Acheter des points — Talentos{% endblock %}

{% block body %}
{{ sidebar(app.user) }}

<main class="app-main">
    <div class="mb-3">
        <a href="{{ path('app_courses') }}" style="color:var(--primary-light);text-decoration:none;font-size:0.9rem">
            <i class="bi bi-arrow-left me-1"></i> Retour aux formations
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="stat-card text-center" style="padding:40px 32px">

                {# Balance display #}
                <div style="width:100px;height:100px;border-radius:50%;margin:0 auto 20px;
                            background:linear-gradient(135deg,#f59e0b,#d97706);
                            display:flex;align-items:center;justify-content:center;
                            box-shadow:0 8px 30px rgba(245,158,11,0.4)">
                    <i class="bi bi-coin" style="font-size:2.5rem;color:#fff"></i>
                </div>

                <h3 style="font-weight:800;margin-bottom:6px">Mon solde</h3>
                <div style="font-size:3rem;font-weight:900;color:#f59e0b;line-height:1;margin-bottom:4px">
                    {{ app.user.pointsBalance }}
                </div>
                <div style="color:var(--text-secondary);font-size:0.9rem;margin-bottom:32px">points disponibles</div>

                {# How to earn points info #}
                <div style="background:rgba(79,70,229,0.08);border:1px solid rgba(79,70,229,0.2);
                            border-radius:12px;padding:16px;margin-bottom:28px;text-align:left">
                    <div style="font-weight:600;font-size:0.9rem;margin-bottom:10px;color:var(--primary-light)">
                        <i class="bi bi-info-circle me-2"></i>Comment gagner des points ?
                    </div>
                    <div style="font-size:0.82rem;color:var(--text-secondary);line-height:1.7">
                        • Réussir un quiz avec <strong style="color:var(--text-primary)">&gt; 15/20</strong> → vos points = votre note<br>
                        • Acheter des points ci-dessous pour accéder aux formations payantes
                    </div>
                </div>

                {# Buy form #}
                <form method="POST" action="{{ path('app_points_buy') }}">
                    <label style="display:block;text-align:left;font-size:0.85rem;font-weight:600;margin-bottom:8px;color:var(--text-primary)">
                        Montant à acheter (10 – 1000 pts)
                    </label>

                    <div class="d-flex gap-2 mb-3 flex-wrap justify-content-center">
                        {% for preset in [50, 100, 200, 500] %}
                        <button type="button"
                                onclick="document.getElementById('amount').value={{ preset }}"
                                style="background:var(--bg-input);border:1px solid var(--border);color:var(--text-primary);
                                       border-radius:8px;padding:8px 16px;font-size:0.85rem;cursor:pointer;
                                       transition:all 0.2s;font-weight:600"
                                onmouseover="this.style.borderColor='#f59e0b';this.style.color='#f59e0b'"
                                onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-primary)'">
                            {{ preset }} pts
                        </button>
                        {% endfor %}
                    </div>

                    <input type="number" id="amount" name="amount" min="10" max="1000" value="100" required
                           style="width:100%;background:var(--bg-input);border:1px solid var(--border);
                                  color:var(--text-primary);border-radius:10px;padding:12px 16px;
                                  font-size:1.1rem;font-weight:700;text-align:center;margin-bottom:16px">

                    <button type="submit"
                            style="width:100%;background:linear-gradient(135deg,#f59e0b,#d97706);
                                   color:#fff;border:none;border-radius:12px;padding:14px;
                                   font-size:1rem;font-weight:700;cursor:pointer;
                                   transition:opacity 0.2s;display:flex;align-items:center;justify-content:center;gap:8px"
                            onmouseover="this.style.opacity='.85'"
                            onmouseout="this.style.opacity='1'">
                        <i class="bi bi-cart-check"></i>
                        Confirmer l'achat
                    </button>

                    <p style="margin-top:14px;font-size:0.75rem;color:var(--text-secondary)">
                        <i class="bi bi-shield-lock me-1"></i>Simulation de paiement — aucune transaction réelle
                    </p>
                </form>
            </div>
        </div>
    </div>
</main>
{% endblock %}
