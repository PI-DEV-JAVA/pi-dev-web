{% extends 'back/_base.html.twig' %}
{% block page_title %}Kanban — Projets{% endblock %}
{% block content %}
<style>
    .kanban-board { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; min-height: 70vh; }
    .kanban-col { background: rgba(255,255,255,0.02); border: 1px solid var(--bo-border); border-radius: 16px; padding: 16px; min-height: 300px; transition: background 0.3s; }
    .kanban-col.drag-over { background: rgba(79,70,229,0.08); border-color: rgba(79,70,229,0.3); }
    .kanban-col-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 2px solid var(--bo-border); }
    .kanban-col-title { font-weight: 700; font-size: 0.85rem; display: flex; align-items: center; gap: 8px; }
    .kanban-col-count { background: rgba(255,255,255,0.06); padding: 2px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; color: var(--bo-text-secondary); }
    .kanban-card { background: var(--bo-bg-card); border: 1px solid var(--bo-border); border-radius: 12px; padding: 16px; margin-bottom: 10px; cursor: grab; transition: all 0.2s; }
    .kanban-card:hover { border-color: rgba(79,70,229,0.3); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.2); }
    .kanban-card.dragging { opacity: 0.5; transform: rotate(2deg); }
    .kanban-card-title { font-weight: 700; font-size: 0.9rem; margin-bottom: 8px; }
    .kanban-card-meta { font-size: 0.75rem; color: var(--bo-text-secondary); display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .kanban-card-actions { margin-top: 10px; display: flex; gap: 6px; }
    .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
    @media (max-width: 992px) { .kanban-board { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 576px) { .kanban-board { grid-template-columns: 1fr; } }
</style>

<div class="d-flex align-items-center justify-content-between" style="margin-bottom:20px;flex-wrap:wrap;gap:12px">
    <h5 style="font-weight:700;margin:0">Kanban Board (<span>{{ totalProjects }}</span> projets)</h5>
    <div class="d-flex align-items-center gap-2">
        <a href="{{ path('admin_projects') }}" class="bo-btn bo-btn-outline"><i class="bi bi-list-ul me-1"></i> Vue liste</a>
        <a href="{{ path('admin_project_new') }}" class="bo-btn bo-btn-primary"><i class="bi bi-plus-lg me-1"></i> Nouveau</a>
    </div>
</div>

{% for message in app.flashes('success') %}
    <div class="alert" style="background:rgba(16,185,129,0.1);color:#10b981;border:1px solid rgba(16,185,129,0.2);border-radius:12px;padding:12px;font-size:0.85rem;margin-bottom:16px">
        <i class="bi bi-check-circle-fill me-2"></i>{{ message }}
    </div>
{% endfor %}

{% set colConfig = {
    'PLANNED': {'label': 'Planifié', 'color': '#f59e0b', 'icon': 'hourglass-split'},
    'IN_PROGRESS': {'label': 'En cours', 'color': '#4f46e5', 'icon': 'play-circle-fill'},
    'DONE': {'label': 'Terminé', 'color': '#10b981', 'icon': 'check-circle-fill'},
    'ON_HOLD': {'label': 'En attente', 'color': '#ef4444', 'icon': 'pause-circle-fill'}
} %}

<div class="kanban-board">
    {% for status, projects in columns %}
    {% set cfg = colConfig[status] %}
    <div class="kanban-col" id="col-{{ status }}" data-status="{{ status }}"
         ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event)">
        <div class="kanban-col-header">
            <div class="kanban-col-title">
                <span class="dot" style="background:{{ cfg.color }}"></span>
                <i class="bi bi-{{ cfg.icon }}" style="color:{{ cfg.color }}"></i>
                {{ cfg.label }}
            </div>
            <span class="kanban-col-count" id="count-{{ status }}">{{ projects|length }}</span>
        </div>
        <div class="kanban-cards" id="cards-{{ status }}">
            {% for p in projects %}
            <div class="kanban-card" draggable="true" data-id="{{ p.id }}"
                 ondragstart="handleDragStart(event)" ondragend="handleDragEnd(event)">
                <div class="kanban-card-title">{{ p.name }}</div>
                {% if p.description %}
                    <div style="font-size:0.8rem;color:var(--bo-text-secondary);margin-bottom:8px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
                        {{ p.description|slice(0, 80) }}{% if p.description|length > 80 %}…{% endif %}
                    </div>
                {% endif %}
                <div class="kanban-card-meta">
                    {% if p.startDate %}
                        <span><i class="bi bi-calendar3 me-1"></i>{{ p.startDate|date('d/m/Y') }}</span>
                    {% endif %}
                    {% if p.budget %}
                        <span><i class="bi bi-wallet2 me-1"></i>{{ p.budget }} DT</span>
                    {% endif %}
                </div>
                <div class="kanban-card-actions">
                    <a href="{{ path('admin_project_edit', {id: p.id}) }}" class="bo-action-btn" title="Modifier" style="width:28px;height:28px;border-radius:6px;border:1px solid var(--bo-border);display:inline-flex;align-items:center;justify-content:center;color:var(--bo-text-secondary);text-decoration:none;font-size:0.8rem;transition:all 0.2s"><i class="bi bi-pencil"></i></a>
                    <a href="{{ path('admin_project_logs', {id: p.id}) }}" class="bo-action-btn" title="Logs" style="width:28px;height:28px;border-radius:6px;border:1px solid var(--bo-border);display:inline-flex;align-items:center;justify-content:center;color:var(--bo-text-secondary);text-decoration:none;font-size:0.8rem;transition:all 0.2s"><i class="bi bi-clock-history"></i></a>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endfor %}
</div>

{# Toast notification #}
<div id="toast" style="display:none;position:fixed;bottom:24px;right:24px;z-index:9999;background:var(--bo-bg-card);border:1px solid rgba(16,185,129,0.3);border-radius:12px;padding:14px 20px;font-size:0.85rem;box-shadow:0 12px 40px rgba(0,0,0,0.3);animation:fadeIn 0.3s ease">
    <i class="bi bi-check-circle-fill me-2" style="color:#10b981"></i><span id="toastMsg"></span>
</div>

<script>
var draggedCard = null;

function handleDragStart(e) {
    draggedCard = e.target.closest('.kanban-card');
    draggedCard.classList.add('dragging');
    e.dataTransfer.effectAllowed = 'move';
    e.dataTransfer.setData('text/plain', draggedCard.dataset.id);
}

function handleDragEnd(e) {
    if (draggedCard) draggedCard.classList.remove('dragging');
    document.querySelectorAll('.kanban-col').forEach(function(col) { col.classList.remove('drag-over'); });
}

function handleDragOver(e) {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    e.currentTarget.classList.add('drag-over');
}

function handleDragLeave(e) {
    e.currentTarget.classList.remove('drag-over');
}

function handleDrop(e) {
    e.preventDefault();
    var col = e.currentTarget;
    col.classList.remove('drag-over');
    if (!draggedCard) return;

    var projectId = draggedCard.dataset.id;
    var newStatus = col.dataset.status;
    var cardsContainer = col.querySelector('.kanban-cards');

    // Move card in DOM
    cardsContainer.appendChild(draggedCard);
    draggedCard.classList.remove('dragging');

    // Update counts
    updateCounts();

    // AJAX update
    fetch('/admin/projects/' + projectId + '/status', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({status: newStatus})
    }).then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) showToast('Statut mis à jour: ' + newStatus);
    });
}

function updateCounts() {
    ['PLANNED','IN_PROGRESS','DONE','ON_HOLD'].forEach(function(s) {
        var count = document.querySelectorAll('#cards-' + s + ' .kanban-card').length;
        document.getElementById('count-' + s).textContent = count;
    });
}

function showToast(msg) {
    var t = document.getElementById('toast');
    document.getElementById('toastMsg').textContent = msg;
    t.style.display = 'block';
    setTimeout(function() { t.style.display = 'none'; }, 3000);
}
</script>
{% endblock %}
