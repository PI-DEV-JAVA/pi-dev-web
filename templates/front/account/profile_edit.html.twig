{% extends 'front/_base.html.twig' %}
{% block title %}Modifier le profil — Talentos{% endblock %}
{% block content %}
<div class="fo-page-header">
    <div class="container">
        <h1>{% if not profile.profileCompleted %}Complétez votre profil 📝{% else %}Modifier le profil{% endif %}</h1>
        <p>{% if not profile.profileCompleted %}Remplissez vos informations pour accéder à toutes les fonctionnalités{% else %}Mettez à jour vos informations personnelles{% endif %}</p>
    </div>
</div>
<section class="fo-section" style="padding-top:40px">
    <div class="container">
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>{{ message }}</div>
        {% endfor %}

        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}}) }}
        <div class="row g-4">
            <div class="col-md-4">
                <div class="fo-card text-center" style="padding:32px">
                    {% if profile.profilePicturePath %}
                        <img src="{{ profile.profilePicturePath }}" alt="Avatar" style="width:120px;height:120px;border-radius:50%;object-fit:cover;margin-bottom:16px;border:3px solid var(--primary)">
                    {% else %}
                        <div style="width:120px;height:120px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--accent));display:flex;align-items:center;justify-content:center;font-size:3rem;font-weight:700;margin:0 auto 16px;color:white">
                            {{ profile.firstName|default(app.user.email)|first|upper }}
                        </div>
                    {% endif %}
                    <div class="fo-form mb-3">
                        <label class="form-label" style="font-size:0.85rem">Photo de profil</label>
                        {{ form_widget(form.profilePicture, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="fo-form">
                        <label class="form-label" style="font-size:0.85rem">CV (PDF)</label>
                        {{ form_widget(form.cvFile, {'attr': {'class': 'form-control'}}) }}
                        {% if profile.cvPath %}
                            <small style="color:var(--success)"><i class="bi bi-check-circle me-1"></i>CV existant</small>
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="fo-card fo-form" style="margin-bottom:16px">
                    <h5 style="font-weight:700;margin-bottom:20px"><i class="bi bi-person me-2" style="color:var(--primary)"></i>Informations personnelles</h5>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label">Prénom *</label>
                            {{ form_widget(form.firstName, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-6">
                            <label class="form-label">Nom *</label>
                            {{ form_widget(form.lastName, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-6">
                            <label class="form-label">Date de naissance</label>
                            {{ form_widget(form.birthDate, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-6">
                            <label class="form-label">Téléphone</label>
                            {{ form_widget(form.phoneNumber, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-12">
                            <label class="form-label">Localisation</label>
                            {{ form_widget(form.location, {'attr': {'class': 'form-control'}}) }}
                        </div>
                    </div>
                </div>
                <div class="fo-card fo-form" style="margin-bottom:16px">
                    <h5 style="font-weight:700;margin-bottom:20px"><i class="bi bi-briefcase me-2" style="color:var(--accent)"></i>Profil professionnel</h5>
                    <div class="row g-3">
                        <div class="col-8">
                            <label class="form-label">Titre professionnel</label>
                            {{ form_widget(form.professionalTitle, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-4">
                            <label class="form-label">Expérience (ans)</label>
                            {{ form_widget(form.yearsOfExperience, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-12">
                            <label class="form-label">À propos de moi</label>
                            {{ form_widget(form.summary, {'attr': {'class': 'form-control'}}) }}
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-primary-custom" style="width:auto;padding:12px 32px"><i class="bi bi-check-lg me-2"></i>Enregistrer</button>
                    {% if profile.profileCompleted %}
                        <a href="{{ path('app_profile') }}" class="btn" style="border:1.5px solid var(--fo-border);border-radius:12px;padding:12px 24px">Annuler</a>
                    {% endif %}
                </div>
            </div>
        </div>
        {{ form_end(form) }}
    </div>
</section>
{% endblock %}
