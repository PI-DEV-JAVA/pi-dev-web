{% extends 'base.html.twig' %}
{% from 'components/_sidebar.html.twig' import sidebar %}

{% block title %}Activités — Talentos{% endblock %}

{% block body %}
{{ sidebar(app.user) }}

<main class="app-main">
    <div class="page-header">
        <h2>Activités & Projets 📋</h2>
        <p>Gérez vos projets et suivez votre activité</p>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>{{ message }}</div>
    {% endfor %}

    <div class="row g-4">
        <div class="col-md-5">
            <div class="stat-card" style="margin-bottom:16px">
                <h5 style="font-weight:600;margin-bottom:16px"><i class="bi bi-kanban me-2" style="color:var(--primary-light)"></i>Mes Projets</h5>
                {% for p in projects %}
                    <div class="d-flex align-items-center gap-3 p-3 mb-2" style="background:var(--bg-input);border-radius:10px">
                        <div style="width:10px;height:10px;border-radius:50%;flex-shrink:0;
                                    background:{{ p.status == 'DONE' ? 'var(--success)' : (p.status == 'IN_PROGRESS' ? 'var(--warning)' : 'var(--text-secondary)') }}"></div>
                        <div style="flex:1;min-width:0">
                            <div style="font-weight:600;font-size:0.9rem">{{ p.name }}</div>
                            <div style="color:var(--text-secondary);font-size:0.8rem">{{ p.status }}</div>
                        </div>
                    </div>
                {% else %}
                    <p style="color:var(--text-secondary)">Aucun projet.</p>
                {% endfor %}
            </div>

            {# New Project Form #}
            <div class="stat-card">
                <h6 style="font-weight:600;margin-bottom:12px">Nouveau projet</h6>
                <form method="post" action="{{ path('app_project_new') }}">
                    <input type="text" name="name" class="form-control mb-2" placeholder="Nom du projet" required
                           style="background:var(--bg-input);border-color:var(--border);color:var(--text-primary);border-radius:10px">
                    <textarea name="description" class="form-control mb-2" rows="2" placeholder="Description (optionnel)"
                              style="background:var(--bg-input);border-color:var(--border);color:var(--text-primary);border-radius:10px"></textarea>
                    <button type="submit" class="btn btn-primary-custom" style="padding:8px 16px">
                        <i class="bi bi-plus-lg me-1"></i>Créer
                    </button>
                </form>
            </div>
        </div>

        <div class="col-md-7">
            <div class="stat-card">
                <h5 style="font-weight:600;margin-bottom:16px"><i class="bi bi-clock-history me-2" style="color:var(--accent)"></i>Activités récentes</h5>
                {% for a in activities %}
                    <div class="d-flex gap-3 mb-3 pb-3" style="border-bottom:1px solid rgba(71,85,105,0.2)">
                        <div style="width:36px;height:36px;border-radius:8px;background:rgba(79,70,229,0.15);
                                    display:flex;align-items:center;justify-content:center;flex-shrink:0">
                            <i class="bi bi-activity" style="color:var(--primary-light)"></i>
                        </div>
                        <div>
                            <div style="font-weight:500;font-size:0.9rem">{{ a.description }}</div>
                            <div style="color:var(--text-secondary);font-size:0.8rem">
                                {% if a.project %}{{ a.project.name }} · {% endif %}{{ a.activityDate|date('d/m/Y') }}
                                {% if a.hoursWorked %} · {{ a.hoursWorked }}h{% endif %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p style="color:var(--text-secondary)">Aucune activité récente.</p>
                {% endfor %}
            </div>
        </div>
    </div>
</main>
{% endblock %}
