{% extends 'base.html.twig' %}
{% from 'components/_sidebar.html.twig' import sidebar %}

{% block title %}Chat — {{ otherUser.email }}{% endblock %}

{% block stylesheets %}
<style>
    .chat-container {
        height: calc(100vh - 200px);
        display: flex;
        flex-direction: column;
    }
    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .chat-bubble {
        max-width: 70%;
        padding: 12px 16px;
        border-radius: 16px;
        font-size: 0.9rem;
        line-height: 1.5;
    }
    .chat-bubble.sent {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        align-self: flex-end;
        border-bottom-right-radius: 4px;
    }
    .chat-bubble.received {
        background: var(--bg-input);
        color: var(--text-primary);
        align-self: flex-start;
        border-bottom-left-radius: 4px;
    }
    .chat-time {
        font-size: 0.7rem;
        color: var(--text-secondary);
        margin-top: 4px;
    }
</style>
{% endblock %}

{% block body %}
{{ sidebar(app.user) }}

<main class="app-main">
    <div class="mb-3 d-flex align-items-center gap-3">
        <a href="{{ path('app_my_circle') }}" style="color:var(--primary-light);text-decoration:none">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div style="width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,var(--primary),var(--accent));
                    display:flex;align-items:center;justify-content:center;font-weight:700;color:white">
            {{ otherUser.email|first|upper }}
        </div>
        <div>
            <div style="font-weight:600">{{ otherUser.email }}</div>
            <div style="color:var(--text-secondary);font-size:0.8rem">{{ otherUser.role }}</div>
        </div>
    </div>

    <div class="stat-card chat-container" style="padding:0">
        <div class="chat-messages" id="chatMessages">
            {% for msg in messages %}
                <div class="chat-bubble {{ msg.sender == app.user ? 'sent' : 'received' }}">
                    {{ msg.message }}
                    <div class="chat-time">{{ msg.createdAt|date('H:i') }}</div>
                </div>
            {% else %}
                <div class="text-center" style="color:var(--text-secondary);padding:40px">
                    <i class="bi bi-chat" style="font-size:2rem"></i>
                    <p class="mt-2">Commencez la conversation !</p>
                </div>
            {% endfor %}
        </div>

        <form method="post" action="{{ path('app_chat_send', {id: sync.id}) }}" class="d-flex gap-2" style="padding:16px;border-top:1px solid rgba(71,85,105,0.3)">
            <input type="text" name="message" class="form-control" placeholder="Votre message..." required autofocus
                   style="background:var(--bg-input);border-color:var(--border);color:var(--text-primary);border-radius:12px">
            <button type="submit" class="btn btn-primary-custom" style="width:auto;padding:10px 20px;border-radius:12px">
                <i class="bi bi-send"></i>
            </button>
        </form>
    </div>
</main>

{% block javascripts %}
<script>
    const chat = document.getElementById('chatMessages');
    if (chat) chat.scrollTop = chat.scrollHeight;
</script>
{% endblock %}
{% endblock %}
